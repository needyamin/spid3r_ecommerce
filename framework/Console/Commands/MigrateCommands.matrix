public class MigrateRenameLegacyCommand {
    public let name;
    public let usage;
    public let description;
    private let kernel;

    fn new (kernel) {
        self.name = "migrate:rename-legacy";
        self.usage = "migrate:rename-legacy";
        self.description = "Rename NNN_* migrations to timestamped filenames";
        self.kernel = kernel;
    }

    public fn handle(self, _cli_args: list) -> int {
        return rename_legacy_migrations(
