}

public class MigrateResetCommand {
    public let name;
    public let usage;
    public let description;
    private let kernel;

    fn new (kernel) {
        self.name = "migrate:reset";
        self.usage = "migrate:reset";
        self.description = "Rollback all executed database migrations";
        self.kernel = kernel;
    }

    public fn handle(self, _cli_args: list) -> int {
        let mem = self.kernel.migrations();
        if mem.len() > 0 {
            let runner = new MigrationRunner();
            runner.reset(mem);
            DB.close();
            return 0;
        }
        return run_migration_action(
            "reset",
            self.kernel.migrations_dir(),
            self.kernel.registry_path()
        );
    }
}

public class DbWipeCommand {
    public let name;
    public let usage;
    public let description;
    private let kernel;

    fn new (kernel) {
        self.name = "db:wipe";
        self.usage = "db:wipe";
        self.description = "Drop all tables from the active database";
        self.kernel = kernel;
    }

    public fn handle(self, _cli_args: list) -> int {
        if self.kernel.migrations().len() > 0 {
            let runner = new MigrationRunner();
            let n = runner.wipe();
            println("[DB] Dropped {n} table(s).");
            DB.close();
            return 0;
        }
        let code = run_migration_action(
            "wipe",
            self.kernel.migrations_dir(),
            self.kernel.registry_path()
        );
        return code;
    }
}

public class MigrateSyncCommand {
    public let name;
    public let usage;
    public let description;
    private let kernel;

    fn new (kernel) {
        self.name = "migrate:sync";
        self.usage = "migrate:sync";
        self.description = "Re-scan database/migrations and rebuild the registry";
        self.kernel = kernel;
    }

    public fn handle(self, _cli_args: list) -> int {
        let n = self.kernel.sync_migration_registry(true, true);
        if n < 0 {
            return 1;
        }
        return 0;
    }
}

