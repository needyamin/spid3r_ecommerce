# ===========================================================================
# Spid3rWeb .gitignore
# ===========================================================================

# ---------------------------------------------------------------------------
# SQLite Runtime Artifacts (WAL, SHM, journal files generated at runtime)
# ---------------------------------------------------------------------------
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.db-wal
*.db-shm
*.db-journal

# ---------------------------------------------------------------------------
# SQLite Database Binary (generated by migrations + seeders; schema lives
# in database/migrations/*.matrix - the DB file should not be committed)
# ---------------------------------------------------------------------------
# Legacy location; the default is now storage/database/database.sqlite (storage/* rules below)
database/database.sqlite
*.sqlite
*.db

# ---------------------------------------------------------------------------
# Build & Generated Artifacts (never ignore vendored native plugins under vendor/)
# ---------------------------------------------------------------------------
target/
/*.exe
/*.dll
/*.so
/*.dylib
*.o
*.obj
*.matrixc
*.out
!vendor/**/*.dll
!vendor/**/*.so
!vendor/**/*.dylib
docs/build/
bench_aot
bench_aot.exe
spid3rweb_*.exe
coverage/
coverage.lcov
lcov.info

# ---------------------------------------------------------------------------
# WorkBuddy AI / Agent Workspace Data
# ---------------------------------------------------------------------------
.agents/
.workbuddy-ai/

# ---------------------------------------------------------------------------
# OS-Generated Files
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Editor / IDE Artifacts
# ---------------------------------------------------------------------------
*.swp
*.swo
*~
.idea/
.vscode/
*.sublimeproject
*.sublameworkspace

# ---------------------------------------------------------------------------
# Environment & Secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Storage runtime artifacts (keep directory skeleton via .gitkeep)
# ---------------------------------------------------------------------------
storage/*
!storage/app/
storage/app/*
!storage/app/.gitkeep
!storage/framework/
storage/framework/*
!storage/framework/cache/
storage/framework/cache/*
!storage/framework/cache/.gitkeep
!storage/logs/
storage/logs/*
!storage/logs/.gitkeep
!storage/database/
storage/database/*
!storage/database/.gitkeep

# ---------------------------------------------------------------------------
# User uploads (public disk -> public/uploads) and storage:link symlink
# ---------------------------------------------------------------------------
public/uploads/*
!public/uploads/.gitkeep
public/storage

# ---------------------------------------------------------------------------
# Logs & Temporary Files
# ---------------------------------------------------------------------------
*.log
logs/
tmp/
temp/
deliverables/

# ---------------------------------------------------------------------------
# Local QA / Audit Artifacts (screenshots, linter binaries, browser sessions)
# ---------------------------------------------------------------------------
.screenshots/
.playwright-cli/
actionlint
actionlint.exe
shellcheck.exe


# Compiled AOT distribution binaries
dist/

# Python tooling cache (tools/*.py seeders)
__pycache__/

.mimosa/