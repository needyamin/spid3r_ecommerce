// config/filesystems.matrix
// Spid3rWeb Filesystem / Storage Configuration
//
// Consumed by framework/Filesystem/Storage.matrix. Roots are relative to
// the project root (the working directory of `spid3r magic serve`).
// The "public" disk is web-servable: files land under public/uploads and
// are reachable at /uploads/<path>.

public let config_filesystems = {
    "default": "local",
    "disks": {
        "local": {
            "driver": "local",
            "root": "storage/app",
            "visibility": "private",
            "url": "",
            "max_bytes": 52_428_800
        }
        ,
        "public": {
            "driver": "local",
            "root": "public/uploads",
            "visibility": "public",
            "url": "/uploads",
            "max_bytes": 52_428_800,
            "blocked_extensions": ["html", "htm", "svg", "js", "mjs", "xhtml"]
        }
        ,
        "logs": {
            "driver": "local",
            "root": "storage/logs",
            "visibility": "private",
            "url": "",
            "max_bytes": 0
        }
    }
};
