// config/security.matrix
// Spid3rWeb HTTP Security Headers, CSP & HSTS Policy
//
// Consumed by framework/Http/Response.matrix, framework/Foundation/Application.matrix,
// and framework/Http/StaticFiles.matrix.

public let config_security = {
    "headers": {
        "x-content-type-options": "nosniff",
        "x-frame-options": "SAMEORIGIN",
        "referrer-policy": "strict-origin-when-cross-origin",
        "x-permitted-cross-domain-policies": "none",
        "cross-origin-opener-policy": "same-origin",
        "permissions-policy": "camera=(), microphone=(), geolocation=()",
        "content-security-policy": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'"
    }
    ,
    "hsts": {
        "enabled": false,
        "auto_production_tls": true,
        "max_age": 31_536_000,
        "include_subdomains": true,
        "preload": false
    }
    ,
    "uploads_csp": "default-src 'none'; sandbox"
};
