// config/mail.matrix
// Spid3rWeb Mail Configuration
//
// Consumed by framework/Mail/Mail.matrix.
//
// Drivers:
//   log  — renders every message into the "mail" log channel
//          (storage/logs/mail.log). Default and always available.
//   smtp — plain SMTP via runtime tcp_connect/tcp_write (for local relays /
//          Mailpit); TLS/STARTTLS awaits tls_connect in Spid3r net stdlib.
//          Keep SPID3R_MAIL_MAILER=log when no SMTP relay is configured.

public let config_mail = {
    "default": "log",
    "mailer_env": "SPID3R_MAIL_MAILER",
    "from": {
        "address": "hello@spid3r.test",
        "name": "Spid3r Bazaar"
    }
    ,
    "mailers": {
        "log": {
            "driver": "log",
            "channel": "mail"
        }
        ,
        "smtp": {
            "driver": "smtp",
            "host_env": "SPID3R_MAIL_HOST",
            "host": "127.0.0.1",
            "port_env": "SPID3R_MAIL_PORT",
            "port": 1025,
            "timeout_ms": 10_000,
            "timeout_env": "SPID3R_MAIL_TIMEOUT_MS",
            "username_env": "SPID3R_MAIL_USERNAME",
            "password_env": "SPID3R_MAIL_PASSWORD",
            "encryption": "none"
        }
    }
};
