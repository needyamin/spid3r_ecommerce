// tests/test_admin_e2e.matrix
// Dedicated End-to-End integration test suite for the redesigned Admin Panel:
// Covers all 8 modules:
//   1. Overview
//   2. Orders
//   3. Products
//   4. Categories
//   5. Brands
//   6. Inventory
//   7. Customers
//   8. Settings

import "framework/Application";
import "framework/Router";
import "framework/Database/DB";
import "routes/web";
import "routes/queue";
import "app/Middleware/StoreMiddleware";
import "app/Services/AuthService";
import "database/seeders/DatabaseSeeder";

fn call(app, method: string, path: string, data, cookie: string) {
    let headers = map();
    if cookie != "" {
        headers["cookie"] = cookie;
    }
    let payload = map();
    if data != null {
        for k in data.keys() {
            payload[k] = data[k];
        }
    }
    return app.handle_request(map(
        "method", method, "path", path,
        "headers", headers, "data", payload
    ));
}

fn body(res) {
    return json_parse(string(res["body"]));
}

fn admin_session(app, tag: string) {
    let svc = new AuthService();
    let email = "e2e-admin-" + tag + "@example.test";
    let user = svc.register("E2E Admin", email, "admin-secret-pass");
    let role = DB.table("roles").where("slug", "=", "admin").first();
    DB.table("user_roles").insert(map("user_id", user["id"], "role_id", role["id"]));
    let token = svc.login(email, "admin-secret-pass");
    let rows = DB.select("SELECT payload FROM sessions WHERE token = ?", [token]);
    return map(
        "cookie", "spid3r_session=" + token,
        "csrf", string(rows[0]["payload"]),
        "email", email, "id", user["id"]
    );
}

// -----------------------------------------------------------------------------
// 1. Module: Overview
// -----------------------------------------------------------------------------
fn test_overview_module(app, adm) {
    let res = call(app, "GET", "/admin/api/overview", null, adm["cookie"]);
    assert(res["status"] == 200, "overview API returns 200");
    let b = body(res);
    let d = b["data"];
    assert(d["orders"] != null, "overview includes orders count");
    assert(d["revenue_minor"] != null, "overview includes revenue_minor");
    assert(d["revenue_display"] != null, "overview includes revenue_display");
    assert(d["customers"] != null, "overview includes customers count");
    assert(d["products"] != null, "overview includes products count");
    assert(d["low_stock"] != null, "overview includes low stock count");
    assert(d["recent_orders"] != null, "overview includes recent orders list");

    let page = call(app, "GET", "/admin/dashboard", null, adm["cookie"]);
    assert(page["status"] == 200, "admin dashboard renders 200");
    assert(string(page["body"]).contains("Revenue"), "dashboard HTML contains revenue section");
    println("  [PASS] test_overview_module");
}

// -----------------------------------------------------------------------------
// 2. Module: Orders
// -----------------------------------------------------------------------------
fn test_orders_module(app, adm, tag: string) {
    let cat_id = DB.table("categories").insert(map("name", "OrderCat " + tag, "slug", "ordercat-" + tag));
    let prod_id = DB.table("products").insert(map(
        "category_id", cat_id, "name", "OrderProd " + tag, "slug", "orderprod-" + tag,
        "sku", "OP-" + tag, "price_minor", 50000, "status", "published", "currency", "BDT"
    ));
    let order_num = "E2E-ORD-" + tag;
    let order_id = DB.table("orders").insert(map(
        "order_number", order_num,
        "user_id", adm["id"],
        "status", "pending",
        "subtotal_minor", 50000,
        "discount_minor", 0,
        "shipping_minor", 6000,
        "tax_minor", 0,
        "total_minor", 56000,
        "currency", "BDT",
        "shipping_address_json", "{\"name\":\"Recipient\",\"city\":\"Dhaka\",\"address_line1\":\"Gulshan\"}",
        "billing_address_json", "{}",
        "placed_at", string(unix_time())
    ));
    DB.table("order_items").insert(map(
        "order_id", order_id,
        "product_id", prod_id,
        "variant_id", null,
        "name_snapshot", "Test Item " + tag,
        "sku_snapshot", "ITEM-" + tag,
        "unit_price_minor", 50000,
        "quantity", 1,
        "discount_minor", 0,
        "tax_minor", 0,
        "line_total_minor", 50000
    ));

    // List orders
    let list = call(app, "GET", "/admin/api/list/orders", null, adm["cookie"]);
    assert(list["status"] == 200, "orders list API returns 200");
    let b = body(list);
    assert(b["data"].len() >= 1, "orders list contains at least one order");

    // Filter by status
    let filter = call(app, "GET", "/admin/api/list/orders?status=pending", null, adm["cookie"]);
    assert(filter["status"] == 200, "orders filter by status returns 200");
    let fb = body(filter);
    let found = false;
    let i = 0;
    while i < fb["data"].len() {
        if string(fb["data"][i]["order_number"]) == order_num {
            found = true;
        }
        i += 1;
    }
    assert(found, "filtered orders contains newly created order");

    // Show order details
    let detail = call(app, "GET", "/admin/api/order/" + string(order_id), null, adm["cookie"]);
    assert(detail["status"] == 200, "order detail API returns 200");
    let db = body(detail)["data"];
    assert(string(db["order"]["order_number"]) == order_num, "order detail returns matching order number");
    assert(db["items"].len() >= 1, "order detail includes line items");
    assert(string(db["items"][0]["sku"]) == "ITEM-" + tag, "item sku matches");

    // Update order status via singular route
    let upd = call(app, "POST", "/admin/api/order/" + string(order_id) + "/status", map(
        "status", "processing", "_csrf", adm["csrf"], "format", "json"
    ), adm["cookie"]);
    assert(upd["status"] == 200, "order status updated to processing");
    let row = DB.table("orders").where("id", "=", order_id).first();
    assert(string(row["status"]) == "processing", "order status persisted in DB");

    // Update order status via plural route
    let upd2 = call(app, "POST", "/admin/api/orders/" + string(order_id) + "/status", map(
        "status", "delivered", "_csrf", adm["csrf"], "format", "json"
    ), adm["cookie"]);
    assert(upd2["status"] == 200, "plural route order status updated to delivered");
    let row2 = DB.table("orders").where("id", "=", order_id).first();
    assert(string(row2["status"]) == "delivered", "order status updated to delivered in DB");

    // Reject invalid status
    let bad = call(app, "POST", "/admin/api/order/" + string(order_id) + "/status", map(
        "status", "unknown_bogus_status", "_csrf", adm["csrf"], "format", "json"
    ), adm["cookie"]);
    assert(bad["status"] == 422, "invalid order status rejected with 422");

    // Cleanup
    DB.table("order_items").where("order_id", "=", order_id).delete();
    DB.table("orders").where("id", "=", order_id).delete();
    DB.table("products").where("id", "=", prod_id).delete();
    DB.table("categories").where("id", "=", cat_id).delete();
    println("  [PASS] test_orders_module");
}

// -----------------------------------------------------------------------------
// 3. Module: Products
// -----------------------------------------------------------------------------
fn test_products_module(app, adm, tag: string) {
    let cat_id = DB.table("categories").insert(map("name", "ProdCat " + tag, "slug", "prodcat-" + tag));
    let brand_id = DB.table("brands").insert(map("name", "ProdBrand " + tag, "slug", "prodbrand-" + tag));

    // Create product via AJAX API
    let sku = "SKU-E2E-" + tag;
    let create_res = call(app, "POST", "/admin/api/products/create", map(
        "name", "E2E Product " + tag,
        "sku", sku,
        "category_id", cat_id,
        "brand_id", brand_id,
        "price", "350.00",
        "compare_at", "400.00",
        "cost", "200.00",
        "tax_percent", "5.00",
        "weight_kg", "1.250",
        "stock", 25,
        "status", "draft",
        "short_description", "Short note",
        "description", "Detailed description",
        "_csrf", adm["csrf"],
        "format", "json"
    ), adm["cookie"]);
    assert(create_res["status"] == 201, "product created via AJAX API with 201");
    let pid = int(body(create_res)["data"]["id"]);

    // Verify DB integrity
    let p_row = DB.table("products").where("id", "=", pid).first();
    assert(int(p_row["price_minor"]) == 35000, "price stored in minor units (35000)");
    assert(int(p_row["compare_at_minor"]) == 40000, "compare_at stored in minor units (40000)");
    assert(int(p_row["cost_minor"]) == 20000, "cost stored in minor units (20000)");
    assert(string(p_row["status"]) == "draft", "status is draft");
    let inv_row = DB.table("inventory").where("product_id", "=", pid).first();
    assert(int(inv_row["quantity"]) == 25, "opening inventory created with 25 units");

    // List products API
    let list_res = call(app, "GET", "/admin/api/list/products?q=" + sku, null, adm["cookie"]);
    assert(list_res["status"] == 200, "products list API returns 200");
    let lb = body(list_res);
    assert(lb["data"].len() == 1, "product search by SKU returns exact row");
    assert(string(lb["data"][0]["sku"]) == sku, "SKU matches");

    // Full product details API
    let full_res = call(app, "GET", "/admin/api/product-full/" + string(pid), null, adm["cookie"]);
    assert(full_res["status"] == 200, "product-full API returns 200");
    let fb = body(full_res)["data"];
    assert(fb["product"]["name"] == "E2E Product " + tag, "product name in full detail matches");
    assert(int(fb["inventory"]["quantity"]) == 25, "inventory in full detail matches");
    assert(fb["categories"].len() >= 1, "categories options included");
    assert(fb["brands"].len() >= 1, "brands options included");

    // Update product details
    let upd_res = call(app, "POST", "/admin/api/products/" + string(pid) + "/update", map(
        "name", "E2E Product Renamed " + tag,
        "price", "375.50",
        "short_description", "Updated short",
        "_csrf", adm["csrf"],
        "format", "json"
    ), adm["cookie"]);
    assert(upd_res["status"] == 200, "product updated via update API");
    let updated_row = DB.table("products").where("id", "=", pid).first();
    assert(string(updated_row["name"]) == "E2E Product Renamed " + tag, "product name updated in DB");
    assert(int(updated_row["price_minor"]) == 37550, "updated price converted to 37550");

    // Toggle featured
    call(app, "POST", "/admin/api/products/" + string(pid) + "/featured-form", map(
        "_csrf", adm["csrf"], "format", "json"
    ), adm["cookie"]);
    let feat_row = DB.table("products").where("id", "=", pid).first();
    assert(int(feat_row["is_featured"]) == 1, "product marked as featured");

    // Publish & Unpublish
    call(app, "POST", "/admin/api/products/" + string(pid) + "/publish-form", map(
        "_csrf", adm["csrf"], "format", "json"
    ), adm["cookie"]);
    assert(string(DB.table("products").where("id", "=", pid).first()["status"]) == "published", "product published");

    call(app, "POST", "/admin/api/products/" + string(pid) + "/unpublish-form", map(
        "_csrf", adm["csrf"], "format", "json"
    ), adm["cookie"]);
    assert(string(DB.table("products").where("id", "=", pid).first()["status"]) == "draft", "product unpublished to draft");

    // Delete product
    let del_res = call(app, "POST", "/admin/api/products/" + string(pid) + "/delete-form", map(
        "_csrf", adm["csrf"], "format", "json"
    ), adm["cookie"]);
    assert(del_res["status"] == 200, "product deleted via delete-form");
    assert(DB.table("products").where("id", "=", pid).first() == null, "product removed from DB");
    assert(DB.table("inventory").where("product_id", "=", pid).first() == null, "inventory cleaned up");

    // Cleanup
    DB.table("categories").where("id", "=", cat_id).delete();
    DB.table("brands").where("id", "=", brand_id).delete();
    println("  [PASS] test_products_module");
}

// -----------------------------------------------------------------------------
// 4. Module: Categories
// -----------------------------------------------------------------------------
fn test_categories_module(app, adm, tag: string) {
    let name = "E2E Category " + tag;
    let create_res = call(app, "POST", "/admin/api/categories/create", map(
        "name", name, "description", "Category desc",
        "_csrf", adm["csrf"], "format", "json"
    ), adm["cookie"]);
    assert(create_res["status"] == 201, "category created via API");
    let cid = int(body(create_res)["data"]["id"]);

    // List categories API
    let list_res = call(app, "GET", "/admin/api/list/categories?q=" + url_encode(name), null, adm["cookie"]);
    assert(list_res["status"] == 200, "categories list API returns 200");
    let b = body(list_res);
    assert(b["data"].len() >= 1, "categories list includes new category");

    // Update category
    let upd_res = call(app, "POST", "/admin/api/categories/" + string(cid) + "/update", map(
        "name", name + " Updated", "description", "New desc",
        "_csrf", adm["csrf"], "format", "json"
    ), adm["cookie"]);
    assert(upd_res["status"] == 200, "category updated via API");
    assert(string(DB.table("categories").where("id", "=", cid).first()["name"]) == name + " Updated", "category name updated in DB");

    // Delete category
    let del_res = call(app, "POST", "/admin/api/categories/" + string(cid) + "/delete-form", map(
        "_csrf", adm["csrf"], "format", "json"
    ), adm["cookie"]);
    assert(del_res["status"] == 200, "category deleted via delete-form API");
    assert(DB.table("categories").where("id", "=", cid).first() == null, "category removed from DB");
    println("  [PASS] test_categories_module");
}

