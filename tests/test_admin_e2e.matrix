    assert(del_res["status"] == 200, "brand deleted via delete-form API");
    assert(DB.table("brands").where("id", "=", bid).first() == null, "brand removed from DB");
    println("  [PASS] test_brands_module");
}

// -----------------------------------------------------------------------------
// 6. Module: Inventory
// -----------------------------------------------------------------------------
fn test_inventory_module(app, adm, tag: string) {
    let cat_id = DB.table("categories").insert(map("name", "InvCat " + tag, "slug", "invcat-" + tag));
    let pid = DB.table("products").insert(map(
        "category_id", cat_id, "name", "InvProduct " + tag, "slug", "invprod-" + tag,
        "sku", "INV-" + tag, "price_minor", 10000, "status", "published", "currency", "BDT"
    ));
    DB.table("inventory").insert(map(
        "product_id", pid, "variant_id", null, "quantity", 10, "reserved", 2, "low_stock_threshold", 5
    ));

    // List inventory API
    let list_res = call(app, "GET", "/admin/api/list/inventory?q=" + url_encode("InvProduct " + tag), null, adm["cookie"]);
    assert(list_res["status"] == 200, "inventory list API returns 200");
    let b = body(list_res);
    assert(b["data"].len() == 1, "inventory list returns created product");
    let item = b["data"][0];
    assert(int(item["quantity"]) == 10, "quantity is 10");
    assert(int(item["available"]) == 8, "available is 8 (10 - 2)");
    assert(int(item["reserved"]) == 2, "reserved is 2");

    // Restock API
    let restock_res = call(app, "POST", "/admin/api/products/" + string(pid) + "/inventory/restock", map(
        "quantity", 5, "_csrf", adm["csrf"], "format", "json"
    ), adm["cookie"]);
    assert(restock_res["status"] == 200, "restock API returns 200");
    assert(int(DB.table("inventory").where("product_id", "=", pid).first()["quantity"]) == 15, "quantity updated to 15");

    // Set exact stock API
    let set_res = call(app, "POST", "/admin/api/products/" + string(pid) + "/inventory/set-form", map(
        "quantity", 4, "low_stock_threshold", 6, "_csrf", adm["csrf"], "format", "json"
    ), adm["cookie"]);
    assert(set_res["status"] == 200, "set exact stock API returns 200");
    let inv_after = DB.table("inventory").where("product_id", "=", pid).first();
    assert(int(inv_after["quantity"]) == 4, "exact quantity set to 4");
    assert(int(inv_after["low_stock_threshold"]) == 6, "threshold set to 6");

    // Low stock filter API
    let low_res = call(app, "GET", "/admin/api/list/inventory?low=1", null, adm["cookie"]);
    assert(low_res["status"] == 200, "inventory low-stock filter returns 200");
    let low_items = body(low_res)["data"];
    let found = false;
    let i = 0;
    while i < low_items.len() {
        if int(low_items[i]["product_id"]) == pid {
            found = true;
        }
        i += 1;
    }
    assert(found, "product with quantity <= threshold matches low stock filter");

    // Cleanup
    DB.table("inventory").where("product_id", "=", pid).delete();
    DB.table("products").where("id", "=", pid).delete();
    DB.table("categories").where("id", "=", cat_id).delete();
    println("  [PASS] test_inventory_module");
}

// -----------------------------------------------------------------------------
// 7. Module: Customers
// -----------------------------------------------------------------------------
fn test_customers_module(app, adm, tag: string) {
    let svc = new AuthService();
    let email = "cust-" + tag + "@example.test";
    let cust = svc.register("Customer " + tag, email, "cust-pass");
    let cid = cust["id"];

    // List customers API
    let list_res = call(app, "GET", "/admin/api/list/customers?q=" + url_encode(email), null, adm["cookie"]);
    assert(list_res["status"] == 200, "customers list API returns 200");
    let b = body(list_res);
    assert(b["data"].len() == 1, "searched customer returned");
    assert(string(b["data"][0]["status"]) == "active", "default status is active");

    // Suspend customer
    let susp_res = call(app, "POST", "/admin/api/customers/" + string(cid) + "/status", map(
        "status", "suspended", "_csrf", adm["csrf"], "format", "json"
    ), adm["cookie"]);
    assert(susp_res["status"] == 200, "customer suspended via status API");
    assert(string(DB.table("users").where("id", "=", cid).first()["status"]) == "suspended", "status suspended in DB");

    // Re-activate customer
    let act_res = call(app, "POST", "/admin/api/customers/" + string(cid) + "/status", map(
        "status", "active", "_csrf", adm["csrf"], "format", "json"
    ), adm["cookie"]);
    assert(act_res["status"] == 200, "customer re-activated via status API");
    assert(string(DB.table("users").where("id", "=", cid).first()["status"]) == "active", "status active in DB");

    // Reject invalid status
    let bad_res = call(app, "POST", "/admin/api/customers/" + string(cid) + "/status", map(
        "status", "illegal_value", "_csrf", adm["csrf"], "format", "json"
    ), adm["cookie"]);
    assert(bad_res["status"] == 422, "invalid status rejected with 422");

    // Cleanup
    DB.table("user_roles").where("user_id", "=", cid).delete();
    DB.table("sessions").where("user_id", "=", cid).delete();
    DB.table("email_verifications").where("user_id", "=", cid).delete();
    DB.table("users").where("id", "=", cid).delete();
    println("  [PASS] test_customers_module");
}

// -----------------------------------------------------------------------------
// 8. Module: Settings
// -----------------------------------------------------------------------------
fn test_settings_module(app, adm, tag: string) {
    let key = "store.e2e.test." + tag;

    // Save setting
    let put_res = call(app, "POST", "/admin/api/settings", map(
        "setting_key", key, "value", "e2e_val_" + tag, "group", "general",
        "_csrf", adm["csrf"], "format", "json"
    ), adm["cookie"]);
    assert(put_res["status"] == 200, "settings update API returns 200");

    // Verify in DB
    let row = DB.table("settings").where("setting_key", "=", key).first();
    assert(row != null, "setting row exists in DB");
    assert(string(row["value"]) == "e2e_val_" + tag, "setting value matches");
    assert(string(row["setting_group"]) == "general", "setting group is general");

    // Read settings by group
    let get_res = call(app, "GET", "/admin/api/settings?group=general", null, adm["cookie"]);
    assert(get_res["status"] == 200, "settings get API returns 200");
    assert(string(get_res["body"]).contains(key), "settings get returns newly added key");

    // Cleanup
    DB.table("settings").where("setting_key", "=", key).delete();
    println("  [PASS] test_settings_module");
}

fn cleanup_admin(adm) {
    try {
        let uid = adm["id"];
        DB.table("user_roles").where("user_id", "=", uid).delete();
        DB.table("sessions").where("user_id", "=", uid).delete();
        DB.table("users").where("id", "=", uid).delete();
    } catch (e) {
        println("[cleanup_admin] best-effort: " + string(e));
    }
}

fn main() {
    println("\n=== Running Admin E2E Test Suite (8 Modules) ===");
    let app = new Application();
    register_store_middleware(app);
    register_web_routes();
    register_queue_jobs();
    run_database_seeder();
    let tag = string(unix_time());
    let adm = admin_session(app, tag);

    try {
        test_overview_module(app, adm);
        test_orders_module(app, adm, tag);
        test_products_module(app, adm, tag);
        test_categories_module(app, adm, tag);
        test_brands_module(app, adm, tag);
        test_inventory_module(app, adm, tag);
        test_customers_module(app, adm, tag);
        test_settings_module(app, adm, tag);
    } finally {
        cleanup_admin(adm);
    }
    DB.close();
    println("=== All 8 Admin Modules Passed E2E Tests! ===\n");
    return 0;
}
