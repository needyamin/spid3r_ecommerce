// tools/fix_demo_passwords.matrix
// ONE-OFF repair (safe to delete): re-hashes the seeded demo accounts with the
// CURRENT Hash implementation.
//
// Why: the demo rows were seeded by a process running a different hasher, so
// their stored hashes use a PHC/base64 argon2id format that Hash.check cannot
// verify — the credentials shown on the login page failed with
// "Invalid credentials or inactive account."
//
//   SPID3R_PATH=. spid3r run tools/fix_demo_passwords.matrix

import "framework/Auth/Hash";
import "framework/Database/DB";

fn rehash(email: string) {
    let row = DB.table("users").where("email", "=", email).first();
    if row == null {
        println("  missing : " + email);
        return;
    }
    let stored = string(row["password"]);
    if Hash.check("secret123", stored) {
        println("  ok      : " + email + " (already verifies)");
        return;
    }
    DB.table("users")
    .where("email", "=", email)
    .update({
        "password": Hash.make("secret123"), "updated_at": string(unix_time())
    });
    let after = string(
        DB.table("users").where("email", "=", email).first()["password"]
    );
    println("  fixed   : " + email + "  verify=" + string(Hash.check("secret123", after)));
}

fn main() {
    println("\n=== Re-hashing demo accounts with current Hash.make ===");
    rehash("admin@spid3r.test");
    rehash("shopper@spid3r.test");
}
