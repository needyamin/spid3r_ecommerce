// routes/storefront.matrix
// Phase 5 — public, SEO-friendly storefront routes.
// Order matters: static paths (/catalog, /sitemap.xml ...) precede :slug
// routes so the parameter matcher never shadows them.

import "framework/Router";
import "app/Controllers/StorefrontController";

public fn register_storefront_routes() {
    let ctl = new StorefrontController();

    Route.get("/catalog", req => ctl.catalog(req)).name("catalog");
    Route.get("/search", req => ctl.search(req)).name("search");
    Route.get("/sitemap.xml", req => ctl.sitemap(req)).name("sitemap");
    Route.get("/robots.txt", req => ctl.robots(req)).name("robots");

    Route.get("/category/:slug", req => ctl.category(req)).name("category");
    Route.get("/brand/:slug", req => ctl.brand(req)).name("brand");
    Route.get("/product/:slug", req => ctl.product(req)).name("product");
}
