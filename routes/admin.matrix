// routes/admin.matrix
// Phase 9 — administration panel. All pages require role:admin; APIs are
// additionally permission-gated. State-changing calls include _csrf.

import "framework/Router";
import "app/Controllers/AdminController";

public fn register_admin_routes() {
    let ctl = new AdminController();

    // Dashboard + management pages.
    Route.get("/admin/dashboard", req => ctl.dashboard(req)).middleware("role:admin");
    Route.get("/admin/reports", req => ctl.reports(req)).middleware("role:admin");
    Route.get("/admin/reports/export", req => ctl.export(req)).middleware("permission:reports.view");

    // Explicit registrations: closures capture loop variables by reference,
    // so generating these in a loop would bind every page to the last name.
    Route.get("/admin/products", req => ctl.page(req, "products")).middleware("role:admin");
    // Full product management screen (details, gallery, variants, stock).
    Route.get("/admin/products/:id", req => ctl.product_manage(req)).middleware("role:admin");
    Route.get("/admin/categories", req => ctl.page(req, "categories")).middleware("role:admin");
    Route.get("/admin/brands", req => ctl.page(req, "brands")).middleware("role:admin");
    Route.get("/admin/inventory", req => ctl.page(req, "inventory")).middleware("role:admin");
    Route.get("/admin/orders", req => ctl.page(req, "orders")).middleware("role:admin");
    Route.get("/admin/orders/:id", req => ctl.order_view(req)).middleware("role:admin");
    Route.post("/admin/orders/:id/status", req => ctl.api_order_status(req)).middleware("role:admin");
    Route.get("/admin/customers", req => ctl.page(req, "customers")).middleware("role:admin");
    Route.get("/admin/staff", req => ctl.page(req, "staff")).middleware("role:admin");
    Route.get("/admin/roles", req => ctl.page(req, "roles")).middleware("role:admin");
    Route.get("/admin/coupons", req => ctl.page(req, "coupons")).middleware("role:admin");
    Route.get("/admin/settings", req => ctl.page(req, "settings")).middleware("role:admin");
    Route.get("/admin/shipping", req => ctl.page(req, "shipping")).middleware("role:admin");
    Route.get("/admin/payments", req => ctl.page(req, "payments")).middleware("role:admin");
    Route.get("/admin/audit", req => ctl.page(req, "audit")).middleware("role:admin");

    // Management APIs.
    Route.get("/admin/api/customers", req => ctl.api_customers(req)).middleware("permission:customers.manage");
    Route.post("/admin/api/customers/:id/status", req => ctl.api_customer_status(req)).middleware("permission:customers.manage");
    Route.get("/admin/api/staff", req => ctl.api_staff(req)).middleware("permission:customers.manage");
    // SECURITY (audit F-2/F-3): granting or revoking roles and permissions is
    // privilege management — a staff user with only customers.manage must NOT
    // be able to self-promote to admin. Admin role required, not just a
    // permission flag.
    Route.post("/admin/api/staff/role", req => ctl.api_assign_role(req)).middleware("role:admin");
    Route.post("/admin/api/staff/role/remove", req => ctl.api_remove_role(req)).middleware("role:admin");
    Route.get("/admin/api/roles", req => ctl.api_roles(req)).middleware("permission:settings.manage");
    Route.post("/admin/api/roles/:id/permissions", req => ctl.api_toggle_permission(req)).middleware("role:admin");

    Route.get("/admin/api/coupons", req => ctl.api_coupons(req)).middleware("permission:catalog.manage");
    Route.post("/admin/api/coupons", req => ctl.api_coupon_save(req)).middleware("permission:catalog.manage");
    Route.put("/admin/api/coupons/:id", req => ctl.api_coupon_update(req)).middleware("permission:catalog.manage");
    Route.delete("/admin/api/coupons/:id", req => ctl.api_coupon_delete(req)).middleware("permission:catalog.manage");
    Route.post("/admin/api/coupons/:id/toggle-form", req => ctl.api_coupon_toggle(req)).middleware("permission:catalog.manage");

    Route.get("/admin/api/settings", req => ctl.api_settings(req)).middleware("permission:settings.manage");
    Route.put("/admin/api/settings", req => ctl.api_setting_update(req)).middleware("permission:settings.manage");
    Route.post("/admin/api/settings", req => ctl.api_setting_update(req)).middleware("permission:settings.manage");
    Route.post("/admin/api/payments/settings", req => ctl.api_payments_update(req)).middleware("permission:settings.manage");
    Route.post("/admin/api/payments/webhook-test", req => ctl.api_payments_webhook_test(req)).middleware("permission:settings.manage");
    Route.post("/admin/api/payments/test-gateway", req => ctl.api_payments_test_gateway(req)).middleware("permission:settings.manage");
    Route.post("/admin/api/payments/create-test-order", req => ctl.api_payments_create_test_order(req)).middleware("permission:settings.manage");
    Route.get("/admin/api/audit", req => ctl.api_audit(req)).middleware("permission:reports.view");

    // AJAX list / detail / status endpoints for the redesigned admin SPA.
    Route.get("/admin/api/overview", req => ctl.api_overview(req)).middleware("role:admin");
    Route.get("/admin/api/options", req => ctl.api_options(req)).middleware("role:admin");
    Route.get("/admin/api/list/products", req => ctl.api_products_list(req)).middleware("role:admin");
    Route.get("/admin/api/list/categories", req => ctl.api_categories_list(req)).middleware("role:admin");
    Route.get("/admin/api/list/brands", req => ctl.api_brands_list(req)).middleware("role:admin");
    Route.get("/admin/api/list/inventory", req => ctl.api_inventory_list(req)).middleware("role:admin");
    Route.get("/admin/api/list/orders", req => ctl.api_orders_list(req)).middleware("role:admin");
    Route.get("/admin/api/product-full/:id", req => ctl.api_product_full(req)).middleware("role:admin");
    Route.get("/admin/api/order/:id", req => ctl.api_order_show(req)).middleware("role:admin");
    Route.post("/admin/api/order/:id/status", req => ctl.api_order_status(req)).middleware("role:admin");
    Route.post("/admin/api/orders/:id/status", req => ctl.api_order_status(req)).middleware("role:admin");
    Route.post("/admin/api/categories/:id/delete-form", req => ctl.category_delete_form(req)).middleware("role:admin");
    Route.post("/admin/api/brands/:id/delete-form", req => ctl.brand_delete_form(req)).middleware("role:admin");
    Route.get("/admin/api/list/customers", req => ctl.api_customers_list(req)).middleware("role:admin");
}
