// routes/advanced.matrix
// Phase 10 — advanced storefront routes.
//
// Customer-facing paths are descriptive and crawlable. Signed-in areas use
// the built-in `auth` middleware; admin areas are role/permission gated.
// JSON clients add format=json; browsers keep working with plain forms
// (progressive enhancement — no JavaScript required).

import "framework/Router";
import "app/Controllers/AdvancedController";

public fn register_advanced_routes() {
    let ctl = new AdvancedController();

    // ---- wishlist (signed-in customers) ----
    Route.get("/wishlist", fn(req) { return ctl.wishlist_page(req); }).name("wishlist").middleware("auth");
    Route.post("/wishlist/add", fn(req) { return ctl.wishlist_add(req); }).middleware("auth");
    Route.post("/wishlist/remove", fn(req) { return ctl.wishlist_remove(req); }).middleware("auth");

    // ---- reviews & ratings ----
    Route.post("/reviews", fn(req) { return ctl.review_store(req); }).middleware("auth");
    Route.get("/reviews/:product_id", fn(req) { return ctl.review_index(req); }).name("reviews.index");

    // ---- recommendations & recently viewed ----
    Route.get("/recommendations/:product_id", fn(req) { return ctl.recommendations(req); });
    Route.get("/recently-viewed", fn(req) { return ctl.recently_viewed(req); });

    // ---- loyalty points & referrals ----
    Route.get("/account/rewards", fn(req) { return ctl.rewards_page(req); }).name("account.rewards").middleware("auth");
    Route.post("/account/rewards/redeem", fn(req) { return ctl.redeem_points(req); }).middleware("auth");
    Route.post("/account/referral", fn(req) { return ctl.apply_referral(req); }).middleware("auth");

    // ---- gift cards ----
    Route.post("/gift-card/balance", fn(req) { return ctl.gift_card_balance(req); }).middleware("throttle:20,60");

    // ---- customer support ----
    Route.get("/support", fn(req) { return ctl.support_page(req); }).name("support");
    Route.post("/support", fn(req) { return ctl.support_store(req); }).middleware("throttle:5,60");

    // ---- order tracking ----
    Route.get("/track", fn(req) { return ctl.track_page(req); }).name("track");
    Route.post("/track", fn(req) { return ctl.track_lookup(req); });

    // ---- display currency & language preference ----
    Route.post("/locale", fn(req) { return ctl.set_locale(req); });

    // ---- administration (Phase 10 areas) ----
    Route.get("/admin/reviews", fn(req) { return ctl.admin_reviews(req); }).name("admin.reviews").middleware("role:admin");
    Route.post("/admin/reviews/:id", fn(req) { return ctl.admin_review_update(req); }).middleware("permission:catalog.manage");
    Route.get("/admin/api/campaigns", fn(req) { return ctl.admin_campaigns(req); }).middleware("permission:catalog.manage");
    Route.post("/admin/api/campaigns", fn(req) { return ctl.admin_campaign_store(req); }).middleware("permission:catalog.manage");
    Route.get("/admin/api/currencies", fn(req) { return ctl.admin_currencies(req); }).middleware("permission:settings.manage");
    Route.post("/admin/api/currencies", fn(req) { return ctl.admin_currency_store(req); }).middleware("permission:settings.manage");
    Route.get("/admin/api/translations", fn(req) { return ctl.admin_translations(req); }).middleware("permission:settings.manage");
    Route.post("/admin/api/translations", fn(req) { return ctl.admin_translation_store(req); }).middleware("permission:settings.manage");
    Route.get("/admin/api/gift-cards", fn(req) { return ctl.admin_gift_cards(req); }).middleware("permission:settings.manage");
    Route.post("/admin/api/gift-cards", fn(req) { return ctl.admin_gift_card_issue(req); }).middleware("permission:settings.manage");
    Route.get("/admin/api/support-tickets", fn(req) { return ctl.admin_support_tickets(req); }).middleware("permission:customers.manage");
    Route.post("/admin/api/support-tickets/:id", fn(req) { return ctl.admin_support_ticket_update(req); }).middleware("permission:customers.manage");
}
