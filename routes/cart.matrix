// routes/cart.matrix
// Phase 6 — shopping cart routes.
// JSON clients set format=json; browsers get a 303 back to /cart.
// PUT/DELETE have POST equivalents so plain HTML forms work too.

import "framework/Router";
import "app/Controllers/CartController";

public fn register_cart_routes() {
    let ctl = new CartController();

    Route.get("/cart", req => ctl.show(req)).name("cart");
    Route.get("/cart/summary", req => ctl.summary_json(req)).name("cart.summary");
    Route.post("/cart/items", req => ctl.add(req)).name("cart.add");

    Route.put("/cart/items/:id", req => ctl.update(req));
    Route.post("/cart/items/:id/quantity", req => ctl.update(req));
    Route.delete("/cart/items/:id", req => ctl.remove(req));
    Route.post("/cart/items/:id/remove", req => ctl.remove(req));
}
