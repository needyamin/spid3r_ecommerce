// routes/payments.matrix
// Phase 8 — payment endpoints. Webhooks are signature-authenticated and
// intentionally have NO auth/CSRF middleware (gateways send no cookies).

import "framework/Router";
import "app/Controllers/PaymentController";

public fn register_payment_routes() {
    let ctl = new PaymentController();

    Route.get("/payment/:order_number", req => ctl.show(req)).name("payment.page");
    Route.post("/payment/initiate", req => ctl.initiate(req)).name("payment.initiate");
    Route.get("/payment/:order_number/return", req => ctl.return_page(req));
    Route.get("/payment/:order_number/simulator", req => ctl.simulator(req)).name("payment.simulator");
    Route.get("/payment/:order_number/simulate-success", req => ctl.simulate_success(req)).name("payment.simulate_success");
    Route.post("/payment/:order_number/simulate-success", req => ctl.simulate_success(req));

    Route.post("/webhooks/payments/:provider", req => ctl.webhook(req));

    Route.get("/orders/:number/payments", req => ctl.customer_history(req)).middleware("auth");

    Route.post("/admin/api/payments/:id/verify", req => ctl.admin_verify(req)).middleware("permission:payments.manage");
    Route.post("/admin/api/payments/:id/refund", req => ctl.admin_refund(req)).middleware("permission:payments.manage");
    Route.get("/admin/api/payments/reconciliation", req => ctl.admin_reconciliation(req)).middleware("permission:payments.manage");
}
