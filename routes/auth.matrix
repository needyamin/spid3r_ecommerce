// routes/auth.matrix
// Phase 3 — account & admin routes.
// Login POST is rate-limited via the framework's cache-backed throttle
// alias (5 attempts / 60 s per client). Admin area uses role:admin.

import "framework/Router";
import "framework/Response";
import "framework/View/BD";
import "app/Controllers/AuthController";
import "app/Controllers/AdminController";

public fn register_auth_routes() {
    let ctl = new AuthController();

    Route.get("/login", req => ctl.show_login(req)).name("login");
    Route.post("/login", req => ctl.login(req)).middleware("throttle:5,60");
    Route.get("/register", req => ctl.show_register(req)).name("register");
    Route.post("/register", req => ctl.register(req)).middleware("throttle:5,60");
    Route.post("/logout", req => ctl.logout(req));

    Route.get("/forgot-password", req => ctl.show_forgot(req));
    Route.post("/forgot-password", req => ctl.forgot(req)).middleware("throttle:5,60");
    Route.get("/reset-password", req => ctl.show_reset(req));
    Route.post("/reset-password", req => ctl.reset(req));
    Route.get("/verify-email/:token", req => ctl.verify_email(req));

    Route.get("/account", req => ctl.account(req)).middleware("auth");
    Route.post("/account/profile", req => ctl.update_profile(req)).middleware("auth");

    Route.group({"prefix": "/admin", "middleware": "role:admin"}, fn() {
        let panel = new AdminController();
        Route.get("/", req => panel.dashboard(req)).name("admin.dashboard");
    });

    // Permission-gated example used by the RBAC tests & future modules.
    Route.get("/admin/catalog", req => json({"ok": true, "area": "catalog"})).middleware("permission:catalog.manage");
}
