// routes/checkout.matrix
// Phase 7 — checkout, customer order pages, admin order management.

import "framework/Router";
import "framework/Response";
import "app/Controllers/CheckoutController";
import "app/Controllers/OrderController";

public fn register_checkout_routes() {
    let checkout = new CheckoutController();
    let orders = new OrderController();

    // Public checkout (guests provide an address inline).
    Route.get("/checkout", req => checkout.show(req)).name("checkout");
    Route.get("/checkout/quote", req => checkout.quote_json(req));
    Route.post("/checkout", req => checkout.place(req)).name("checkout.place");
    Route.get("/checkout/confirmation/:number", req => checkout.confirmation(req));

    // Authenticated customer area.
    Route.get("/addresses", req => redirect("/account#saved-addresses")).middleware("auth");
    Route.post("/account/addresses", req => checkout.store_address(req)).middleware("auth");
    Route.post("/account/addresses/:id/delete", req => checkout.delete_address(req)).middleware("auth");
    Route.get("/orders", req => orders.index(req)).middleware("auth");
    Route.get("/orders/:number/invoice", req => orders.invoice(req)).middleware("auth");
    Route.get("/orders/:number", req => orders.show(req)).middleware("auth");
    Route.post("/orders/:number/cancel", req => orders.cancel(req)).middleware("auth");

    // Admin order management.
    Route.get("/admin/api/orders", req => orders.admin_index(req)).middleware("permission:orders.manage");
    Route.put("/admin/api/orders/:id/status", req => orders.admin_status(req)).middleware("permission:orders.manage");
    // Browser-form variant (HTML forms can only POST).
    Route.post("/admin/api/orders/:id/status", req => orders.admin_status_form(req)).middleware("permission:orders.manage");
}
