// app/Providers/StoreServiceProvider.matrix
// Spid3r Store — application service provider.
//
// register(): bind store-wide services into the container (config only —
//             no I/O here, per the provider contract).
// boot():     register event listeners / queue-facing wiring that may
//             touch other services. Runs once, after registration.

import "framework/Providers/ServiceProvider";
import "framework/Config/Config";

public class StoreServiceProvider extends ServiceProvider {
    public fn register(self, container) {
        // Store settings, resolved once: name, currency, locale.
        container.singleton("store.settings", fn(c) {
            let currency = string(Config.get("store.currency", "BDT")).trim().upper();
            if currency == "" {
                currency = "BDT";
            }
            return {
                "name": string(Config.get("store.name", "Spid3r Store")),
                "currency": currency,
                "locale": string(Config.get("store.locale", "en"))
            };
        });

        // Catalog cache keys/ttl defaults live here so Phase 5 tuning is
        // one-place-only.
        container.singleton("store.cache", fn(c) {
            return {
                "product_ttl": 300,
                "home_ttl": 120
            };
        });
    }

    public fn boot(self, container) {
        // Event listeners are registered in later phases (audit logs,
        // order notifications). Kept as the single wiring point.
        return null;
    }
}
