// app/Controllers/CartController.matrix
// Phase 6 — cart HTTP layer. Extracts guest/auth identity from cookies,
// delegates all logic to CartService, and returns HTML or JSON.

import "framework/Response";
import "framework/View/BD";
import "framework/Container/Container";
import "framework/HttpException";
import "app/Services/CartService";
import "app/Support/CartIdentity" as CartIdentity;
import "app/Support/StoreChrome" as StoreChrome;
import "app/Services/CurrencyService";

public class CartController {
    public let cart;
    public let settings;
    public let currencies;

    fn new() {
        self.cart = new CartService();
        self.settings = Container.make("store.settings");
        self.currencies = new CurrencyService(string(self.settings["currency"]));
    }

    fn with_cart_cookie(self, res, ident) {
        res.cookie("cart", ident["key"], "/", 2592000);   // 30 days
        return res;
    }

    fn json_or_redirect(self, req, payload, ident) {
        if req.input("format", "") == "json" {
            // AJAX clients also get the refreshed badge count so the
            // header bubble stays in sync without a page reload.
            let full = payload;
            full["count"] = self.cart.item_count(ident);
            let res = json(full);
            return self.with_cart_cookie(res, ident);
        }
        let target = "/cart";
        if req.input("buy_now", "") == "1" {
            target = "/checkout";
        }
        let res = redirect(target);
        return self.with_cart_cookie(res, ident);
    }

    public fn show(self, req) {
        let ident = CartIdentity.cart_identity(req);
        let display_currency = self.currencies.selected(req);
        let fx = self.currencies.context();
        let summary = self.cart.summary(ident, display_currency, fx);
        let ctx = {
            "store_name": self.settings["name"],
            "currency": display_currency,
            "title": "Your cart",
            "meta_description": "Review your cart at " + self.settings["name"] + ".",
            "csrf": ""
        };
        if req.auth != null and req.auth.check() {
            ctx["csrf"] = req.auth.csrf();
        }
        let chrome = StoreChrome.build(req, self.settings);
        for k in chrome.keys() {
            ctx[k] = chrome[k];
        }
        for k in summary.keys() {
            ctx[k] = summary[k];
        }
        let res = view("cart/index", ctx);
        return self.with_cart_cookie(res, ident);
    }

    public fn add(self, req) {
        let ident = CartIdentity.cart_identity(req);
        let product_id = req.input("product_id", null);
        if product_id == null {
            throw validation_failed({"product_id": "Choose a product."});
        }
        let variant = req.input("variant_id", null);
        if variant == "" { variant = null; }
        let qty = int(req.input("quantity", 1));
        self.cart.add(ident, product_id, variant, qty);
        return self.json_or_redirect(req, {"ok": true}, ident);
    }

    public fn update(self, req) {
        let ident = CartIdentity.cart_identity(req);
        let qty = int(req.input("quantity", 0));
        self.cart.update(ident, req.params["id"], qty);
        return self.json_or_redirect(req, {"ok": true}, ident);
    }

    public fn remove(self, req) {
        let ident = CartIdentity.cart_identity(req);
        self.cart.remove(ident, req.params["id"]);
        return self.json_or_redirect(req, {"ok": true}, ident);
    }

    // JSON snapshot for AJAX clients / checkout (Phase 7).
    public fn summary_json(self, req) {
        let ident = CartIdentity.cart_identity(req);
        let display_currency = self.currencies.selected(req);
        let fx = self.currencies.context();
        let summary = self.cart.summary(ident, display_currency, fx);
        let res = json({"data": summary});
        return self.with_cart_cookie(res, ident);
    }
}
