// app/Controllers/CheckoutController.matrix
// Phase 7 — checkout HTTP layer.

import "framework/Response";
import "framework/View/BD";
import "framework/Container/Container";
import "framework/Database/DB";
import "framework/HttpException";
import "app/Support/Money" as Money;
import "app/Services/CheckoutService";
import "app/Services/PaymentService";
import "app/Repositories/CheckoutRepository";
import "app/Support/CartIdentity" as CartIdentity;
import "app/Support/StoreChrome" as StoreChrome;
import "app/Validators/CheckoutValidators" as CheckoutValidators;
import "app/Services/CurrencyService";

fn is_sandbox_mode() -> bool {
    let row = DB.table("settings").where("setting_key", "=", "payments.mode").first();
    if row == null {
        return true;
    }
    return string(row["value"]).trim().lower() != "live";
}

public class CheckoutController {
    public let checkout;
    public let payments;
    public let addresses;
    public let settings;
    public let currencies;

    fn new() {
        self.checkout = new CheckoutService();
        self.payments = new PaymentService();
        self.addresses = new AddressRepository();
        self.settings = Container.make("store.settings");
        self.currencies = new CurrencyService(string(self.settings["currency"]));
    }

    fn base(self, req, title: string) {
        let display_currency = self.currencies.selected(req);
        let ctx = {
            "store_name": self.settings["name"],
            "currency": display_currency,
            "title": title,
            "meta_description": title + " — " + self.settings["name"],
            "current_path": string(req.path),
            "csrf": ""
        };
        let chrome = StoreChrome.build(req, self.settings);
        for k in chrome.keys() {
            ctx[k] = chrome[k];
        }
        return ctx;
    }

    fn options(self, req) {
        let opts = {};
        for k in req.query_params.keys() {
            opts[k] = req.query_params[k];
        }
        if req.data != null {
            for k2 in req.data.keys() {
                opts[k2] = req.data[k2];
            }
        }
        opts["currency"] = self.currencies.selected(req);
        opts["fx"] = self.currencies.context();
        return opts;
    }

    public fn show(self, req) {
        let ident = CartIdentity.cart_identity(req);
        let quote = self.checkout.quote(ident, self.options(req));
        let ctx = self.base(req, "Checkout");
        for k in quote.keys() {
            ctx[k] = quote[k];
        }
        let saved = [];
        let user_name = "";
        let user_email = "";
        if ident["user_id"] != null {
            saved = self.addresses.for_user(ident["user_id"]);
            let u = DB.table("users").where("id", "=", ident["user_id"]).first();
            if u != null {
                user_name = string(u["name"]);
                user_email = string(u["email"]);
            }
        }
        ctx["addresses"] = saved;
        ctx["has_addresses"] = saved.len() > 0;
        ctx["user_name"] = user_name;
        ctx["user_email"] = user_email;
        ctx["signed_in"] = ident["user_id"] != null;
        if req.auth != null and req.auth.check() {
            ctx["csrf"] = req.auth.csrf();
        }

        // Active payment methods & mode
        let cod_limit_row = DB.table("settings").where("setting_key", "=", "payments.cod_max_limit_minor").first();
        let cod_limit_minor = 5000000;
        if cod_limit_row != null and string(cod_limit_row["value"]).trim() != "" {
            cod_limit_minor = int(cod_limit_row["value"]);
        }
        let quote_total = int(quote["total_minor"]);
        let cod_exceeded = cod_limit_minor > 0 and quote_total > cod_limit_minor;

        let mode_row = DB.table("settings").where("setting_key", "=", "payments.mode").first();
        let gateway_mode = "sandbox";
        if mode_row != null and string(mode_row["value"]).trim() != "" {
            gateway_mode = string(mode_row["value"]).trim().lower();
        }

        let methods = [];
        let cod_on = self.payments.is_provider_enabled("cod");
        if cod_on {
            methods.push({
                "id": "cod",
                "name": "Cash on Delivery (COD)",
                "icon": "💵",
                "description": "Pay in cash when your parcel arrives",
                "disabled": cod_exceeded,
                "disabled_reason": "Order exceeds COD limit of " + Money.format(cod_limit_minor, "BDT"),
                "selected": not cod_exceeded
            });
        }

        if self.payments.is_provider_enabled("bkash") {
            methods.push({
                "id": "bkash",
                "name": "bKash Direct / MFS",
                "icon": "📱",
                "description": "Fast & secure payment from your bKash personal wallet",
                "disabled": false,
                "disabled_reason": "",
                "selected": not cod_on or cod_exceeded
            });
        }

        if self.payments.is_provider_enabled("nagad") {
            methods.push({
                "id": "nagad",
                "name": "Nagad Instant Payment",
                "icon": "📱",
                "description": "Pay directly using your Nagad account",
                "disabled": false,
                "disabled_reason": "",
                "selected": false
            });
        }

        if self.payments.is_provider_enabled("sslcommerz") {
            methods.push({
                "id": "sslcommerz",
                "name": "Cards & MFS (SSLCommerz)",
                "icon": "💳",
                "description": "Visa, MasterCard, Amex, Internet Banking & all BD wallets",
                "disabled": false,
                "disabled_reason": "",
                "selected": false
            });
        }

        if self.payments.is_provider_enabled("stripe") {
            methods.push({
                "id": "stripe",
                "name": "Credit / Debit Card (Stripe)",
                "icon": "💳",
                "description": "International credit/debit card, Apple Pay & Google Pay",
                "disabled": false,
                "disabled_reason": "",
                "selected": false
            });
        }

        let has_sel = false;
        let mi = 0;
        while mi < methods.len() {
            if methods[mi]["selected"] and not methods[mi]["disabled"] {
                has_sel = true;
                break;
            }
            mi += 1;
        }
        if not has_sel and methods.len() > 0 {
            let mj = 0;
            while mj < methods.len() {
                if not methods[mj]["disabled"] {
                    methods[mj]["selected"] = true;
                    break;
                }
                mj += 1;
            }
        }

        ctx["payment_methods"] = methods;
        ctx["has_payment_methods"] = methods.len() > 0;
        ctx["gateway_mode"] = gateway_mode;
        ctx["is_sandbox"] = gateway_mode == "sandbox";

        let res = view("checkout/index", ctx);
        res.cookie("cart", ident["key"], "/", 2592000);
        return res;
    }

    public fn quote_json(self, req) {
        let ident = CartIdentity.cart_identity(req);
        let res = json({"data": self.checkout.quote(ident, self.options(req))});
        res.cookie("cart", ident["key"], "/", 2592000);
        return res;
    }

    public fn place(self, req) {
        req.validate_or_fail(CheckoutValidators.place_rules());
        let ident = CartIdentity.cart_identity(req);
        let order = self.checkout.place_order(ident, req.data);
        let number = string(order["order_number"]);
        let pay_method = string(req.input("payment_method", "")).trim().lower();
        if req.input("format", "") == "json" {
            let res = json({"data": {"order_number": number, "status": order["status"], "total_minor": order["total_minor"]}}, 201);
            res.cookie("cart", ident["key"], "/", 2592000);
            return res;
        }

        if pay_method == "cod" {
            DB.table("orders").where("id", "=", order["id"]).update({"status": "pending"});
            try {
                self.payments.initiate(number, "cod", ident["user_id"]);
            } catch (e) {}
            let res = redirect("/checkout/confirmation/" + number);
            res.cookie("cart", ident["key"], "/", 2592000);
            return res;
        }

        if pay_method != "" and self.payments.is_provider_enabled(pay_method) {
            try {
                let init_res = self.payments.initiate(number, pay_method, ident["user_id"]);
                if init_res.has("redirect_url") and string(init_res["redirect_url"]).trim() != "" {
                    let rurl = string(init_res["redirect_url"]).trim();
                    let res = redirect(rurl);
                    res.cookie("cart", ident["key"], "/", 2592000);
                    return res;
                }
            } catch (e) {
                let msg = "Payment initiation failed.";
                if is_http_exception(e) or (type_of(e) == "map" and e.has("message")) {
                    msg = string(e["message"]);
                } else {
                    msg = string(e);
                }
                let res = redirect("/payment/" + number + "?err=" + url_encode(msg) + "&failed_gateway=" + url_encode(pay_method));
                res.cookie("cart", ident["key"], "/", 2592000);
                return res;
            }
        }

        if pay_method != "" and pay_method != "cod" {
            let res = redirect("/payment/" + number);
            res.cookie("cart", ident["key"], "/", 2592000);
            return res;
        }

        let res = redirect("/checkout/confirmation/" + number);
        res.cookie("cart", ident["key"], "/", 2592000);
        return res;
    }

    public fn confirmation(self, req) {
        let number = string(req.params["number"]);
        let order = DB.table("orders").where("order_number", "=", number).first();
        if order == null {
            throw not_found("Order not found.");
        }
        let ctx = self.base(req, "Order Confirmed — #" + number);
        if req.auth != null and req.auth.check() {
            ctx["csrf"] = req.auth.csrf();
            ctx["signed_in"] = true;
        } else {
            ctx["signed_in"] = false;
        }
        let raw_items = DB.table("order_items").where("order_id", "=", order["id"]).get();
        let order_cur = "BDT";
        if order.has("currency") and string(order["currency"]).trim() != "" {
            order_cur = string(order["currency"]).trim().upper();
        }
        let items = [];
        let i = 0;
        while i < raw_items.len() {
            let row = raw_items[i];
            items.push({
                "name": string(row["name_snapshot"]),
                "sku": string(row["sku_snapshot"]),
                "quantity": int(row["quantity"]),
                "unit_display": Money.format(int(row["unit_price_minor"]), order_cur),
                "line_display": Money.format(int(row["line_total_minor"]), order_cur)
            });
            i += 1;
        }
        let addr = {"full_name": "", "phone": "", "line1": "", "line2": "", "city": "", "district": "", "postal_code": "", "country": "Bangladesh"};
        try {
            let parsed = json_parse(string(order["shipping_address_json"]));
            if type_of(parsed) == "map" {
                for ak in parsed.keys() {
                    addr[ak] = string(parsed[ak]);
                }
            }
        } catch (e) {}
        let pay_rows = DB.table("payments").where("order_id", "=", order["id"]).orderBy("id", "DESC").get();
        let has_payment = pay_rows.len() > 0;
        let payment_provider_raw = "";
        let payment_provider = "Cash on Delivery (COD)";
        let payment_status = "";
        if has_payment {
            payment_provider_raw = string(pay_rows[0]["provider"]).trim().lower();
            if payment_provider_raw == "cod" {
                payment_provider = "Cash on Delivery";
            } elif payment_provider_raw == "bkash" {
                payment_provider = "bKash Direct";
            } elif payment_provider_raw == "nagad" {
                payment_provider = "Nagad Instant";
            } elif payment_provider_raw == "sslcommerz" {
                payment_provider = "SSLCommerz";
            } elif payment_provider_raw == "stripe" {
                payment_provider = "Card / Stripe";
            } else {
                payment_provider = payment_provider_raw.upper();
            }
            payment_status = string(pay_rows[0]["status"]);
        }
        let st = string(order["status"]);
        let is_paid = st == "paid";
        let is_pending_cod = (st == "pending" or payment_provider_raw == "cod") and not is_paid;
        let is_awaiting = st == "awaiting_payment" and not is_pending_cod and not is_paid;
        let is_sb = is_sandbox_mode();

        let status_label = "Pending";
        let status_badge_class = "badge bg-secondary";
        if is_paid {
            status_label = "Paid";
            status_badge_class = "badge bg-success";
        } elif is_pending_cod {
            status_label = "Pending (Cash on Delivery)";
            status_badge_class = "badge bg-info text-dark";
        } elif is_awaiting {
            status_label = "Awaiting Payment";
            status_badge_class = "badge bg-warning text-dark";
        } elif st == "shipped" {
            status_label = "Shipped";
            status_badge_class = "badge bg-primary";
        } elif st == "delivered" {
            status_label = "Delivered";
            status_badge_class = "badge bg-success";
        } elif st == "cancelled" {
            status_label = "Cancelled";
            status_badge_class = "badge bg-danger";
        } else {
            status_label = st.replace("_", " ");
            status_badge_class = "badge bg-secondary";
        }

        ctx["order"] = order;
        ctx["status"] = st;
        ctx["status_label"] = status_label;
        ctx["status_badge_class"] = status_badge_class;
        ctx["items"] = items;
        ctx["has_items"] = items.len() > 0;
        ctx["address"] = addr;
        ctx["has_payment"] = has_payment;
        ctx["payment_provider"] = payment_provider;
        ctx["payment_provider_raw"] = payment_provider_raw;
        ctx["payment_status"] = payment_status;
        ctx["subtotal_display"] = Money.format(int(order["subtotal_minor"]), order_cur);
        ctx["discount_display"] = Money.format(int(order["discount_minor"]), order_cur);
        ctx["has_discount"] = int(order["discount_minor"]) > 0;
        ctx["shipping_display"] = Money.format(int(order["shipping_minor"]), order_cur);
        ctx["tax_display"] = Money.format(int(order["tax_minor"]), order_cur);
        ctx["total_display"] = Money.format(int(order["total_minor"]), order_cur);
        ctx["is_awaiting_payment"] = is_awaiting;
        ctx["is_pending_cod"] = is_pending_cod;
        ctx["is_paid"] = is_paid;
        ctx["is_sandbox"] = is_sb;
        return view("checkout/confirmation", ctx);
    }

    // Saved addresses for authenticated customers.
    public fn store_address(self, req) {
        req.validate_or_fail(CheckoutValidators.address_rules());
        let id = self.addresses.create({
            "user_id": req.auth.id(),
            "label": req.input("label", "Home"),
            "full_name": req.input("full_name", ""),
            "phone": req.input("phone", ""),
            "line1": req.input("line1", ""),
            "line2": req.input("line2", ""),
            "city": req.input("city", ""),
            "district": req.input("district", ""),
            "postal_code": req.input("postal_code", ""),
            "country": req.input("country", "Bangladesh"),
            "is_default": 1
        });
        if req.input("format", "") == "browser" {
            return redirect("/account?address_added=1#saved-addresses");
        }
        return json({"data": {"id": id, "created": true}}, 201);
    }

    public fn delete_address(self, req) {
        let id = int(req.params["id"]);
        let uid = req.auth.id();
        DB.table("addresses").where("id", "=", id).where("user_id", "=", uid).delete();
        if req.input("format", "") == "json" {
            return json({"data": {"deleted": true, "id": id}});
        }
        return redirect("/account?address_deleted=1#saved-addresses");
    }
}
