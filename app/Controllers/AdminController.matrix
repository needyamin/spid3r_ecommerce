    }

    // ---------- AJAX list / detail / status APIs (redesigned admin SPA) ----------

    // Augment a raw product row with major-unit prices + scaled tax/weight
    // so client forms can be pre-filled without float math.
    fn decorate_product(self, row) {
        let out = row;
        out["price_major"] = Money.to_major(int(row["price_minor"]));
        out["compare_major"] = Money.to_major(minor_or_zero(row["compare_at_minor"]));
        out["cost_major"] = Money.to_major(minor_or_zero(row["cost_minor"]));
        out["tax_percent"] = scaled_display(minor_or_zero(row["tax_rate_bps"]), 2);
        out["weight_kg"] = scaled_display(minor_or_zero(row["weight_grams"]), 3);
        out["price_display"] = Money.format(int(row["price_minor"]), self.store_currency());
        out["is_featured"] = int(row["is_featured"]) == 1;
        out["category_name"] = "";
        out["brand_name"] = "";
        let cat = DB.table("categories").where("id", "=", row["category_id"]).first();
        if cat != null {
            out["category_name"] = string(cat["name"]);
        }
        if row["brand_id"] != null {
            let brand = DB.table("brands").where("id", "=", row["brand_id"]).first();
            if brand != null {
                out["brand_name"] = string(brand["name"]);
            }
        }
        return out;
    }

    fn build_product_list_row(self, row) {
        let pid = int(row["id"]);
        let qty = 0;
        let reserved = 0;
        let threshold = 0;
        let inv = DB.table("inventory").where("product_id", "=", pid).whereNull("variant_id").first();
        if inv != null {
            qty = int(inv["quantity"]);
            reserved = int(inv["reserved"]);
            threshold = int(inv["low_stock_threshold"]);
        }
        let available = qty - reserved;
        if available < 0 {
            available = 0;
        }
        let thumb = "";
        let primary = DB.table("product_images").where("product_id", "=", pid).orderBy("sort_order", "ASC").first();
        if primary != null {
            thumb = Images.public_image_url(primary["path"]);
        }
        let cat_name = "";
        let brand_name = "";
        let cat = DB.table("categories").where("id", "=", row["category_id"]).first();
        if cat != null {
            cat_name = string(cat["name"]);
        }
        if row["brand_id"] != null {
            let brand = DB.table("brands").where("id", "=", row["brand_id"]).first();
            if brand != null {
                brand_name = string(brand["name"]);
            }
        }
        return {
            "id": pid,
            "name": row["name"],
            "slug": row["slug"],
            "sku": row["sku"],
            "price_minor": int(row["price_minor"]),
            "price_display": Money.format(int(row["price_minor"]), self.store_currency()),
            "status": string(row["status"]),
            "is_published": string(row["status"]) == "published",
            "is_draft": string(row["status"]) == "draft",
            "is_featured": int(row["is_featured"]) == 1,
            "category_name": cat_name,
            "brand_name": brand_name,
            "stock": qty,
            "available": available,
            "reserved": reserved,
            "low_stock_threshold": threshold,
            "is_low_stock": qty <= threshold,
            "thumb": thumb,
            "has_thumb": thumb != ""
        };
    }

    public fn api_overview(self, req) {
        let stats = self.admin.dashboard();
        let recent = [];
        let i = 0;
        while i < stats["recent_orders"].len() {
            let o = stats["recent_orders"][i];
            let customer_name = "Guest";
            if o["user_id"] != null {
                let u = DB.table("users").where("id", "=", o["user_id"]).first();
                if u != null {
                    customer_name = string(u["name"]);
                }
            }
            let item_count = DB.table("order_items").where("order_id", "=", o["id"]).count();
            recent.push({
                "id": o["id"],
                "order_number": o["order_number"],
                "customer_name": customer_name,
                "item_count": item_count,
                "status": o["status"],
                "status_label": string(o["status"]).replace("_", " "),
                "total_display": Money.format(int(o["total_minor"]), self.order_currency(o)),
                "placed_at": o["placed_at"]
            });
            i += 1;
        }
        return json({"data": {
            "orders": stats["orders"],
            "pending_orders": stats["pending_orders"],
            "pipeline_pending": stats["pipeline_pending"],
            "pipeline_processing": stats["pipeline_processing"],
            "pipeline_shipped": stats["pipeline_shipped"],
            "pipeline_delivered": stats["pipeline_delivered"],
            "pipeline_cancelled": stats["pipeline_cancelled"],
            "pct_pending": stats["pct_pending"],
            "pct_processing": stats["pct_processing"],
            "pct_shipped": stats["pct_shipped"],
            "pct_delivered": stats["pct_delivered"],
            "revenue_minor": stats["revenue_minor"],
            "revenue_display": Money.format(int(stats["revenue_minor"]), self.store_currency()),
            "customers": stats["customers"],
            "products": stats["products"],
            "published_products": stats["published_products"],
            "categories": stats["categories"],
            "brands": stats["brands"],
            "low_stock": stats["low_stock"],
            "low_stock_items": stats["low_stock_items"],
            "has_low_stock_items": stats["has_low_stock_items"],
            "coupons": stats["coupons"],
            "recent_orders": recent,
            "has_recent": stats["has_recent"]
        }});
    }

    public fn api_options(self, req) {
        let cats = DB.table("categories").orderBy("name", "ASC").get();
        let cat_opts = [];
        let i = 0;
        while i < cats.len() {
            cat_opts.push({"id": cats[i]["id"], "name": cats[i]["name"]});
            i += 1;
        }
        let brands = DB.table("brands").orderBy("name", "ASC").get();
        let brand_opts = [];
        let j = 0;
        while j < brands.len() {
            brand_opts.push({"id": brands[j]["id"], "name": brands[j]["name"]});
            j += 1;
        }
        return json({"data": {
            "categories": cat_opts,
            "brands": brand_opts,
            "order_statuses": self.order_statuses,
            "product_statuses": ["draft", "published", "archived"]
        }});
    }

    public fn api_products_list(self, req) {
        let page = int(req.input("page", 1));
        if page < 1 {
            page = 1;
        }
        let per_page = 12;
        let q = string(req.input("q", "")).trim();
        let status = string(req.input("status", "")).trim();
        let cat_id = string(req.input("category_id", "")).trim();
        let stock_status = string(req.input("stock_status", "")).trim();
        let sort = string(req.input("sort", "newest")).trim();

        let query = DB.table("products");
        if q != "" {
            let needle = "%" + q + "%";
            query.whereGroup("AND", fn(group) {
                group.where("name", "LIKE", needle).orWhere("sku", "LIKE", needle);
            });
        }
        if status != "" {
            query.where("status", "=", status);
        }
        if cat_id != "" and int(cat_id) > 0 {
            query.where("category_id", "=", int(cat_id));
        }

        if sort == "price_asc" {
            query.orderBy("price_minor", "ASC");
        } elif sort == "price_desc" {
            query.orderBy("price_minor", "DESC");
        } elif sort == "name_asc" {
            query.orderBy("name", "ASC");
        } else {
            query.orderBy("id", "DESC");
        }

        let page_result = query.paginate(page, per_page);
        let rows = page_result["data"];
        let data = [];
        let i = 0;
        while i < rows.len() {
            let r = self.build_product_list_row(rows[i]);
            let keep = true;
            if stock_status == "low" and not r["is_low_stock"] {
                keep = false;
            } elif stock_status == "out" and r["stock"] > 0 {
                keep = false;
            } elif stock_status == "in" and r["stock"] <= 0 {
                keep = false;
            }
            if keep {
                data.push(r);
            }
            i += 1;
        }

        let inv_rows = DB.table("inventory").whereNull("variant_id").get();
        let low_count = 0;
        let out_count = 0;
        let ii = 0;
        while ii < inv_rows.len() {
            let qty = int(inv_rows[ii]["quantity"]);
            let th = int(inv_rows[ii]["low_stock_threshold"]);
            if qty <= 0 {
                out_count = out_count + 1;
            } elif qty <= th {
                low_count = low_count + 1;
            }
            ii += 1;
        }

        let cats = DB.table("categories").orderBy("name", "ASC").get();
        let cat_list = [];
        let ci = 0;
        while ci < cats.len() {
            cat_list.push({"id": cats[ci]["id"], "name": cats[ci]["name"]});
            ci += 1;
        }

        return json({"data": data, "meta": {
            "count": data.len(),
            "total": int(page_result["total"]),
            "page": int(page_result["page"]),
            "per_page": int(page_result["per_page"]),
            "last_page": int(page_result["last_page"]),
            "has_more": page_result["has_more"],
            "stats": {
                "total": DB.table("products").count(),
                "published": DB.table("products").where("status", "=", "published").count(),
                "draft": DB.table("products").where("status", "=", "draft").count(),
                "low_stock": low_count,
                "out_of_stock": out_count
            },
            "categories": cat_list
        }});
    }

