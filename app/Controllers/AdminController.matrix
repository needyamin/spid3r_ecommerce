// app/Controllers/AdminController.matrix
// Phase 9 — administration panel (thin HTTP layer).

import "framework/Response";
import "framework/View/BD";
import "framework/Resource";
import "framework/Container/Container";
import "framework/HttpException";
import "framework/Database/DB";
import "app/Services/AdminService";
import "app/Services/OrderService";
import "app/Services/ImageService";
import "app/Services/InventoryService";
import "app/Support/StoreChrome" as StoreChrome;
import "app/Support/Images" as Images;
import "app/Repositories/OrderRepository";
import "app/Repositories/CatalogRepository";
import "app/Support/Money" as Money;
import "app/Support/CatalogCache" as CatalogCache;

let identity = row => row;

// Format an integer with a fixed number of decimals WITHOUT floats
// (tax percent, weight in kg).
let scaled_display = fn(value: int, decimals: int) -> string {
    let factor = 1;
    let i = 0;
    while i < decimals {
        factor = factor * 10;
        i += 1;
    }
    let negative = value < 0;
    let v = value;
    if negative {
        v = 0 - v;
    }
    let whole = v / factor;
    let frac_str = string(v - whole * factor);
    while len(frac_str) < decimals {
        frac_str = "0" + frac_str;
    }
    let sign = "";
    if negative {
        sign = "-";
    }
    return sign + string(whole) + "." + frac_str;
};

// Null-safe integer coercion for optional money columns (cost/compare-at
// may be NULL on older rows).
let minor_or_zero = fn(v) {
    if v == null {
        return 0;
    }
    return int(v);
};

// Option list for a <select>: one entry per allowed value, the current
// one flagged (BD templates can only test truthiness, never compare).
let status_options_for = fn(current: string, allowed) {
    let out = [];
    let i = 0;
    while i < allowed.len() {
        let v = string(allowed[i]);
        out.push({"value": v, "label": v, "selected": v == string(current)});
        i += 1;
    }
    return out;
};

public class AdminController {
    public let admin;
    public let orders;
    public let categories;
    public let brands;
    public let settings;
    public let order_statuses;

    fn new() {
        self.admin = new AdminService();
        self.orders = new OrderRepository();
        self.categories = new CategoryRepository();
        self.brands = new BrandRepository();
        self.settings = Container.make("store.settings");
        self.order_statuses = (new OrderService()).statuses();
    }

    fn store_currency(self) -> string {
        if self.settings != null and self.settings.has("currency") and string(self.settings["currency"]).trim() != "" {
            return string(self.settings["currency"]).trim().upper();
        }
        return "BDT";
    }

    fn order_currency(self, order) -> string {
        if order != null and order.has("currency") and string(order["currency"]).trim() != "" {
            return string(order["currency"]).trim().upper();
        }
        return self.store_currency();
    }

    fn ctx(self, req, title: string, page: string, extra) {
        let base = {
            "store_name": self.settings["name"],
            "currency": self.settings["currency"],
            "title": title,
            "meta_description": "Store administration — " + title,
            "page": page,
            "is_admin_area": true,
            "admin_active_products": page == "products",
            "admin_active_inventory": page == "inventory",
            "admin_active_dashboard": page == "dashboard",
            "csrf": req.auth.csrf()
        };
        base["admin_navigation"] = [
            {"label": "Overview", "url": "/admin/dashboard", "active": page == "dashboard", "icon": "dashboard"},
            {"label": "Orders", "url": "/admin/orders", "active": page == "orders", "icon": "orders"},
            {"label": "Products", "url": "/admin/products", "active": page == "products", "icon": "products"},
            {"label": "Categories", "url": "/admin/categories", "active": page == "categories", "icon": "categories"},
            {"label": "Brands", "url": "/admin/brands", "active": page == "brands", "icon": "brands"},
            {"label": "Inventory", "url": "/admin/inventory", "active": page == "inventory", "icon": "inventory"},
            {"label": "Customers", "url": "/admin/customers", "active": page == "customers", "icon": "customers"},
            {"label": "Staff", "url": "/admin/staff", "active": page == "staff", "icon": "staff"},
            {"label": "Roles", "url": "/admin/roles", "active": page == "roles", "icon": "roles"},
            {"label": "Coupons", "url": "/admin/coupons", "active": page == "coupons", "icon": "coupons"},
            {"label": "Payments", "url": "/admin/payments", "active": page == "payments", "icon": "payments"},
            {"label": "Shipping", "url": "/admin/shipping", "active": page == "shipping", "icon": "shipping"},
            {"label": "Reports", "url": "/admin/reports", "active": page == "reports", "icon": "reports"},
            {"label": "Settings", "url": "/admin/settings", "active": page == "settings", "icon": "settings"}
        ];
        let chrome = StoreChrome.build(req, self.settings);
        for ck in chrome.keys() {
            base[ck] = chrome[ck];
        }
        if extra != null {
            for k in extra.keys() {
                base[k] = extra[k];
            }
        }
        return base;
    }

    fn rows_for(self, page: string) {
        let headers = [];
        let rows = [];
        if page == "products" {
            headers = ["ID", "Name", "SKU", "Price", "Status"];
            let data = DB.table("products").orderBy("id", "DESC").limit(50).get();
            let i = 0;
            while i < data.len() {
                rows.push([data[i]["id"], data[i]["name"], data[i]["sku"],
                           Money.format(int(data[i]["price_minor"]), self.store_currency()), data[i]["status"]]);
                i += 1;
            }
        } elif page == "categories" {
            headers = ["ID", "Name", "Slug", "Parent"];
            let data = self.categories.all();
            let i = 0;
            while i < data.len() {
                rows.push([data[i]["id"], data[i]["name"], data[i]["slug"], data[i]["parent_id"]]);
                i += 1;
            }
        } elif page == "brands" {
            headers = ["ID", "Name", "Slug"];
            let data = self.brands.all();
            let i = 0;
            while i < data.len() {
                rows.push([data[i]["id"], data[i]["name"], data[i]["slug"]]);
                i += 1;
            }
        } elif page == "inventory" {
            headers = ["Product ID", "Available", "Reserved", "Low-stock at"];
            let data = DB.table("inventory").orderBy("product_id", "ASC").get();
            let i = 0;
            while i < data.len() {
                rows.push([data[i]["product_id"], data[i]["quantity"], data[i]["reserved"], data[i]["low_stock_threshold"]]);
                i += 1;
            }
        } elif page == "orders" {
            headers = ["Order", "Status", "Total", "Placed"];
            let data = self.orders.admin_list(1, 50)["data"];
            let i = 0;
            while i < data.len() {
                rows.push([data[i]["order_number"], data[i]["status"],
                           Money.format(int(data[i]["total_minor"]), self.order_currency(data[i])), data[i]["placed_at"]]);
                i += 1;
            }
        } elif page == "customers" {
            headers = ["ID", "Name", "Email", "Status"];
            let data = self.admin.customers();
            let i = 0;
            while i < data.len() {
                rows.push([data[i]["id"], data[i]["name"], data[i]["email"], data[i]["status"]]);
                i += 1;
            }
        } elif page == "staff" {
            headers = ["ID", "Name", "Email"];
            let data = self.admin.staff();
            let i = 0;
            while i < data.len() {
                rows.push([data[i]["id"], data[i]["name"], data[i]["email"]]);
                i += 1;
            }
        } elif page == "roles" {
            headers = ["ID", "Name", "Slug", "Permissions"];
            let data = self.admin.roles();
            let i = 0;
            while i < data.len() {
                rows.push([data[i]["id"], data[i]["name"], data[i]["slug"], data[i]["permission_count"]]);
                i += 1;
            }
        } elif page == "coupons" {
            headers = ["ID", "Code", "Type", "Value", "Uses"];
            let data = self.admin.coupons();
            let i = 0;
            while i < data.len() {
                rows.push([data[i]["id"], data[i]["code"], data[i]["type"], data[i]["value_minor"], data[i]["uses"]]);
                i += 1;
            }
        } elif page == "audit" {
            headers = ["Action", "Entity", "Entity ID", "When"];
            let data = self.admin.audit(50);
            let i = 0;
            while i < data.len() {
                rows.push([data[i]["action"], data[i]["entity_type"], data[i]["entity_id"], data[i]["created_at"]]);
                i += 1;
            }
        } else {
            headers = ["Key", "Value", "Group"];
            let group = "";
            if page == "shipping" { group = "shipping"; }
            if page == "payments" { group = "payments"; }
            let data = self.admin.settings(group);
            let i = 0;
            while i < data.len() {
                rows.push([data[i]["setting_key"], data[i]["value"], data[i]["setting_group"]]);
                i += 1;
            }
        }
        return {"headers": headers, "rows": rows, "has_rows": rows.len() > 0};
    }

    fn audit(self, req, action: string, entity: string, entity_id, payload) {
        self.admin.log(req.auth.id(), action, entity, entity_id, payload);
        return true;
    }

    public fn dashboard(self, req) {
        let stats = self.admin.dashboard();
        let formatted_recent = [];
        let i = 0;
        while i < stats["recent_orders"].len() {
            let o = stats["recent_orders"][i];
            let row = {};
            for k in o.keys() {
                row[k] = o[k];
            }
            let customer_name = "Guest";
            if o["user_id"] != null {
                let u = DB.table("users").where("id", "=", o["user_id"]).first();
                if u != null {
                    customer_name = string(u["name"]);
                }
            }
            row["customer_name"] = customer_name;
            row["item_count"] = DB.table("order_items").where("order_id", "=", o["id"]).count();
            row["status_label"] = string(o["status"]).replace("_", " ");
            row["total_display"] = Money.format(int(o["total_minor"]), self.order_currency(o));
            formatted_recent.push(row);
            i += 1;
        }
        stats["recent_orders"] = formatted_recent;
        let ctx = self.ctx(req, "Dashboard", "dashboard", {
            "revenue_display": Money.format(int(stats["revenue_minor"]), self.store_currency()),
            "csrf": req.auth.csrf()
        });
        for k in stats.keys() {
            ctx[k] = stats[k];
        }
        return view("admin/dashboard", ctx);
    }

    // Per-page data for the admin write forms: the editable rows plus
    // the option lists the forms need (categories, brands, roles,
    // permissions, order statuses).
    fn page_extras(self, name: string, req = null) {
        let extra = {};

        if name == "products" {
            let cats = self.categories.all();
            let cat_opts = [];
            let ci = 0;
            while ci < cats.len() {
                cat_opts.push({"value": cats[ci]["id"], "label": cats[ci]["name"]});
                ci += 1;
            }
            let brands = self.brands.all();
            let brand_opts = [];
            let bi = 0;
            while bi < brands.len() {
                brand_opts.push({"value": brands[bi]["id"], "label": brands[bi]["name"]});
                bi += 1;
            }
            let product_q = "";
            let page_number = 1;
            if req != null and req.query_params.has("q") {
                product_q = string(req.query_params["q"]).trim();
            }
            if req != null and req.query_params.has("page") {
                page_number = int(req.query_params["page"]);
                if page_number < 1 {
                    page_number = 1;
                }
            }
            let page_size = 25;
            let count_query = DB.table("products");
            if product_q != "" {
                let needle = "%" + product_q + "%";
                count_query.whereGroup("AND", fn(group) {
                    group.where("name", "LIKE", needle).orWhere("sku", "LIKE", needle);
                });
            }
            let filtered_total = count_query.count();
            let page_count = 1;
            if filtered_total > 0 {
                page_count = (filtered_total + page_size - 1) / page_size;
            }
            if page_number > page_count {
                page_number = page_count;
            }
            let rows_query = DB.table("products");
            if product_q != "" {
                let needle = "%" + product_q + "%";
                rows_query.whereGroup("AND", fn(group) {
                    group.where("name", "LIKE", needle).orWhere("sku", "LIKE", needle);
                });
            }
            let rows = rows_query.orderBy("id", "DESC")
                .limit(page_size)
                .offset((page_number - 1) * page_size)
                .get();
            // One query for all gallery thumbnails on the current page (never N+1).
            let ids = [];
            let ri = 0;
            while ri < rows.len() {
                ids.push(rows[ri]["id"]);
                ri += 1;
            }
            let thumbs = {};
            if ids.len() > 0 {
                let imgs = DB.table("product_images")
                    .whereIn("product_id", ids)
                    .orderBy("sort_order", "ASC")
                    .get();
                let ii = 0;
                while ii < imgs.len() {
                    let pid = string(imgs[ii]["product_id"]);
                    if not thumbs.has(pid) {
                        thumbs[pid] = Images.public_image_url(imgs[ii]["path"]);
                    }
                    ii += 1;
                }
            }
            let list = [];
            let i = 0;
            while i < rows.len() {
                let pid = string(rows[i]["id"]);
                let stock = DB.table("inventory")
                    .where("product_id", "=", rows[i]["id"])
                    .whereNull("variant_id")
                    .first();
                let qty = 0;
                let reserved = 0;
                let threshold = 0;
                if stock != null {
                    qty = int(stock["quantity"]);
                    reserved = int(stock["reserved"]);
                    threshold = int(stock["low_stock_threshold"]);
                }
                let available = qty - reserved;
                if available < 0 {
                    available = 0;
                }
                let thumb = "";
                if thumbs.has(pid) {
                    thumb = string(thumbs[pid]);
                }
                list.push({
                    "id": rows[i]["id"],
                    "name": rows[i]["name"],
                    "sku": rows[i]["sku"],
                    "price": Money.to_major(rows[i]["price_minor"]),
                    "price_display": Money.format(int(rows[i]["price_minor"]), self.store_currency()),
                    "status": rows[i]["status"],
                    "status_options": status_options_for(string(rows[i]["status"]), ["draft", "published", "archived"]),
                    "is_published": string(rows[i]["status"]) == "published",
                    "is_featured": int(rows[i]["is_featured"]) == 1,
                    "stock": qty,
                    "available": available,
                    "reserved": reserved,
                    "low_stock_threshold": threshold,
                    "is_low_stock": qty <= threshold,
                    "thumb": thumb,
                    "has_thumb": thumb != "",
                    "category_id": rows[i]["category_id"]
                });
                i += 1;
            }
            let product_prev_url = "";
            if page_number > 1 {
                product_prev_url = "/admin/products?page=" + string(page_number - 1);
                if product_q != "" {
                    product_prev_url = product_prev_url + "&q=" + url_encode(product_q);
                }
            }
            let product_next_url = "";
            if page_number < page_count {
                product_next_url = "/admin/products?page=" + string(page_number + 1);
                if product_q != "" {
                    product_next_url = product_next_url + "&q=" + url_encode(product_q);
                }
            }
            extra["product_rows"] = list;
            extra["has_product_rows"] = list.len() > 0;
            extra["total_products"] = filtered_total;
            extra["all_products_count"] = DB.table("products").count();
            extra["product_q"] = product_q;
            extra["product_page"] = page_number;
            extra["product_page_count"] = page_count;
            extra["product_has_prev"] = page_number > 1;
            extra["product_has_next"] = page_number < page_count;
            extra["product_prev_url"] = product_prev_url;
            extra["product_next_url"] = product_next_url;
            extra["published_products"] = DB.table("products").where("status", "=", "published").count();
            extra["draft_products"] = DB.table("products").where("status", "=", "draft").count();
            extra["category_options"] = cat_opts;
            extra["has_category_options"] = cat_opts.len() > 0;
            extra["brand_options"] = brand_opts;
            extra["has_brand_options"] = brand_opts.len() > 0;
        } elif name == "categories" {
            let rows = self.categories.all();
            let list = [];
            let opts = [];
            let i = 0;
            while i < rows.len() {
                list.push({
                    "id": rows[i]["id"],
                    "name": rows[i]["name"],
                    "slug": rows[i]["slug"],
                    "description": rows[i]["description"]
                });
                opts.push({"value": rows[i]["id"], "label": rows[i]["name"]});
                i += 1;
            }
            extra["category_rows"] = list;
            extra["has_category_rows"] = list.len() > 0;
            extra["category_options"] = opts;
            extra["has_category_options"] = opts.len() > 0;
        } elif name == "brands" {
            let rows = self.brands.all();
            let list = [];
            let i = 0;
            while i < rows.len() {
                list.push({
                    "id": rows[i]["id"],
                    "name": rows[i]["name"],
                    "slug": rows[i]["slug"]
                });
                i += 1;
            }
            extra["brand_rows"] = list;
            extra["has_brand_rows"] = list.len() > 0;
        } elif name == "inventory" {
            // These forms manage base-product stock; variant-level inventory is
            // intentionally not exposed until its own update routes exist.
            let rows = DB.table("inventory").whereNull("variant_id").orderBy("product_id", "ASC").get();
            let list = [];
            let total_on_hand = 0;
            let total_reserved = 0;
            let count_in = 0;
            let count_low = 0;
            let count_out = 0;
            let i = 0;
            while i < rows.len() {
                let product = DB.table("products").where("id", "=", rows[i]["product_id"]).first();
                let pname = "Product #" + string(rows[i]["product_id"]);
                let psku = "";
                let product_status = "missing";
                if product != null {
                    pname = string(product["name"]);
                    psku = string(product["sku"]);
                    product_status = string(product["status"]);
                }
                let qty = int(rows[i]["quantity"]);
                let reserved = int(rows[i]["reserved"]);
                let available = qty - reserved;
                if available < 0 {
                    available = 0;
                }
                let threshold = int(rows[i]["low_stock_threshold"]);
                let thumb = "";
                let primary = DB.table("product_images")
                    .where("product_id", "=", rows[i]["product_id"])
                    .orderBy("sort_order", "ASC")
                    .first();
                if primary != null {
                    thumb = Images.public_image_url(primary["path"]);
                }

                total_on_hand = total_on_hand + qty;
                total_reserved = total_reserved + reserved;
                let is_out = qty <= 0;
                let is_low = qty > 0 and qty <= threshold;
                let is_in = qty > threshold;
                if is_out {
                    count_out = count_out + 1;
                } elif is_low {
                    count_low = count_low + 1;
                } else {
                    count_in = count_in + 1;
                }

                list.push({
                    "product_id": rows[i]["product_id"],
                    "product_name": pname,
                    "product_sku": psku,
                    "product_url": "/admin/products/" + string(rows[i]["product_id"]),
                    "product_status": product_status,
                    "quantity": qty,
                    "available": available,
                    "reserved": reserved,
                    "low_stock_threshold": threshold,
                    "is_low_stock": qty <= threshold,
                    "is_out_of_stock": is_out,
                    "is_in_stock": is_in,
                    "thumb": thumb,
                    "has_thumb": thumb != ""
                });
                i += 1;
            }
            extra["inventory_rows"] = list;
            extra["has_inventory_rows"] = list.len() > 0;
            extra["inventory_stats"] = {
                "total_products": list.len(),
                "total_on_hand": total_on_hand,
                "total_reserved": total_reserved,
                "in_stock": count_in,
                "low_stock": count_low,
                "out_of_stock": count_out
            };
        } elif name == "customers" {
            let rows = self.admin.customers();
            let list = [];
            let i = 0;
            while i < rows.len() {
                list.push({
                    "id": rows[i]["id"],
                    "name": rows[i]["name"],
                    "email": rows[i]["email"],
                    "status": rows[i]["status"],
                    "status_options": status_options_for(string(rows[i]["status"]), ["active", "suspended"])
                });
                i += 1;
            }
            extra["customer_rows"] = list;
            extra["has_customer_rows"] = list.len() > 0;
        } elif name == "staff" {
            let rows = self.admin.staff();
            let list = [];
            let i = 0;
            while i < rows.len() {
                list.push({
                    "id": rows[i]["id"],
                    "name": rows[i]["name"],
                    "email": rows[i]["email"]
                });
                i += 1;
            }
            let roles = self.admin.roles();
            let role_opts = [];
            let ri = 0;
            while ri < roles.len() {
                role_opts.push({"value": roles[ri]["slug"], "label": roles[ri]["name"]});
                ri += 1;
            }
            extra["staff_rows"] = list;
            extra["has_staff_rows"] = list.len() > 0;
            extra["role_options"] = role_opts;
            extra["has_role_options"] = role_opts.len() > 0;
        } elif name == "roles" {
            let rows = self.admin.roles();
            let list = [];
            let i = 0;
            while i < rows.len() {
                list.push({
                    "id": rows[i]["id"],
                    "name": rows[i]["name"],
                    "slug": rows[i]["slug"],
                    "permission_count": rows[i]["permission_count"]
                });
                i += 1;
            }
            let perms = self.admin.permissions();
            let perm_opts = [];
            let pi = 0;
            while pi < perms.len() {
                perm_opts.push({"value": perms[pi]["slug"], "label": perms[pi]["name"]});
                pi += 1;
            }
            extra["role_rows"] = list;
            extra["has_role_rows"] = list.len() > 0;
            extra["permission_options"] = perm_opts;
            extra["has_permission_options"] = perm_opts.len() > 0;
        } elif name == "orders" {
            let rows = self.orders.admin_list(1, 50)["data"];
            let list = [];
            let i = 0;
            while i < rows.len() {
                list.push({
                    "id": rows[i]["id"],
                    "order_number": rows[i]["order_number"],
                    "status": rows[i]["status"],
                    "status_options": status_options_for(string(rows[i]["status"]), self.order_statuses),
                    "total_display": Money.format(int(rows[i]["total_minor"]), self.order_currency(rows[i])),
                    "placed_at": rows[i]["placed_at"]
                });
                i += 1;
            }
            extra["order_rows"] = list;
            extra["has_order_rows"] = list.len() > 0;
        }
        return extra;
    }

    public fn page(self, req, name: string) {
        if name == "payments" {
            return self.admin_payments_page(req);
        }
        let titles = {
            "products": "Products", "categories": "Categories", "brands": "Brands",
            "inventory": "Inventory", "orders": "Orders", "customers": "Customers",
            "staff": "Staff", "roles": "Roles", "coupons": "Coupons",
            "settings": "Store settings", "shipping": "Shipping configuration",
            "payments": "Payment configuration", "audit": "Audit logs"
        };
        let title = name;
        if titles.has(name) {
            title = titles[name];
        }
        let data = self.rows_for(name);
        let is_settings = name == "settings" or name == "shipping" or name == "payments";
        let is_coupons = name == "coupons";
        // Pages with a dedicated write UI render their own tables; the
        // generic read-only table is for everything else.
        let flag_products = name == "products";
        let flag_categories = name == "categories";
        let flag_brands = name == "brands";
        let flag_inventory = name == "inventory";
        let flag_customers = name == "customers";
        let flag_staff = name == "staff";
        let flag_roles = name == "roles";
        let flag_orders = name == "orders";
        let has_own_ui = flag_products or flag_categories or flag_brands
            or flag_inventory or flag_customers or flag_staff
            or flag_roles or flag_orders;
        let ctx = self.ctx(req, title, name, {
            "headers": data["headers"],
            "rows": data["rows"],
            "has_rows": data["has_rows"],
            "is_settings": is_settings,
            "is_coupons": is_coupons,
            "is_products": flag_products,
            "is_categories": flag_categories,
            "is_brands": flag_brands,
            "is_inventory": flag_inventory,
            "is_customers": flag_customers,
            "is_staff": flag_staff,
            "is_roles": flag_roles,
            "is_orders": flag_orders,
            "show_generic_table": not has_own_ui,
            "csrf": req.auth.csrf()
        });
        let extras = self.page_extras(name, req);
        for k in extras.keys() {
            ctx[k] = extras[k];
        }
        return view("admin/table", ctx);
    }

    // The full product management screen: details, gallery, variants,
    // stock and SEO fields for ONE product.
    public fn product_manage(self, req) {
        let pid = int(req.params["id"]);
        let product = DB.table("products").where("id", "=", pid).first();
        if product == null {
            throw not_found("Product not found.");
        }
        let image_service = new ImageService();
        let inventory_service = new InventoryService();
        let variants_repo = new VariantRepository();

        let gallery = image_service.gallery(pid);
        // Position labels ("Cover", "2nd", "3rd"...) + move up/down flags.
        let gallery_rows = [];
        let gi = 0;
        while gi < gallery.len() {
            let img = gallery[gi];
            let label = "Cover";
            if gi > 0 {
                let n = gi + 1;
                let suffix = "th";
                if n == 2 {
                    suffix = "nd";
                } elif n == 3 {
                    suffix = "rd";
                }
                label = string(n) + suffix;
            }
            gallery_rows.push({
                "id": img["id"],
                "url": img["url"],
                "alt_text": img["alt_text"],
                "is_primary": img["is_primary"],
                "position_label": label,
                "is_first": gi == 0,
                "is_last": gi == gallery.len() - 1
            });
            gi += 1;
        }
        let variants = variants_repo.for_product(pid);
        let stock = inventory_service.status(pid);
        let movements = inventory_service.history(pid);

        // Option lists for the forms on this screen.
        let cats = self.categories.all();
        let cat_opts = [];
        let ci = 0;
        while ci < cats.len() {
            cat_opts.push({
                "value": cats[ci]["id"],
                "label": cats[ci]["name"],
                "selected": int(cats[ci]["id"]) == int(product["category_id"])
            });
            ci += 1;
        }
        let brands = self.brands.all();
        let brand_opts = [];
        let bi = 0;
        while bi < brands.len() {
            brand_opts.push({
                "value": brands[bi]["id"],
                "label": brands[bi]["name"],
                "selected": product["brand_id"] != null and int(brands[bi]["id"]) == int(product["brand_id"])
            });
            bi += 1;
        }

        // Variants need a "selected"-style flag for their active state.
        let variant_rows = [];
        let vi = 0;
        while vi < variants.len() {
            let v = variants[vi];
            variant_rows.push({
                "id": v["id"],
                "sku": v["sku"],
                "name": v["name"],
                "price": Money.to_major(v["price_minor"]),
                "price_display": Money.format(int(v["price_minor"]), self.store_currency()),
                "attributes": v["attributes_json"],
                "is_active": int(v["is_active"]) == 1,
                "is_inactive": int(v["is_active"]) != 1
            });
            vi += 1;
        }

        let movement_rows = [];
        let mi = 0;
        while mi < movements.len() {
            movement_rows.push({
                "delta": movements[mi]["delta"],
                "reason": movements[mi]["reason"],
                "created_at": movements[mi]["created_at"]
            });
            mi += 1;
        }

        let ctx = self.ctx(req, string(product["name"]), "products", {
            "csrf": req.auth.csrf(),
            "product": product,
            "product_price": Money.to_major(minor_or_zero(product["price_minor"])),
            "product_price_display": Money.format(minor_or_zero(product["price_minor"]), self.store_currency()),
            "product_cost": Money.to_major(minor_or_zero(product["cost_minor"])),
            "product_compare_at": Money.to_major(minor_or_zero(product["compare_at_minor"])),
            "product_status_options": status_options_for(string(product["status"]), ["draft", "published", "archived"]),
            "product_is_published": string(product["status"]) == "published",
            "product_featured": int(product["is_featured"]) == 1,
            "product_not_featured": int(product["is_featured"]) != 1,
            "product_tax_percent": scaled_display(minor_or_zero(product["tax_rate_bps"]), 2),
            "product_weight_kg": scaled_display(minor_or_zero(product["weight_grams"]), 3),
            "stock_available": int(stock["quantity"]) - int(stock["reserved"]),
            "category_options": cat_opts,
            "has_category_options": cat_opts.len() > 0,
            "brand_options": brand_opts,
            "has_brand_options": brand_opts.len() > 0,
            "gallery": gallery_rows,
            "has_gallery": gallery_rows.len() > 0,
            "variants": variant_rows,
            "has_variants": variant_rows.len() > 0,
            "stock": stock,
            "movements": movement_rows,
            "has_movements": movement_rows.len() > 0
        });
        return view("admin/product", ctx);
    }


    public fn order_view(self, req) {
        let id = int(req.params["id"]);
        let order = DB.table("orders").where("id", "=", id).first();
        if order == null {
            throw not_found("Order not found.");
        }
        let items = DB.table("order_items").where("order_id", "=", id).get();
        let ord_cur = self.order_currency(order);
        let decorated = [];
        let i = 0;
        while i < items.len() {
            let it = items[i];
            decorated.push({
                "id": it["id"],
                "name": it["name_snapshot"],
                "sku": it["sku_snapshot"],
                "quantity": it["quantity"],
                "unit_display": Money.format(int(it["unit_price_minor"]), ord_cur),
                "line_display": Money.format(int(it["line_total_minor"]), ord_cur)
            });
            i += 1;
        }
        let customer = null;
        if order["user_id"] != null {
            customer = DB.table("users").where("id", "=", order["user_id"]).first();
        }
        let addr = json_parse(string(order["shipping_address_json"]));
        if type_of(addr) != "map" {
            addr = {};
        }
        let status_opts = [];
        let si = 0;
        while si < self.order_statuses.len() {
            let s = self.order_statuses[si];
            status_opts.push({"value": s, "label": s.replace("_", " "), "selected": s == string(order["status"])});
            si += 1;
        }
        let addr_name = "";
        if addr["name"] != null { addr_name = string(addr["name"]); }
        let addr_line = "";
        if addr["address_line1"] != null { addr_line = string(addr["address_line1"]); }
        let addr_city = "";
        if addr["city"] != null { addr_city = string(addr["city"]); }

        let ctx = self.ctx(req, "Order " + string(order["order_number"]), "orders", {
            "order": order,
            "items": decorated,
            "item_count": decorated.len(),
            "customer": customer,
            "has_customer": customer != null,
            "address_name": addr_name,
            "address_line": addr_line,
            "address_city": addr_city,
            "subtotal_display": Money.format(int(order["subtotal_minor"]), ord_cur),
            "discount_display": Money.format(int(order["discount_minor"]), ord_cur),
            "shipping_display": Money.format(int(order["shipping_minor"]), ord_cur),
            "tax_display": Money.format(int(order["tax_minor"]), ord_cur),
            "total_display": Money.format(int(order["total_minor"]), ord_cur),
            "status_options": status_opts,
            "csrf": req.auth.csrf()
        });
        return view("admin/order", ctx);
    }

    public fn reports(self, req) {
        let stats = self.admin.dashboard();
        let curr = self.store_currency();
        let settled = ["paid", "processing", "packed", "shipped", "delivered"];

        // 1. Settled financial metrics
        let settled_orders = DB.table("orders").whereIn("status", settled).orderBy("id", "DESC").get();
        let revenue_minor = 0;
        let subtotal_minor = 0;
        let shipping_minor = 0;
        let tax_minor = 0;
        let discount_minor = 0;
        let si = 0;
        while si < settled_orders.len() {
            let so = settled_orders[si];
            revenue_minor += int(so["total_minor"]);
            subtotal_minor += int(so["subtotal_minor"]);
            shipping_minor += int(so["shipping_minor"]);
            tax_minor += int(so["tax_minor"]);
            discount_minor += int(so["discount_minor"]);
            si += 1;
        }

        let settled_count = settled_orders.len();
        let all_count = int(stats["orders"]);
        let aov_minor = 0;
        if settled_count > 0 {
            aov_minor = revenue_minor / settled_count;
        }

        let settled_rate = 0;
        if all_count > 0 {
            settled_rate = (settled_count * 100) / all_count;
        }

        // 2. Recent settled transactions
        let recent_settled = [];
        let ri = 0;
        let r_max = 8;
        if settled_orders.len() < r_max {
            r_max = settled_orders.len();
        }
        while ri < r_max {
            let row = settled_orders[ri];
            let c_name = "Guest Customer";
            if row["user_id"] != null {
                let u = DB.table("users").where("id", "=", row["user_id"]).first();
                if u != null {
                    c_name = string(u["name"]);
                }
            } else {
                let addr_raw = row["shipping_address_json"];
                if addr_raw != null and string(addr_raw) != "" and string(addr_raw) != "{}" {
                    c_name = "Guest Checkout";
                }
            }
            let item_cnt = DB.table("order_items").where("order_id", "=", row["id"]).count();
            let date_str = string(row["placed_at"]);
            if date_str == "" or date_str == "null" {
                date_str = string(row["created_at"]);
            }
            recent_settled.push({
                "id": row["id"],
                "order_number": row["order_number"],
                "customer_name": c_name,
                "status": row["status"],
                "status_label": string(row["status"]).replace("_", " "),
                "items_count": item_cnt,
                "total_display": Money.format(int(row["total_minor"]), self.order_currency(row)),
                "date_display": date_str
            });
            ri += 1;
        }

        // 3. Top products by sales
        let top_products = [];
        let item_rows = DB.table("order_items").get();
        let grouped_items = {};
        let ii = 0;
        while ii < item_rows.len() {
            let item = item_rows[ii];
            let pid = int(item["product_id"]);
            let key = "p_" + string(pid);
            if not grouped_items.has(key) {
                grouped_items[key] = {
                    "product_id": pid,
                    "name": string(item["name_snapshot"]),
                    "sku": string(item["sku_snapshot"]),
                    "quantity": 0,
                    "sales_minor": 0
                };
            }
            let cur = grouped_items[key];
            cur["quantity"] = cur["quantity"] + int(item["quantity"]);
            cur["sales_minor"] = cur["sales_minor"] + int(item["line_total_minor"]);
            grouped_items[key] = cur;
            ii += 1;
        }

        let g_keys = grouped_items.keys();
        let gi = 0;
        while gi < g_keys.len() {
            let itm = grouped_items[g_keys[gi]];
            top_products.push({
                "product_id": itm["product_id"],
                "name": itm["name"],
                "sku": itm["sku"],
                "quantity": itm["quantity"],
                "sales_display": Money.format(int(itm["sales_minor"]), curr)
            });
            gi += 1;
        }

        // 4. Payment method counts
        let payment_rows = DB.table("payments").get();
        let payment_summary = [];
        let p_methods = {};
        let pi = 0;
        while pi < payment_rows.len() {
            let p = payment_rows[pi];
            let prov = string(p["provider"]);
            if prov == "" { prov = "other"; }
            if not p_methods.has(prov) {
                p_methods[prov] = {"provider": prov, "count": 0, "amount_minor": 0};
            }
            let cur_p = p_methods[prov];
            cur_p["count"] = cur_p["count"] + 1;
            cur_p["amount_minor"] = cur_p["amount_minor"] + int(p["amount_minor"]);
            p_methods[prov] = cur_p;
            pi += 1;
        }
        let pm_keys = p_methods.keys();
        let pmi = 0;
        while pmi < pm_keys.len() {
            let pm = p_methods[pm_keys[pmi]];
            payment_summary.push({
                "provider": pm["provider"],
                "provider_title": string(pm["provider"]).toUpperCase(),
                "count": pm["count"],
                "amount_display": Money.format(int(pm["amount_minor"]), curr)
            });
            pmi += 1;
        }

        let active_pipeline_count = int(stats["pipeline_processing"]) + int(stats["pipeline_shipped"]);

        return view("admin/reports", self.ctx(req, "Reports", "reports", {
            "revenue_display": Money.format(revenue_minor, curr),
            "subtotal_display": Money.format(subtotal_minor, curr),
            "shipping_display": Money.format(shipping_minor, curr),
            "tax_display": Money.format(tax_minor, curr),
            "discount_display": Money.format(discount_minor, curr),
            "aov_display": Money.format(aov_minor, curr),
            "order_count": all_count,
            "settled_count": settled_count,
            "settled_rows": settled_count,
            "settled_rate": settled_rate,
            "active_pipeline_count": active_pipeline_count,
            "pipeline_delivered": stats["pipeline_delivered"],
            "pipeline_shipped": stats["pipeline_shipped"],
            "pipeline_processing": stats["pipeline_processing"],
            "pipeline_pending": stats["pipeline_pending"],
            "pipeline_cancelled": stats["pipeline_cancelled"],
            "pct_delivered": stats["pct_delivered"],
            "pct_shipped": stats["pct_shipped"],
            "pct_processing": stats["pct_processing"],
            "pct_pending": stats["pct_pending"],
            "has_recent_settled": recent_settled.len() > 0,
            "recent_settled": recent_settled,
            "has_top_products": top_products.len() > 0,
            "top_products": top_products,
            "has_payment_summary": payment_summary.len() > 0,
            "payment_summary": payment_summary,
            "csrf": req.auth.csrf()
        }));
    }

    public fn export(self, req) {
        let format = string(req.query("format", "csv"));
        if format == "json" {
            return json({"data": self.admin.report_rows()});
        }
        let res = response(self.admin.csv_export(), 200);
        res.header("content-type", "text/csv; charset=utf-8");
        res.header("content-disposition", "attachment; filename=\"spid3r-sales-report.csv\"");
        return res;
    }

    // ---- management APIs ----
    public fn api_customers(self, req) {
        return json(resource_collection(self.admin.customers(string(req.input("q", ""))), identity));
    }

    public fn api_customer_status(self, req) {
        let status = string(req.input("status", ""));
        let ok = self.admin.set_customer_status(req.params["id"], status);
        self.audit(req, "customer.status", "users", req.params["id"], {"status": status});
        return json({"data": {"updated": ok, "status": status}});
    }

    public fn api_staff(self, req) {
        return json(resource_collection(self.admin.staff(string(req.input("q", ""))), identity));
    }

    // Assign a staff role. Accepts `user_id` (numeric) or `email` so the
    // admin SPA can promote a shopper by email address.
    public fn api_assign_role(self, req) {
        let slug = string(req.input("role", ""));
        let user_id = req.input("user_id", null);
        if user_id == null or string(user_id) == "" {
            let email = string(req.input("email", "")).trim().lower();
            if email == "" {
                throw validation_failed({"email": "Provide a user ID or an email address."});
            }
            let user = DB.table("users").where("email", "=", email).first();
            if user == null {
                throw not_found("No account found for " + email + ".");
            }
            user_id = user["id"];
        }
        let ok = self.admin.assign_role(user_id, slug);
        self.audit(req, "staff.role", "users", user_id, {"role": slug});
        return json({"data": {"assigned": ok, "user_id": user_id, "role": slug}});
    }

    public fn api_remove_role(self, req) {
        let slug = string(req.input("role", ""));
        let ok = self.admin.remove_role(req.input("user_id", null), slug);
        self.audit(req, "staff.role.remove", "users", req.input("user_id", ""), {"role": slug});
        return json({"data": {"removed": ok}});
    }

    public fn api_roles(self, req) {
        return json({"data": {"roles": self.admin.roles(), "permissions": self.admin.permissions()}});
    }

    public fn api_toggle_permission(self, req) {
        // Form bodies carry strings — "1" == 1 is false in Spid3r. Parse the
        // flag from its string form so granting actually works.
        let raw = string(req.input("enabled", "0")).trim().lower();
        let enabled = raw == "1" or raw == "true";
        let ok = self.admin.toggle_permission(req.params["id"], string(req.input("permission", "")), enabled);
        self.audit(req, "role.permission", "roles", req.params["id"], {"permission": req.input("permission", ""), "enabled": enabled});
        return json({"data": {"updated": ok}});
    }

    public fn api_coupons(self, req) {
        return json(resource_collection(self.admin.coupons(string(req.input("q", ""))), identity));
    }

    public fn api_coupon_save(self, req) {
        let row = self.admin.save_coupon(req.data, null);
        self.audit(req, "coupon.create", "coupons", row["id"], {"code": row["code"]});
        if req.input("format", "") != "json" {
            return redirect("/admin/coupons");
        }
        return json(resource_item(row, identity), 201);
    }

    public fn api_coupon_update(self, req) {
        let row = self.admin.save_coupon(req.data, req.params["id"]);
        self.audit(req, "coupon.update", "coupons", row["id"], {"code": row["code"]});
        return json(resource_item(row, identity));
    }

    public fn api_coupon_delete(self, req) {
        self.admin.delete_coupon(req.params["id"]);
        self.audit(req, "coupon.delete", "coupons", req.params["id"], {});
        return json({"data": {"deleted": true}});
    }

    // Activate / deactivate toggle for the admin SPA. Deactivation is the
    // only safe option for coupons that already have usages.
    // NOTE: form bodies carry strings — "1" == 1 is false in Spid3r, so the
    // flag is parsed from its string form, never compared to an int.
    public fn api_coupon_toggle(self, req) {
        let raw = string(req.input("active", "0")).trim().lower();
        let active = raw == "1" or raw == "true";
        let ok = self.admin.set_coupon_active(req.params["id"], active);
        self.audit(req, "coupon.toggle", "coupons", req.params["id"], {"active": active});
        return json({"data": {"updated": ok, "is_active": active}});
    }

    public fn api_settings(self, req) {
        return json(resource_collection(self.admin.settings(string(req.input("group", ""))), identity));
    }

    public fn api_setting_update(self, req) {
        let key = string(req.input("setting_key", ""));
        let value = string(req.input("value", ""));
        let group = string(req.input("group", "general"));
        let ok = self.admin.update_setting(key, value, group);
        if key == "store.name" and value != "" {
            self.settings["name"] = value;
        }
        if key == "store.currency" and value != "" {
            self.settings["currency"] = value.trim().upper();
        }
        if key == "store.locale" and value != "" {
            self.settings["locale"] = value.trim();
        }
        self.audit(req, "settings.update", "settings", key, {"value": value});
        if req.input("format", "") != "json" {
            return redirect("/admin/settings");
        }
        return json({"data": {"updated": ok, "setting_key": key}});
    }

