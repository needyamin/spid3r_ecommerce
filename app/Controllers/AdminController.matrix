    public fn api_inventory_list(self, req) {
        let q = string(req.input("q", "")).trim();
        let low = string(req.input("low", "")).trim();
        let stock_status = string(req.input("stock_status", "")).trim();
        let sort = string(req.input("sort", "default")).trim();
        let pid_map = {};
        if q != "" {
            let matched = DB.table("products").where("name", "LIKE", "%" + q + "%").orWhere("sku", "LIKE", "%" + q + "%").get();
            let mi = 0;
            while mi < matched.len() {
                pid_map[string(matched[mi]["id"])] = true;
                mi += 1;
            }
        }
        let rows = DB.table("inventory").whereNull("variant_id").orderBy("product_id", "ASC").get();
        let all_rows = [];
        let total_on_hand = 0;
        let total_reserved = 0;
        let count_in = 0;
        let count_low = 0;
        let count_out = 0;
        let i = 0;
        while i < rows.len() {
            let inv = rows[i];
            let pid = int(inv["product_id"]);
            let product = DB.table("products").where("id", "=", pid).first();
            let pname = "Product #" + string(pid);
            let psku = "";
            let pslug = "";
            let pstatus = "missing";
            let price_display = "";
            if product != null {
                pname = string(product["name"]);
                psku = string(product["sku"]);
                pslug = string(product["slug"]);
                pstatus = string(product["status"]);
                price_display = Money.format(int(product["price_minor"]), self.store_currency());
            }
            let qty = int(inv["quantity"]);
            let reserved = int(inv["reserved"]);
            let threshold = int(inv["low_stock_threshold"]);
            let available = qty - reserved;
            if available < 0 {
                available = 0;
            }
            let is_out = qty <= 0;
            let is_low = qty > 0 and qty <= threshold;
            let is_in = qty > threshold;

            total_on_hand = total_on_hand + qty;
            total_reserved = total_reserved + reserved;
            if is_out {
                count_out = count_out + 1;
            } elif is_low {
                count_low = count_low + 1;
            } else {
                count_in = count_in + 1;
            }

            if q != "" and not pid_map.has(string(pid)) {
                i += 1;
                continue;
            }
            if (low == "1" or stock_status == "low") and not is_low {
                i += 1;
                continue;
            }
            if stock_status == "in" and not is_in {
                i += 1;
                continue;
            }
            if stock_status == "out" and not is_out {
                i += 1;
                continue;
            }

            let thumb = "";
            let primary = DB.table("product_images").where("product_id", "=", pid).orderBy("sort_order", "ASC").first();
            if primary != null {
                thumb = Images.public_image_url(primary["path"]);
            }
            all_rows.push({
                "product_id": pid,
                "product_name": pname,
                "sku": psku,
                "slug": pslug,
                "product_status": pstatus,
                "quantity": qty,
                "available": available,
                "reserved": reserved,
                "low_stock_threshold": threshold,
                "is_low_stock": qty <= threshold,
                "is_out_of_stock": is_out,
                "is_in_stock": is_in,
                "thumb": thumb,
                "has_thumb": thumb != "",
                "price_display": price_display
            });
            i += 1;
        }

        if sort == "stock_asc" {
            let si = 0;
            while si < all_rows.len() {
                let sj = si + 1;
                while sj < all_rows.len() {
                    if int(all_rows[sj]["quantity"]) < int(all_rows[si]["quantity"]) {
                        let tmp = all_rows[si];
                        all_rows[si] = all_rows[sj];
                        all_rows[sj] = tmp;
                    }
                    sj += 1;
                }
                si += 1;
            }
        } elif sort == "stock_desc" {
            let si = 0;
            while si < all_rows.len() {
                let sj = si + 1;
                while sj < all_rows.len() {
                    if int(all_rows[sj]["quantity"]) > int(all_rows[si]["quantity"]) {
                        let tmp = all_rows[si];
                        all_rows[si] = all_rows[sj];
                        all_rows[sj] = tmp;
                    }
                    sj += 1;
                }
                si += 1;
            }
        }

        let per_page = 15;
        let page = int(req.input("page", 1));
        if page < 1 {
            page = 1;
        }
        let total = all_rows.len();
        let start = (page - 1) * per_page;
        let sliced = [];
        let k = start;
        while k < total and k < start + per_page {
            sliced.push(all_rows[k]);
            k += 1;
        }
        let last_page = 1;
        if total > 0 {
            last_page = (total + per_page - 1) / per_page;
        }
        return json({"data": sliced, "meta": {
            "count": sliced.len(),
            "total": total,
            "page": page,
            "per_page": per_page,
            "last_page": last_page,
            "has_more": page < last_page,
            "stats": {
                "total_products": rows.len(),
                "total_on_hand": total_on_hand,
                "total_reserved": total_reserved,
                "in_stock": count_in,
                "low_stock": count_low,
                "out_of_stock": count_out
            }
        }});
    }

    public fn api_orders_list(self, req) {
        let page = int(req.input("page", 1));
        if page < 1 {
            page = 1;
        }
        let per_page = 12;
        let q = string(req.input("q", "")).trim();
        let status = string(req.input("status", "")).trim();
        let query = DB.table("orders");
        if q != "" {
            query.where("order_number", "LIKE", "%" + q + "%");
        }
        if status != "" {
            query.where("status", "=", status);
        }
        let page_result = query.orderBy("id", "DESC").paginate(page, per_page);
        let rows = page_result["data"];
        let data = [];
        let i = 0;
        while i < rows.len() {
            let o = rows[i];
            let customer_name = "Guest";
            if o["user_id"] != null {
                let u = DB.table("users").where("id", "=", o["user_id"]).first();
                if u != null {
                    customer_name = string(u["name"]);
                }
            }
            let items_count = DB.table("order_items").where("order_id", "=", o["id"]).count();
            data.push({
                "id": o["id"],
                "order_number": o["order_number"],
                "status": o["status"],
                "status_label": string(o["status"]).replace("_", " "),
                "total_minor": int(o["total_minor"]),
                "total_display": Money.format(int(o["total_minor"]), self.order_currency(o)),
                "currency": o["currency"],
                "placed_at": o["placed_at"],
                "customer_name": customer_name,
                "item_count": items_count
            });
            i += 1;
        }
        return json({"data": data, "meta": {
            "count": data.len(),
            "total": int(page_result["total"]),
            "page": int(page_result["page"]),
            "per_page": int(page_result["per_page"]),
            "last_page": int(page_result["last_page"]),
            "has_more": page_result["has_more"]
        }});
    }

    public fn api_order_show(self, req) {
        let id = int(req.params["id"]);
        let order = DB.table("orders").where("id", "=", id).first();
        if order == null {
            throw not_found("Order not found.");
        }
        let ord_cur = self.order_currency(order);
        let items = DB.table("order_items").where("order_id", "=", id).get();
        let decorated = [];
        let i = 0;
        while i < items.len() {
            let it = items[i];
            decorated.push({
                "id": it["id"],
                "product_id": it["product_id"],
                "name": it["name_snapshot"],
                "sku": it["sku_snapshot"],
                "quantity": it["quantity"],
                "unit_display": Money.format(int(it["unit_price_minor"]), ord_cur),
                "line_display": Money.format(int(it["line_total_minor"]), ord_cur)
            });
            i += 1;
        }
        let customer = null;
        if order["user_id"] != null {
            customer = DB.table("users").where("id", "=", order["user_id"]).first();
        }
        let addr = json_parse(string(order["shipping_address_json"]));
        if type_of(addr) != "map" {
            addr = {};
        }
        return json({"data": {
            "order": order,
            "items": decorated,
            "customer": customer,
            "address": addr,
            "currency": ord_cur,
            "subtotal_display": Money.format(int(order["subtotal_minor"]), ord_cur),
            "discount_display": Money.format(int(order["discount_minor"]), ord_cur),
            "shipping_display": Money.format(int(order["shipping_minor"]), ord_cur),
            "tax_display": Money.format(int(order["tax_minor"]), ord_cur),
            "total_display": Money.format(int(order["total_minor"]), ord_cur),
            "status_label": string(order["status"]).replace("_", " "),
            "statuses": self.order_statuses
        }});
    }

    public fn api_order_status(self, req) {
        let id = int(req.params["id"]);
        let status = string(req.input("status", "")).trim();
        let valid = false;
        let all = self.order_statuses;
        let i = 0;
        while i < all.len() {
            if all[i] == status {
                valid = true;
            }
            i += 1;
        }
        if not valid {
            throw validation_failed({"status": "Invalid order status."});
        }
        let order = DB.table("orders").where("id", "=", id).first();
        if order == null {
            throw not_found("Order not found.");
        }
        let ok = DB.table("orders").where("id", "=", id).update({"status": status}) > 0;
        return json({"data": {
            "updated": ok,
            "status": status,
            "status_label": status.replace("_", " ")
        }});
    }

    public fn api_product_full(self, req) {
        let pid = int(req.params["id"]);
        let product = DB.table("products").where("id", "=", pid).first();
        if product == null {
            throw not_found("Product not found.");
        }
        let inv_row = DB.table("inventory").where("product_id", "=", pid).whereNull("variant_id").first();
        let inv;
        if inv_row == null {
            inv = {"quantity": 0, "reserved": 0, "low_stock_threshold": 0, "low_stock": false};
        } else {
            inv = {
                "quantity": int(inv_row["quantity"]),
                "reserved": int(inv_row["reserved"]),
                "low_stock_threshold": int(inv_row["low_stock_threshold"]),
                "low_stock": int(inv_row["quantity"]) <= int(inv_row["low_stock_threshold"])
            };
        }
        let imgs = DB.table("product_images").where("product_id", "=", pid).orderBy("sort_order", "ASC").get();
        let gallery = [];
        let gi = 0;
        while gi < imgs.len() {
            let img = imgs[gi];
            gallery.push({
                "id": img["id"],
                "url": Images.public_image_url(img["path"]),
                "alt_text": img["alt_text"],
                "is_primary": int(img["is_primary"]) == 1
            });
            gi += 1;
        }
        let variants = DB.table("product_variants").where("product_id", "=", pid).orderBy("id", "ASC").get();
        let variant_rows = [];
        let vi = 0;
        while vi < variants.len() {
            let v = variants[vi];
            variant_rows.push({
                "id": v["id"],
                "sku": v["sku"],
                "name": v["name"],
                "price_minor": int(v["price_minor"]),
                "price_display": Money.format(int(v["price_minor"]), self.store_currency()),
                "is_active": int(v["is_active"]) == 1
            });
            vi += 1;
        }
        let cats = DB.table("categories").orderBy("name", "ASC").get();
        let cat_opts = [];
        let ci = 0;
        while ci < cats.len() {
            cat_opts.push({"id": cats[ci]["id"], "name": cats[ci]["name"]});
            ci += 1;
        }
        let brands = DB.table("brands").orderBy("name", "ASC").get();
        let brand_opts = [];
        let bi = 0;
        while bi < brands.len() {
            brand_opts.push({"id": brands[bi]["id"], "name": brands[bi]["name"]});
            bi += 1;
        }
        let decorated = self.decorate_product(product);
        return json({"data": {
            "product": decorated,
            "inventory": inv,
            "images": gallery,
            "variants": variant_rows,
            "categories": cat_opts,
            "brands": brand_opts
        }});
    }

    public fn category_delete_form(self, req) {
        let id = int(req.params["id"]);
        let cat = DB.table("categories").where("id", "=", id).first();
        if cat == null {
            throw not_found("Category not found.");
        }

        let reassign_to = req.input("reassign_to", null);
        if reassign_to != null and string(reassign_to).trim() != "" {
            let target_id = int(reassign_to);
            if target_id == id {
                throw validation_failed({"category": "Cannot reassign products to the category being deleted."});
            }
            let target = DB.table("categories").where("id", "=", target_id).first();
            if target == null {
                throw validation_failed({"category": "Target category does not exist."});
            }
            DB.table("products").where("category_id", "=", id).update({"category_id": target_id});
            DB.table("categories").where("parent_id", "=", id).update({"parent_id": target_id});
        }

        let prod_count = DB.table("products").where("category_id", "=", id).count();
        if prod_count > 0 {
            throw validation_failed({"category": "Category has " + string(prod_count) + " product(s) assigned. Reassign them to another category before deleting."});
        }

        let child_count = DB.table("categories").where("parent_id", "=", id).count();
        if child_count > 0 {
            DB.table("categories").where("parent_id", "=", id).update({"parent_id": cat["parent_id"]});
        }

        self.categories.delete(id);
        CatalogCache.bump_catalog_version();
        self.audit(req, "category.delete", "categories", id, {"name": cat["name"]});
        if req.input("format", "") != "json" {
            return redirect("/admin/categories");
        }
        return json({"data": {"deleted": true, "id": id}});
    }

    public fn brand_delete_form(self, req) {
        let id = int(req.params["id"]);
        let br = DB.table("brands").where("id", "=", id).first();
        if br == null {
            throw not_found("Brand not found.");
        }
        self.brands.delete(id);
        CatalogCache.bump_catalog_version();
        self.audit(req, "brand.delete", "brands", id, {"name": br["name"]});
        if req.input("format", "") != "json" {
            return redirect("/admin/brands");
        }
        return json({"data": {"deleted": true, "id": id}});
    }

    public fn api_customers_list(self, req) {
        let page = int(req.input("page", 1));
        if page < 1 {
            page = 1;
        }
        let per_page = 15;
        let q = string(req.input("q", "")).trim();
        let query = DB.table("users").orderBy("id", "DESC");
        if q != "" {
            query.whereGroup("AND", fn(group) {
                group.where("name", "LIKE", "%" + q + "%").orWhere("email", "LIKE", "%" + q + "%");
            });
        }
        let page_result = query.paginate(page, per_page);
        let rows = page_result["data"];
        let data = [];
        let i = 0;
        while i < rows.len() {
            let u = rows[i];
            data.push({
                "id": u["id"],
                "name": u["name"],
                "email": u["email"],
                "status": string(u["status"]),
                "created_at": u["created_at"]
            });
            i += 1;
        }
        return json({"data": data, "meta": {
            "count": data.len(),
            "total": int(page_result["total"]),
            "page": int(page_result["page"]),
            "per_page": int(page_result["per_page"]),
            "last_page": int(page_result["last_page"]),
            "has_more": page_result["has_more"]
        }});
    }
}
