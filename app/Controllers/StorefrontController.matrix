// app/Controllers/StorefrontController.matrix
// Phase 5 — public storefront HTTP layer (thin).
// Phase 10 — display currency, language, reviews, recommendations,
//            recently viewed and the wishlist toggle.

import "framework/Response";
import "framework/View/BD";
import "framework/Container/Container";
import "framework/Database/DB";
import "framework/HttpException";
import "app/Services/StorefrontService";
import "app/Services/AdvancedStoreService";
import "app/Services/CurrencyService";
import "app/Repositories/CatalogRepository";
import "app/Support/CartIdentity" as CartIdentity;
import "app/Support/StoreChrome" as StoreChrome;

public class StorefrontController {
    public let service;
    public let settings;
    public let categories;
    public let brands;
    public let advanced;
    public let currencies;

    fn new() {
        self.service = new StorefrontService();
        self.settings = Container.make("store.settings");
        self.categories = new CategoryRepository();
        self.brands = new BrandRepository();
        self.advanced = new AdvancedStoreService();
        self.currencies = new CurrencyService(string(self.settings["currency"]));
    }

    // The customer's display currency and the conversion context.
    fn display_currency(self, req) -> string {
        return self.currencies.selected(req);
    }

    fn fx_context(self) {
        return self.currencies.context();
    }

    // Storefront chrome shared by every public page.
    fn chrome(self, req) {
        return StoreChrome.build(req, self.settings);
    }

    fn render(self, req, view_name: string, title: string, extra) {
        let code = self.display_currency(req);
        let ctx = {
            "store_name": self.settings["name"],
            "currency": code,
            "title": title,
            "meta_description": title + " — " + self.settings["name"],
            "current_path": string(req.path),
            "csrf": ""
        };
        if req.auth != null and req.auth.check() {
            ctx["csrf"] = req.auth.csrf();
        }
        let chrome = self.chrome(req);
        for k in chrome.keys() {
            ctx[k] = chrome[k];
        }
        if extra != null {
            for k2 in extra.keys() {
                ctx[k2] = extra[k2];
            }
        }
        return view(view_name, ctx);
    }

    public fn home(self, req) {
        let code = self.display_currency(req);
        let featured = self.service.featured(code, 8, self.fx_context());
        let ctx = {
            "products": featured,
            "has_products": featured.len() > 0,
            "meta_description": "Shop " + self.settings["name"] + " — quality products, honest prices, fast delivery."
        };
        return self.render(req, "store/home", self.settings["name"], ctx);
    }

    // The currently filtered category slug, so the filter bar preselects it.
    fn requested_category(self, req) -> string {
        if req != null and req.query_params.has("category") {
            return string(req.query_params["category"]).trim();
        }
        return "";
    }

    fn requested_brand(self, req) -> string {
        if req != null and req.query_params.has("brand") {
            return string(req.query_params["brand"]).trim();
        }
        return "";
    }

    fn brand_options(self, selected_slug: string) {
        let rows = self.brands.all();
        let out = [];
        let i = 0;
        while i < rows.len() {
            let slug = string(rows[i]["slug"]);
            out.push({
                "slug": slug,
                "name": string(rows[i]["name"]),
                "selected": slug == selected_slug
            });
            i += 1;
        }
        return out;
    }

    public fn catalog(self, req) {
        let code = self.display_currency(req);
        let ctx = self.service.catalog_context(req.query_params, "/catalog", code, self.fx_context());
        ctx["heading"] = "All products";
        ctx["description"] = "";
        ctx["meta_description"] = "Browse all products at " + self.settings["name"] + " — filter by category, brand and price.";
        ctx["form_action"] = "/catalog";
        ctx["category_options"] = self.category_options(self.requested_category(req));
        ctx["has_category_links"] = ctx["category_options"].len() > 0;
        ctx["brand_options"] = self.brand_options(self.requested_brand(req));
        ctx["has_brand_options"] = ctx["brand_options"].len() > 0;
        return self.render(req, "store/catalog", "Catalog", ctx);
    }

    public fn search(self, req) {
        let code = self.display_currency(req);
        let ctx = self.service.catalog_context(req.query_params, "/search", code, self.fx_context());
        let q = "";
        if req.query_params.has("q") {
            q = string(req.query_params["q"]).trim();
        }
        if q != "" {
            ctx["heading"] = "Search results";
            ctx["description"] = "Products matching \"" + q + "\".";
        } else {
            ctx["heading"] = "Search products";
            ctx["description"] = "Find products by name or keyword.";
        }
        ctx["meta_description"] = "Search products at " + self.settings["name"] + " — find exactly what you need.";
        ctx["form_action"] = "/search";
        ctx["category_options"] = self.category_options(self.requested_category(req));
        ctx["has_category_links"] = ctx["category_options"].len() > 0;
        ctx["brand_options"] = self.brand_options(self.requested_brand(req));
        ctx["has_brand_options"] = ctx["brand_options"].len() > 0;
        return self.render(req, "store/catalog", "Search", ctx);
    }

    // Flat slug/name list for the catalog filter bar and browse chips.
    // `selected_slug` is precomputed into a boolean because BD @if is
    // truthiness-only and cannot compare values in templates.
    fn category_options(self, selected_slug: string) {
        let rows = self.categories.all();
        let out = [];
        let i = 0;
        while i < rows.len() {
            let slug = string(rows[i]["slug"]);
            out.push({
                "slug": slug,
                "name": string(rows[i]["name"]),
                "selected": slug == selected_slug
            });
            i += 1;
        }
        return out;
    }

    public fn category(self, req) {
        let slug = string(req.params["slug"]);
        let cat = self.categories.find_by_slug(slug);
        if cat == null {
            throw not_found("Category not found.");
        }
        let params = {"category": slug, "path": req.path};
        for k in req.query_params.keys() {
            if k != "category" {
                params[k] = req.query_params[k];
            }
        }
        let code = self.display_currency(req);
        let ctx = self.service.catalog_context(params, "/category/" + slug, code, self.fx_context());
        ctx["heading"] = string(cat["name"]);
        ctx["description"] = string(cat["description"]);
        ctx["meta_description"] = string(cat["meta_description"]);
        ctx["form_action"] = "/catalog";
        ctx["category_options"] = self.category_options(slug);
        ctx["has_category_links"] = ctx["category_options"].len() > 0;
        ctx["brand_options"] = self.brand_options(self.requested_brand(req));
        ctx["has_brand_options"] = ctx["brand_options"].len() > 0;
        return self.render(req, "store/catalog", string(cat["name"]), ctx);
    }

    public fn brand(self, req) {
        let slug = string(req.params["slug"]);
        let brand = DB.table("brands").where("slug", "=", slug).first();
        if brand == null {
            throw not_found("Brand not found.");
        }
        let params = {"brand": slug};
        for k in req.query_params.keys() {
            if k != "brand" {
                params[k] = req.query_params[k];
            }
        }
        let code = self.display_currency(req);
        let ctx = self.service.catalog_context(params, "/brand/" + slug, code, self.fx_context());
        ctx["heading"] = string(brand["name"]);
        ctx["form_action"] = "/catalog";
        ctx["category_options"] = self.category_options(self.requested_category(req));
        ctx["has_category_links"] = ctx["category_options"].len() > 0;
        ctx["brand_options"] = self.brand_options(slug);
        ctx["has_brand_options"] = ctx["brand_options"].len() > 0;
        ctx["meta_description"] = "Shop " + string(brand["name"]) + " products at " + self.settings["name"] + ".";
        return self.render(req, "store/catalog", string(brand["name"]), ctx);
    }

    public fn product(self, req) {
        let code = self.display_currency(req);
        let fx = self.fx_context();
        let ctx = self.service.product_context(string(req.params["slug"]), code, fx);
        let title = string(ctx["product"]["name"]);
        if ctx["meta_description"] == "" {
            ctx["meta_description"] = title + " — available at " + self.settings["name"] + ".";
        }
        let product_id = int(ctx["product"]["id"]);

        // Phase 10 — reviews & ratings.
        let reviews = self.advanced.approved_reviews(product_id);
        ctx["reviews"] = reviews;
        ctx["has_reviews"] = reviews.len() > 0;
        ctx["rating"] = self.advanced.rating_summary(product_id);

        // Phase 10 — recommendations from the same category.
        let recommendations = self.service.decorate(self.advanced.recommendations(product_id, 4), code, fx);
        ctx["recommendations"] = recommendations;
        ctx["has_recommendations"] = recommendations.len() > 0;

        // Phase 10 — recently viewed (tracked server-side, no JavaScript).
        let rv_key = CartIdentity.cookie_value(req, "rv");
        if rv_key == "" {
            rv_key = "rv-" + hex_encode(random_bytes(16).unwrap());
        }
        self.advanced.track_view(rv_key, product_id);
        let seen = self.advanced.recently_viewed(rv_key);
        let others = [];
        let i = 0;
        while i < seen.len() {
            if int(seen[i]["id"]) != product_id {
                others.push(seen[i]);
            }
            i += 1;
        }
        let recent = self.service.decorate(others, code, fx);
        ctx["recently_viewed"] = recent;
        ctx["has_recently_viewed"] = recent.len() > 0;

        // Phase 10 — wishlist toggle state.
        let uid = null;
        if req.auth != null and req.auth.check() {
            uid = req.auth.id();
        }
        ctx["in_wishlist"] = self.advanced.in_wishlist(uid, product_id);
        ctx["signed_in"] = uid != null;

        let res = self.render(req, "store/product", title, ctx);
        res.cookie("rv", rv_key, "/", 2592000);
        return res;
    }

    public fn sitemap(self, req) {
        let res = response(self.service.sitemap_xml(), 200);
        res.header("content-type", "application/xml; charset=utf-8");
        return res;
    }

    public fn robots(self, req) {
        let res = response(self.service.robots_txt(), 200);
        res.header("content-type", "text/plain; charset=utf-8");
        return res;
    }
}
