// app/Controllers/ImageController.matrix
// Runtime-generated product artwork. Products without an uploaded image get
// an initials SVG (first letters/digits of the name, palette picked
// deterministically from the name) in the same visual style as the seeded
// public/images/products/*.svg art — so catalog grids, carts and admin
// tables never render a bare "No image" box.
//
// Pure function of the query string: no DB, no session, so responses are
// safely cacheable by browsers and proxies.

import "framework/Http/Response";
import "app/Support/Images" as Images;

public class ImageController {
    public fn new () {
        let _ = self;
    }

    // GET /images/initials.svg?n=<base64url product name>
    public fn initials(self, req) {
        let name = Images.b64url_decode(string(req.query("n", "")).trim());
        if string(name).trim() == "" {
            name = "Product";
        }
        let initials = Images.image_initials(name);
        if initials == "" {
            initials = "?";
        }

        // Deterministic palette from the name — same product always gets the
        // same colours (stable across nodes/redeploys).
        let palettes = [
        {
            "bg": "#ecfdf5", "fg": "#047857"
        }
        ,
        {
            "bg": "#fdf4ff", "fg": "#a21caf"
        }
        ,
        {
            "bg": "#eef4ff", "fg": "#1d4ed8"
        }
        ,
        {
            "bg": "#fffbeb", "fg": "#b45309"
        }
        ,
        {
            "bg": "#fff1e8", "fg": "#c2410c"
        }
        ,
        {
            "bg": "#f1f5f9", "fg": "#475569"
        }
        ];
        let pal = palettes[self.palette_index(name, palettes.len())];
        let bg = string(pal["bg"]);
        let fg = string(pal["fg"]);

        let label = Images.escape_xml_text(string(name).trim());
        if label.len() > 34 {
            label = label.slice(0, 34) + "...";
        }

        let svg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 400'>\n"
        + "  <rect width='400' height='400' rx='24' fill='{bg}'/>\n"
        +"  <circle cx='200' cy='168' r='86' fill='none' stroke='{fg}' stroke-width='10' opacity='0.25'/>\n"
        +"  <text x='200' y='205' font-family='system-ui, -apple-system, Segoe UI, Arial, sans-serif' font-size='96' font-weight='700' fill='{fg}' text-anchor='middle' opacity='0.85'>{initials}</text>\n"
        +"  <text x='200' y='330' font-family='system-ui, -apple-system, Segoe UI, Arial, sans-serif' font-size='22' font-weight='600' fill='{fg}' text-anchor='middle' opacity='0.75'>{label}</text>\n"
        +"</svg>";

        let res = response(svg, 200);
        res.header("content-type", "image/svg+xml");
        res.header("cache-control", "public, max-age=604800");
        return res;
    }

    // Stable palette bucket from the SHA-256 of the name.
    fn palette_index(self, name: string, count: int) -> int {
        let _ = self;
        let hex_chars = "0123456789abcdef";
        let first = string(sha256(name)).slice(0, 1).lower();
        let pos = 0;
        let i = 0;
        while i < hex_chars.len() {
            if hex_chars.slice(i, i + 1) == first {
                pos = i;
                break;
            }
            i += 1;
        }
        return pos % count;
    }
}
