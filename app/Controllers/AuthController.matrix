// app/Controllers/AuthController.matrix
// Phase 3 — HTTP layer for accounts. No business logic here: everything
// delegates to AuthService, AuthValidators or AccessPolicy.

import "framework/Response";
import "framework/Config/Config";
import "framework/HttpException";
import "framework/View/BD";
import "framework/Container/Container";
import "framework/Database/DB";
import "app/Services/AuthService";
import "app/Services/AdvancedStoreService";
import "app/Policies/AccessPolicy";
import "app/Support/Money" as Money;
import "app/Support/StoreChrome" as StoreChrome;
import "app/Support/CartIdentity" as CartIdentity;
import "app/Services/CartService";
import "app/Validators/AuthValidators" as AuthValidators;

public class AuthController {
    public let auth;
    public let settings;

    fn new() {
        self.auth = new AuthService();
        self.settings = Container.make("store.settings");
    }

    // Base view context: layout needs store_name/currency; @yield("title")
    // and the optional meta description keep pages SEO-friendly.
    fn render(self, req, view_name: string, title: string, extra) {
        let ctx = {
            "store_name": self.settings["name"],
            "currency": self.settings["currency"],
            "title": title,
            "meta_description": title + " — " + self.settings["name"],
            "csrf": ""
        };
        // Dev builds only: surface the seeded demo accounts so evaluators
        // can sign in with different roles. Production never sets
        // SPID3R_ENV=dev, so the hint box never renders there.
        let demo_accounts = [];
        let env_flag = env("SPID3R_ENV");
        if env_flag.is_some() and string(env_flag.unwrap()).trim().lower() == "dev" {
            demo_accounts.push({
                "role": "Admin",
                "email": "admin@spid3r.test",
                "password": "secret123"
            });
            demo_accounts.push({
                "role": "Customer",
                "email": "shopper@spid3r.test",
                "password": "secret123"
            });
        }
        ctx["demo_accounts"] = demo_accounts;
        ctx["has_demo_accounts"] = demo_accounts.len() > 0;
        let chrome = StoreChrome.build(req, self.settings);
        for ck in chrome.keys() {
            ctx[ck] = chrome[ck];
        }
        if extra != null {
            for k in extra.keys() {
                ctx[k] = extra[k];
            }
        }
        return view(view_name, ctx);
    }

    fn cookie_name(self) -> string {
        return string(Config.get("session.cookie", "spid3r_session"));
    }

    // Phase 6 — merge the guest cart after a successful login.
    fn merge_guest_cart(self, req, email: string) -> bool {
        let key = CartIdentity.cookie_value(req, "cart");
        if key == "" {
            return false;
        }
        let user = DB.table("users").where("email", "=", string(email).trim().lower()).first();
        if user == null {
            return false;
        }
        let cart = new CartService();
        return cart.merge_on_login(key, user["id"]);
    }

    public fn show_login(self, req) {
        return self.render(req, "auth/login", "Sign in", {"error": "", "csrf": req.auth.csrf()});
    }

    public fn login(self, req) {
        req.validate_or_fail(AuthValidators.login_rules());
        let token = self.auth.login(req.input("email", ""), req.input("password", ""));
        if token == null {
            let res = self.render(req, "auth/login", "Sign in", {
                "error": "Invalid credentials or inactive account.",
                "csrf": req.auth.csrf()
            });
            res.status(401);
            return res;
        }
        // Merge the guest cart into the customer's cart (no-op if none).
        self.merge_guest_cart(req, req.input("email", ""));
        let res = redirect("/account");
        res.cookie(self.cookie_name(), token, "/", 86400);
        return res;
    }

    public fn show_register(self, req) {
        return self.render(req, "auth/register", "Create account", {"error": "", "csrf": req.auth.csrf()});
    }

    public fn register(self, req) {
        req.validate_or_fail(AuthValidators.registration_rules());
        let user = self.auth.register(
            req.input("name", ""),
            req.input("email", ""),
            req.input("password", "")
        );
        if user == null {
            throw validation_failed({"email": "That email is already registered."});
        }
        // Never auto-login: email verification is required first.
        return redirect("/login?registered=1");
    }

    public fn update_profile(self, req) {
        req.validate_or_fail({"name": "required|min:2|max:128"});
        DB.table("users").where("id", "=", req.auth.id()).update({
            "name": req.input("name", ""),
            "updated_at": string(unix_time())
        });
        return redirect("/account?updated=1");
    }

    public fn logout(self, req) {
        self.auth.logout(req.session_id);
        let res = redirect("/");
        res.cookie(self.cookie_name(), "", "/", 0);
        return res;
    }

    public fn account(self, req) {
        let uid = req.auth.id();
        let user = DB.table("users").where("id", "=", uid).first();
        if user == null {
            user = req.auth.user();
        }
        let policy = new AccessPolicy();
        let is_admin = policy.is_admin(uid);
        let referral_code = "";
        try {
            let adv = new AdvancedStoreService();
            referral_code = adv.ensure_referral_code(uid);
        } catch (e) {}
        let points = 0;
        if user != null and user["loyalty_points"] != null {
            points = int(user["loyalty_points"]);
        }
        let raw_orders = DB.table("orders").where("user_id", "=", uid).orderBy("id", "DESC").limit(5).get();
        let recent_orders = [];
        let i = 0;
        while i < raw_orders.len() {
            let o = raw_orders[i];
            let o_cur = "BDT";
            if o.has("currency") and string(o["currency"]).trim() != "" {
                o_cur = string(o["currency"]).trim().upper();
            }
            recent_orders.push({
                "id": o["id"],
                "order_number": o["order_number"],
                "status": o["status"],
                "status_label": string(o["status"]).replace("_", " "),
                "total_display": Money.format(int(o["total_minor"]), o_cur),
                "placed_at": o["placed_at"]
            });
            i += 1;
        }
        let addresses = DB.table("addresses").where("user_id", "=", uid).orderBy("id", "DESC").get();
        let orders_count = DB.table("orders").where("user_id", "=", uid).count();
        let wishlist_count = DB.table("wishlists").where("user_id", "=", uid).count();
        let returns_count = DB.table("returns").where("user_id", "=", uid).count();
        return self.render(req, "account/index", "My account", {
            "user": user,
            "is_admin": is_admin,
            "loyalty_points": points,
            "referral_code": referral_code,
            "orders_count": orders_count,
            "wishlist_count": wishlist_count,
            "addresses_count": addresses.len(),
            "returns_count": returns_count,
            "recent_orders": recent_orders,
            "has_recent_orders": recent_orders.len() > 0,
            "addresses": addresses,
            "has_addresses": addresses.len() > 0,
            "updated": string(req.query("updated", "")) == "1",
            "address_added": string(req.query("address_added", "")) == "1",
            "address_deleted": string(req.query("address_deleted", "")) == "1",
            "csrf": req.auth.csrf()
        });
    }

    public fn show_forgot(self, req) {
        return self.render(req, "auth/forgot", "Reset password", {"csrf": req.auth.csrf()});
    }

    public fn forgot(self, req) {
        req.validate_or_fail(AuthValidators.forgot_rules());
        // Deliberately identical response for known/unknown addresses —
        // prevents account enumeration.
        self.auth.request_password_reset(req.input("email", ""));
        return self.render(req, "auth/forgot", "Reset password", {
            "sent": true,
            "csrf": req.auth.csrf()
        });
    }

    public fn show_reset(self, req) {
        let token = string(req.query("token", ""));
        return self.render(req, "auth/reset", "Choose a new password", {
            "token": token,
            "csrf": req.auth.csrf()
        });
    }

    public fn reset(self, req) {
        req.validate_or_fail(AuthValidators.reset_rules());
        if not self.auth.reset_password(req.input("token", ""), req.input("password", "")) {
            throw bad_request("This reset link is invalid or has expired.");
        }
        return redirect("/login?reset=1");
    }

    public fn verify_email(self, req) {
        let token = string(req.param("token", ""));
        if not self.auth.verify_email(token) {
            throw bad_request("This verification link is invalid or has expired.");
        }
        return redirect("/login?verified=1");
    }
}
