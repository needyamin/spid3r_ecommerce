// app/Repositories/CatalogRepository.matrix
// Phase 4 — ALL catalog data access (products live in ProductRepository).

import "framework/Database/DB";

public class CategoryRepository {
    fn new() {}

    public fn all(self) {
        return DB.table("categories").orderBy("sort_order", "ASC").get();
    }

    public fn find(self, id) {
        return DB.table("categories").where("id", "=", id).first();
    }

    public fn find_by_slug(self, slug: string) {
        return DB.table("categories").where("slug", "=", slug).first();
    }

    public fn children(self, parent_id) {
        let q = DB.table("categories").orderBy("sort_order", "ASC");
        if parent_id == null {
            q.whereNull("parent_id");
        } else {
            q.where("parent_id", "=", parent_id);
        }
        return q.get();
    }

    public fn create(self, data) {
        return DB.table("categories").insert(data);
    }

    public fn update(self, id, data) -> bool {
        return DB.table("categories").where("id", "=", id).update(data) > 0;
    }

    public fn delete(self, id) -> bool {
        return DB.table("categories").where("id", "=", id).delete() > 0;
    }

    public fn product_count(self, id) -> int {
        return DB.table("products").where("category_id", "=", id).count();
    }
}

public class BrandRepository {
    fn new() {}

    public fn all(self) {
        return DB.table("brands").orderBy("name", "ASC").get();
    }

    public fn find(self, id) {
        return DB.table("brands").where("id", "=", id).first();
    }

    public fn create(self, data) {
        return DB.table("brands").insert(data);
    }

    public fn update(self, id, data) -> bool {
        return DB.table("brands").where("id", "=", id).update(data) > 0;
    }

    public fn delete(self, id) -> bool {
        return DB.table("brands").where("id", "=", id).delete() > 0;
    }
}

public class VariantRepository {
    fn new() {}

    public fn for_product(self, product_id) {
        return DB.table("product_variants")
            .where("product_id", "=", product_id)
            .orderBy("id", "ASC")
            .get();
    }

    public fn find(self, id) {
        return DB.table("product_variants").where("id", "=", id).first();
    }

    public fn sku_exists(self, sku: string, except_id) -> bool {
        let q = DB.table("product_variants").where("sku", "=", sku);
        if except_id != null {
            q.where("id", "!=", except_id);
        }
        if q.count() > 0 {
            return true;
        }
        // SKUs are globally unique across products and variants.
        return DB.table("products").where("sku", "=", sku).count() > 0;
    }

    public fn create(self, data) {
        return DB.table("product_variants").insert(data);
    }

    public fn update(self, id, data) -> bool {
        return DB.table("product_variants").where("id", "=", id).update(data) > 0;
    }

    public fn delete(self, id) -> bool {
        return DB.table("product_variants").where("id", "=", id).delete() > 0;
    }
}

public class ImageRepository {
    fn new() {}

    public fn for_product(self, product_id) {
        return DB.table("product_images")
            .where("product_id", "=", product_id)
            .orderBy("sort_order", "ASC")
            .get();
    }

    public fn find(self, id) {
        return DB.table("product_images").where("id", "=", id).first();
    }

    public fn next_sort(self, product_id) -> int {
        // MAX + 1 (not COUNT): after an image is deleted the count would
        // hand out a sort_order that another image already uses.
        let rows = DB.table("product_images")
            .where("product_id", "=", product_id)
            .orderBy("sort_order", "DESC")
            .limit(1)
            .get();
        if rows.len() == 0 {
            return 0;
        }
        return int(rows[0]["sort_order"]) + 1;
    }

    public fn clear_primary(self, product_id) {
        return DB.table("product_images")
            .where("product_id", "=", product_id)
            .update({"is_primary": 0});
    }

    public fn create(self, data) {
        return DB.table("product_images").insert(data);
    }

    public fn delete(self, id) -> bool {
        return DB.table("product_images").where("id", "=", id).delete() > 0;
    }
}
