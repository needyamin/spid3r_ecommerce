// app/Validators/AuthValidators.matrix
// Phase 3 — rule maps for every account form. Controllers pass these to
// req.validate_or_fail(rules).

public fn registration_rules() {
    return {
        "name": "required|min:2|max:128",
        "email": "required|email|max:255",
        "password": "required|min:8|confirmed"
    };
}

public fn login_rules() {
    return {
        "email": "required|email",
        "password": "required|min:8"
    };
}

public fn forgot_rules() {
    return {"email": "required|email"};
}

public fn reset_rules() {
    return {
        "token": "required|min:16",
        "password": "required|min:8|confirmed"
    };
}
