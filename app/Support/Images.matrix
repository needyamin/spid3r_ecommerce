// app/Support/Images.matrix
// Single source of truth for resolving an uploaded product image path to a
// URL. When the underlying file is missing on disk (stale row, broken
// upload, or accidental deletion) — or the product has no image at all — we
// fall back to a GENERATED initials SVG (first letters/digits of the product
// name, same visual style as the seeded product art) so the UI never renders
// a broken <img> or a bare "No image" box. Uploaded assets live under the
// Storage "public" disk and are served from /uploads/.

import "framework/Filesystem/Storage";

public fn public_image_url(path, name = null) -> string {
    if path == null or path == "" {
        return fallback_image_url(name);
    }
    let p = string(path);
    // Already a resolved web URL (e.g. a previous call returned /uploads/...,
    // /images/... or the generated initials route). Return it unchanged so
    // the helper is idempotent and never feeds an absolute path to
    // Storage.exists().
    if p.starts_with("/uploads/") or p.starts_with("/images/") {
        return p;
    }
    if Storage.disk("public").exists(p) {
        return "/uploads/" + p;
    }
    return fallback_image_url(name);
}

// Fallback target for products without a usable image. With a product name
// we can render generated initials artwork; without one we keep the static
// placeholder.
public fn fallback_image_url(name) -> string {
    if name == null or string(name).trim() == "" {
        return "/images/placeholder.svg";
    }
    return initials_image_url(string(name).trim());
}

// First alphanumeric character of each of the first two words ("NovaBuds Air"
// -> "NA", "VoltEdge 65W" -> "V6", "PixelHub 4K" -> "P4"). Single-word names
// use their first two characters. Mirrors the initials baked into the seeded
// public/images/products/*.svg artwork.
public fn image_initials(name: string) -> string {
    let clean = string(name).trim();
    if clean == "" {
        return "";
    }
    let allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
    let initials = "";
    let words = clean.split(" ");
    let i = 0;
    while i < words.len() and initials.len() < 2 {
        let w = string(words[i]).trim();
        let j = 0;
        while j < w.len() {
            let ch = w.slice(j, j + 1);
            if allowed.contains(ch) {
                initials = initials + ch.upper();
                break;
            }
            j += 1;
        }
        i += 1;
    }
    if initials == "" {
        initials = clean.slice(0, 2).upper();
    }
    return initials;
}

// URL of the runtime-generated initials artwork for a product name. The name
// travels base64url-encoded so any UTF-8 product name survives the query
// string. Served by ImageController.initials (a pure function of the query —
// no DB, browser-cacheable).
public fn initials_image_url(name: string) -> string {
    return "/images/initials.svg?n=" + b64url(string(name).trim());
}

// Minimal XML escaping for text placed inside SVG <text> nodes (product
// names may contain "&" — e.g. "Craft&Co").
public fn escape_xml_text(text: string) -> string {
    return string(text)
        .replace("&", "&amp;")
        .replace("<", "&lt;")
        .replace(">", "&gt;");
}

fn b64url(input: string) -> string {
    let b64 = base64_encode(input).replace("+", "-").replace("/", "_");
    while b64.ends_with("=") {
        b64 = b64.slice(0, b64.len() - 1);
    }
    return b64;
}

// Inverse of b64url — mirrors the padding and bytes->string handling in
// framework/Auth/Jwt (base64_decode yields a bytes value that must be
// converted character by character).
public fn b64url_decode(input: string) -> string {
    let b64 = input.replace("-", "+").replace("_", "/");
    let rem = b64.len() % 4;
    if rem == 2 {
        b64 = b64 + "==";
    } elif rem == 3 {
        b64 = b64 + "=";
    }
    let res = base64_decode(b64);
    let raw_bytes = res;
    if type_of(res) == "result" {
        if res.is_err() {
            return "";
        }
        raw_bytes = res.unwrap();
    }
    if type_of(raw_bytes) == "string" {
        return raw_bytes;
    }
    if type_of(raw_bytes) == "bytes" {
        let chars = [];
        let i = 0;
        let n = len(raw_bytes);
        while i < n {
            chars.push(chr(raw_bytes.get(i)));
            i += 1;
        }
        return chars.join("");
    }
    return "";
}
