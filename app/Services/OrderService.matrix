// app/Services/OrderService.matrix
// Phase 7 — order lifecycle, ownership checks, cancellation & invoices.

import "framework/Database/DB";
import "framework/HttpException";
import "app/Repositories/OrderRepository";
import "app/Repositories/InventoryRepository";
import "app/Services/AdvancedStoreService";
import "app/Support/Money" as Money;

public class OrderService {
    public let orders;
    public let inventory;
    public let advanced;

    fn new() {
        self.orders = new OrderRepository();
        self.inventory = new InventoryRepository();
        self.advanced = new AdvancedStoreService();
    }

    public fn statuses(self) {
        return ["pending", "awaiting_payment", "paid", "processing", "packed",
                "shipped", "delivered", "cancelled", "refunded"];
    }

    fn valid_status(self, status: string) -> bool {
        let all = self.statuses();
        let i = 0;
        while i < all.len() {
            if all[i] == status {
                return true;
            }
            i += 1;
        }
        return false;
    }

    // Ownership: a customer may only see their own orders.
    public fn for_customer(self, number: string, user_id) {
        let order = self.orders.find_by_number(number);
        if order == null {
            throw not_found("Order not found.");
        }
        if order["user_id"] == null or user_id == null or int(order["user_id"]) != int(user_id) {
            throw not_found("Order not found.");
        }
        return order;
    }

    public fn decorate(self, order) {
        let items = self.orders.items_for(order["id"]);
        let out = [];
        let i = 0;
        while i < items.len() {
            let row = items[i];
            row["unit_display"] = Money.format(int(row["unit_price_minor"]), "BDT");
            row["line_display"] = Money.format(int(row["line_total_minor"]), "BDT");
            out.push(row);
            i += 1;
        }
        let view = map(
            "order", order,
            "items", out,
            "subtotal_display", Money.format(int(order["subtotal_minor"]), "BDT"),
            "discount_display", Money.format(int(order["discount_minor"]), "BDT"),
            "shipping_display", Money.format(int(order["shipping_minor"]), "BDT"),
            "tax_display", Money.format(int(order["tax_minor"]), "BDT"),
            "total_display", Money.format(int(order["total_minor"]), "BDT"),
            "status_label", string(order["status"]).replace("_", " ")
        );
        let addr = json_parse(string(order["shipping_address_json"]));
        if type_of(addr) == "map" {
            view["address"] = addr;
        } else {
            view["address"] = map();
        }
        return view;
    }

    fn release_stock(self, order_id) -> bool {
        let items = self.orders.items_for(order_id);
        let i = 0;
        while i < items.len() {
            self.inventory.release(items[i]["product_id"], null, int(items[i]["quantity"]), "cancellation");
            i += 1;
        }
        return true;
    }

    // Cancel a customer order. Delivered/shipped/packed orders need staff.
    public fn cancel(self, number: string, user_id) {
        return DB.transaction(fn() {
            let order = self.for_customer(number, user_id);
            let status = string(order["status"]);
            if status == "cancelled" or status == "refunded" {
                throw validation_failed(map("status", "This order is already closed."));
            }
            if status == "packed" or status == "shipped" or status == "delivered" {
                throw validation_failed(map("status", "Contact support to cancel a shipped order."));
            }
            self.release_stock(order["id"]);
            self.orders.set_status(order["id"], "cancelled");
            return self.orders.find(order["id"]);
        });
    }

    // Admin/staff status transitions. Cancelling or refunding returns stock
    // exactly once; shipping creates a shipment tracking row.
    public fn set_status(self, order_id, new_status: string) {
        if not self.valid_status(new_status) {
            throw validation_failed(map("status", "Unknown order status."));
        }
        return DB.transaction(fn() {
            let order = self.orders.find(order_id);
            if order == null {
                throw not_found("Order not found.");
            }
            let previous = string(order["status"]);
            let released = previous == "cancelled" or previous == "refunded";
            if (new_status == "cancelled" or new_status == "refunded") and not released {
                self.release_stock(order_id);
            }
            if new_status == "shipped" and DB.table("shipments").where("order_id", "=", order_id).count() == 0 {
                DB.table("shipments").insert(map(
                    "order_id", order_id,
                    "status", "shipped",
                    "shipped_at", string(unix_time()),
                    "tracking_number", "SP-" + string(order_id)
                ));
            }
            self.orders.set_status(order_id, new_status);
            // Settle the customer rewards exactly when an order becomes
            // paid — covers COD verification, gateway webhooks and admin
            // transitions alike. Both awards are idempotent, so a repeated
            // transition cannot double-pay.
            // (Wired in Phase 14: the E2E journey caught that these were
            // never called anywhere — points were silently never granted.)
            if new_status == "paid" and previous != "paid" {
                self.advanced.award_loyalty(order_id);
                self.advanced.reward_referral(order_id);
            }
            return self.orders.find(order_id);
        });
    }
}
