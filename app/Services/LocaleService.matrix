// app/Services/LocaleService.matrix
// Phase 10 — multi-language support.
//
// Translations live in the `translations` table (locale, namespace, key,
// value). Lookup order is: requested locale -> default locale -> the
// supplied fallback -> the key itself, so a missing translation degrades to
// readable English rather than to an empty string.
//
// The customer's choice lives in the `store_locale` cookie; `?lang=` also
// works for shareable links.

import "framework/Database/DB";
import "framework/HttpException";
import "app/Support/CartIdentity" as CartIdentity;

public class LocaleService {
    public let default_locale;

    fn new(default_locale: string = "en") {
        let code = string(default_locale).trim().lower();
        if code == "" {
            code = "en";
        }
        self.default_locale = code;
    }

    // Every locale that has at least one translation.
    public fn locales(self) {
        let rows = DB.table("translations").orderBy("locale", "ASC").get();
        let seen = [];
        let i = 0;
        while i < rows.len() {
            let code = string(rows[i]["locale"]).trim().lower();
            if code != "" {
                let known = false;
                let j = 0;
                while j < seen.len() {
                    if seen[j] == code {
                        known = true;
                        break;
                    }
                    j += 1;
                }
                if not known {
                    seen.push(code);
                }
            }
            i += 1;
        }
        // The default locale is always offered, even before translations exist.
        let has_default = false;
        let k = 0;
        while k < seen.len() {
            if seen[k] == self.default_locale {
                has_default = true;
                break;
            }
            k += 1;
        }
        if not has_default {
            seen.push(self.default_locale);
        }
        return seen;
    }

    // Switcher-friendly options: each entry carries the code plus a
    // human-readable label, so templates never render raw "bn"/"en".
    public fn locale_options(self, selected_code: string = "") {
        let codes = self.locales();
        let chosen = string(selected_code).trim().lower();
        if chosen == "" {
            chosen = self.default_locale;
        }
        let out = [];
        let i = 0;
        while i < codes.len() {
            let code = string(codes[i]);
            let flag = 0;
            if code == chosen {
                flag = 1;
            }
            out.push({
                "code": code,
                "label": self.locale_label(code),
                "selected": flag
            });
            i += 1;
        }
        return out;
    }

