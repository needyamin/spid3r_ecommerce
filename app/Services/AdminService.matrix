// app/Services/AdminService.matrix
// Phase 9 — dashboard statistics & management data (queries centralized).

import "framework/Database/DB";
import "framework/HttpException";

public class AdminService {
    fn new() {}

    fn count(self, table_name: string, field: string = "", value = null) -> int {
        if field != "" {
            return DB.table(table_name).where(field, "=", value).count();
        }
        return DB.table(table_name).count();
    }

    // Dashboard overview — revenue is derived from SETTLED orders only
    // (cancelled/refunded/pending never count as income).
    public fn dashboard(self) {
        let settled = ["paid", "processing", "packed", "shipped", "delivered"];
        let order_rows = DB.table("orders").whereIn("status", settled).get();
        let revenue = 0;
        let i = 0;
        while i < order_rows.len() {
            revenue = revenue + int(order_rows[i]["total_minor"]);
            i += 1;
        }
        let all_orders = DB.table("orders").get();
        let p_pending = 0;
        let p_processing = 0;
        let p_shipped = 0;
        let p_delivered = 0;
        let p_cancelled = 0;
        i = 0;
        while i < all_orders.len() {
            let st = string(all_orders[i]["status"]);
            if st == "pending" or st == "awaiting_payment" {
                p_pending += 1;
            } elif st == "paid" or st == "processing" or st == "packed" {
                p_processing += 1;
            } elif st == "shipped" {
                p_shipped += 1;
            } elif st == "delivered" {
                p_delivered += 1;
            } elif st == "cancelled" or st == "refunded" {
                p_cancelled += 1;
            }
            i += 1;
        }
        let active_total = p_pending + p_processing + p_shipped + p_delivered;
        let pct_pending = 25;
        let pct_processing = 25;
        let pct_shipped = 25;
        let pct_delivered = 25;
        if active_total > 0 {
            pct_pending = (p_pending * 100) / active_total;
            pct_processing = (p_processing * 100) / active_total;
            pct_shipped = (p_shipped * 100) / active_total;
            pct_delivered = 100 - pct_pending - pct_processing - pct_shipped;
            if pct_delivered < 0 {
                pct_delivered = 0;
            }
        }
        let low_stock = 0;
        let low_stock_items = [];
        let inventory = DB.table("inventory").whereNull("variant_id").get();
        i = 0;
        while i < inventory.len() {
            let qty = int(inventory[i]["quantity"]);
            let thresh = int(inventory[i]["low_stock_threshold"]);
            if qty <= thresh {
                low_stock = low_stock + 1;
                if low_stock_items.len() < 5 {
                    let pid = int(inventory[i]["product_id"]);
                    let prod = DB.table("products").where("id", "=", pid).first();
                    let pname = "Product #" + string(pid);
                    let psku = "";
                    if prod != null {
                        pname = string(prod["name"]);
                        psku = string(prod["sku"]);
                    }
                    low_stock_items.push({
                        "product_id": pid,
                        "name": pname,
                        "sku": psku,
                        "quantity": qty,
                        "low_stock_threshold": thresh
                    });
                }
            }
            i += 1;
        }
        let recent = DB.table("orders").orderBy("id", "DESC").limit(6).get();
        return {
            "orders": self.count("orders"),
            "pending_orders": DB.table("orders").where("status", "=", "awaiting_payment").count(),
            "pipeline_pending": p_pending,
            "pipeline_processing": p_processing,
            "pipeline_shipped": p_shipped,
            "pipeline_delivered": p_delivered,
            "pipeline_cancelled": p_cancelled,
            "pct_pending": pct_pending,
            "pct_processing": pct_processing,
            "pct_shipped": pct_shipped,
            "pct_delivered": pct_delivered,
            "revenue_minor": revenue,
            "customers": self.count("users"),
            "products": self.count("products"),
            "published_products": self.count("products", "status", "published"),
            "categories": self.count("categories"),
            "brands": self.count("brands"),
            "low_stock": low_stock,
            "low_stock_items": low_stock_items,
            "has_low_stock_items": low_stock_items.len() > 0,
            "coupons": self.count("coupons"),
            "recent_orders": recent,
            "has_recent": recent.len() > 0
        };
    }

    // SECURITY: never return raw user rows — they carry the password hash.
    // Lists select an explicit column whitelist.
    public fn customers(self, query: string = "") {
        let q = DB.table("users").select(["id", "name", "email", "phone", "status", "loyalty_points", "created_at"]).orderBy("id", "DESC");
        if query != "" {
            q.where("email", "LIKE", "%" + query + "%");
        }
        return q.limit(100).get();
    }

    public fn set_customer_status(self, user_id, status: string) -> bool {
        if status != "active" and status != "suspended" {
            throw validation_failed({"status": "Invalid account status."});
        }
        let user = DB.table("users").where("id", "=", user_id).first();
        if user == null {
            throw not_found("Customer not found.");
        }
        return DB.table("users").where("id", "=", user_id).update({"status": status}) > 0;
    }

    // Staff = users holding at least one non-customer role. Each row carries
    // the user's staff role so the admin UI can show and revoke it.
    // `query` filters by name or email (admin SPA search box).
    public fn staff(self, query: string = "") {
        let links = DB.table("user_roles").get();
        let by_user = {};
        let i = 0;
        while i < links.len() {
            let role = DB.table("roles").where("id", "=", links[i]["role_id"]).first();
            if role != null and role["slug"] != "customer" {
                let uid = int(links[i]["user_id"]);
                if not by_user.has(uid) {
                    by_user[uid] = {"slug": string(role["slug"]), "name": string(role["name"])};
                }
            }
            i += 1;
        }
        let ids = by_user.keys();
        if ids.len() == 0 {
            return [];
        }
        let users = DB.table("users").select(["id", "name", "email", "status", "created_at"]).whereIn("id", ids).orderBy("id", "ASC").limit(200).get();
        let needle = string(query).trim().lower();
        let out = [];
        i = 0;
        while i < users.len() {
            let u = users[i];
            let r = by_user[int(u["id"])];
            if r == null {
                i += 1;
                continue;
            }
            if needle != "" {
                let name = string(u["name"]).lower();
                let email = string(u["email"]).lower();
                if not name.contains(needle) and not email.contains(needle) {
                    i += 1;
                    continue;
                }
            }
            u["role_slug"] = r["slug"];
            u["role_name"] = r["name"];
            out.push(u);
            i += 1;
        }
        return out;
    }

    public fn assign_role(self, user_id, role_slug: string) -> bool {
        let role = DB.table("roles").where("slug", "=", role_slug).first();
        if role == null {
            throw not_found("Role not found.");
        }
        if DB.table("users").where("id", "=", user_id).first() == null {
            throw not_found("User not found.");
        }
        let exists = DB.table("user_roles")
            .where("user_id", "=", user_id)
            .where("role_id", "=", role["id"])
            .count();
        if exists > 0 {
            return false;
        }
        DB.table("user_roles").insert({"user_id": user_id, "role_id": role["id"]});
        return true;
    }

    // Revoke a staff role from a user. Guards:
    // - the role and user must exist;
    // - the user must actually hold the role;
    // - the LAST admin can never be demoted (lockout protection).
    public fn remove_role(self, user_id, role_slug: string) -> bool {
        let role = DB.table("roles").where("slug", "=", role_slug).first();
        if role == null {
            throw not_found("Role not found.");
        }
        if DB.table("users").where("id", "=", user_id).first() == null {
            throw not_found("User not found.");
        }
        let link = DB.table("user_roles")
            .where("user_id", "=", user_id)
            .where("role_id", "=", role["id"]);
        if link.count() == 0 {
            throw validation_failed({"role": "This user does not hold the " + role_slug + " role."});
        }
        if role_slug == "admin" {
            let admins = DB.table("user_roles").where("role_id", "=", role["id"]).get();
            if admins.len() <= 1 {
                throw validation_failed({"role": "Cannot remove the last admin — promote another admin first."});
            }
        }
        return link.delete() > 0;
    }

    public fn roles(self) {
        let rows = DB.table("roles").orderBy("id", "ASC").get();
        let out = [];
        let i = 0;
        while i < rows.len() {
            let role = rows[i];
            role["permission_count"] = DB.table("role_permissions")
                .where("role_id", "=", role["id"]).count();
            // Permission slugs for the admin SPA's per-role checkboxes.
            let links = DB.table("role_permissions")
                .where("role_id", "=", role["id"]).get();
            let slugs = [];
            let j = 0;
            while j < links.len() {
                let perm = DB.table("permissions").where("id", "=", links[j]["permission_id"]).first();
                if perm != null {
                    slugs.push(string(perm["slug"]));
                }
                j += 1;
            }
            role["permission_slugs"] = slugs;
            out.push(role);
            i += 1;
        }
        return out;
    }

    public fn permissions(self) {
        return DB.table("permissions").orderBy("slug", "ASC").get();
    }

    public fn toggle_permission(self, role_id, permission_slug: string, enabled: bool) -> bool {
        let perm = DB.table("permissions").where("slug", "=", permission_slug).first();
        if perm == null {
            throw not_found("Permission not found.");
        }
        if DB.table("roles").where("id", "=", role_id).first() == null {
            throw not_found("Role not found.");
        }
        let link = DB.table("role_permissions")
            .where("role_id", "=", role_id)
            .where("permission_id", "=", perm["id"]);
        if enabled {
            if link.count() > 0 {
                return false;
            }
            DB.table("role_permissions").insert({"role_id": role_id, "permission_id": perm["id"]});
            return true;
        }
        return link.delete() > 0;
    }

    // ---- coupons ----
    public fn coupons(self, query: string = "") {
        let q = DB.table("coupons").orderBy("id", "DESC");
        if query != "" {
            q.where("code", "LIKE", "%" + query + "%");
        }
        return q.limit(200).get();
    }

    public fn save_coupon(self, data, coupon_id) {
        let code = string(data["code"]).trim().upper();
        if code == "" {
            throw validation_failed({"code": "A coupon code is required."});
        }
        // Format whitelist (audit F-5): codes feed URLs, lookups and CSV
        // exports — keep them short and alphanumeric.
        if not regex_match("^[A-Z0-9_-]{1,32}$", code) {
            throw validation_failed({"code": "Codes are 1-32 chars: letters, numbers, dash or underscore."});
        }
        let kind = string(data["type"]).trim();
        if kind != "fixed" and kind != "percent" {
            throw validation_failed({"type": "Type must be fixed or percent."});
        }
        // Percent codes are stored in basis points — cap at 100% (audit F-4).
        if kind == "percent" and int(data["value_minor"]) > 10000 {
            throw validation_failed({"value_minor": "A percent discount cannot exceed 100%."});
        }
        let clash = DB.table("coupons").where("code", "=", code);
        if coupon_id != null {
            clash.where("id", "!=", coupon_id);
        }
        if clash.count() > 0 {
            throw validation_failed({"code": "That coupon code already exists."});
        }
        // On create a coupon starts active. On update, keep the stored
        // active state unless the caller explicitly passes is_active —
        // otherwise every edit would silently reactivate a deactivated
        // coupon (which the delete guard tells admins to use instead).
        let existing = null;
        if coupon_id != null {
            existing = DB.table("coupons").where("id", "=", coupon_id).first();
            if existing == null {
                throw not_found("Coupon not found.");
            }
        }
        let active = 1;
        if coupon_id != null {
            if data.has("is_active") and string(data["is_active"]) != "" {
                if int(data["is_active"]) == 0 {
                    active = 0;
                }
            } else {
                active = int(existing["is_active"]);
            }
        }
        let values = {
            "code": code,
            "type": kind,
            "value_minor": int(data["value_minor"]),
            "min_order_minor": int(data["min_order_minor"]),
            "max_uses": int(data["max_uses"]),
            "is_active": active
        };
        if int(values["value_minor"]) < 0 or int(values["min_order_minor"]) < 0 or int(values["max_uses"]) < 0 {
            throw validation_failed({"value_minor": "Coupon values cannot be negative."});
        }
        if coupon_id == null {
            let id = DB.table("coupons").insert(values);
            return DB.table("coupons").where("id", "=", id).first();
        }
        DB.table("coupons").where("id", "=", coupon_id).update(values);
        return DB.table("coupons").where("id", "=", coupon_id).first();
    }

    // Activate / deactivate a coupon. Deactivation is the safe alternative
    // for coupons that already have usages and therefore cannot be deleted.
    public fn set_coupon_active(self, coupon_id, active: bool) -> bool {
        if DB.table("coupons").where("id", "=", coupon_id).first() == null {
            throw not_found("Coupon not found.");
        }
        let flag = 0;
        if active == true {
            flag = 1;
        }
        return DB.table("coupons").where("id", "=", coupon_id).update({"is_active": flag}) > 0;
    }

    public fn delete_coupon(self, coupon_id) -> bool {
        if DB.table("coupons").where("id", "=", coupon_id).first() == null {
            throw not_found("Coupon not found.");
        }
        if DB.table("coupon_usages").where("coupon_id", "=", coupon_id).count() > 0 {
            throw validation_failed({"id": "Used coupons cannot be deleted; deactivate them instead."});
        }
        return DB.table("coupons").where("id", "=", coupon_id).delete() > 0;
    }

    // ---- settings (shipping / payment / store configuration) ----
    public fn settings(self, group: string = "") {
        let q = DB.table("settings").orderBy("setting_key", "ASC");
        if group != "" {
            q.where("setting_group", "=", group);
        }
        return q.get();
    }

    public fn update_setting(self, key: string, value: string, group: string = "general") -> bool {
        let clean = string(key).trim();
        if clean == "" {
            throw validation_failed({"key": "A setting key is required."});
        }
        let existing = DB.table("settings").where("setting_key", "=", clean).first();
        if existing == null {
            DB.table("settings").insert({
                "setting_key": clean, "value": value, "setting_group": group
            });
            return true;
        }
        return DB.table("settings").where("setting_key", "=", clean).update({
            "value": value, "setting_group": group
        }) > 0;
    }

    // ---- audit log ----
    public fn log(self, user_id, action: string, entity_type: string, entity_id, payload) {
        return DB.table("audit_logs").insert({
            "user_id": user_id,
            "action": action,
            "entity_type": entity_type,
            "entity_id": string(entity_id),
            "payload_json": json_write(payload),
            "created_at": string(unix_time())
        });
    }

    public fn audit(self, limit_count: int = 50) {
        return DB.table("audit_logs").orderBy("id", "DESC").limit(limit_count).get();
    }

    // ---- reports / export ----
    public fn report_rows(self) {
        let settled = ["paid", "processing", "packed", "shipped", "delivered"];
        let rows = DB.table("orders").whereIn("status", settled).orderBy("id", "ASC").get();
        let out = [];
        let i = 0;
        while i < rows.len() {
            let r = rows[i];
            out.push({
                "order_number": r["order_number"],
                "status": r["status"],
                "total_minor": int(r["total_minor"]),
                "placed_at": r["placed_at"]
            });
            i += 1;
        }
        return out;
    }

    public fn csv_export(self) -> string {
        let rows = self.report_rows();
        let csv = "order_number,status,total_minor,placed_at\n";
        let i = 0;
        while i < rows.len() {
            let r = rows[i];
            csv = csv + string(r["order_number"]) + "," + string(r["status"]) + ","
                + string(r["total_minor"]) + "," + string(r["placed_at"]) + "\n";
            i += 1;
        }
        return csv;
    }
}
