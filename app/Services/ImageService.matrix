// app/Services/ImageService.matrix
// Phase 4 — product galleries with SAFE image uploads.
//
// Framework capability note (documented in docs/ecommerce/PRODUCTS.md):
// Request.parse_multipart intentionally skips file parts (binary bodies
// are not supported by the text-mode parser). To avoid an unnecessary
// language-runtime change, the admin API accepts base64-encoded image
// payloads in JSON instead. Files are validated server-side by MAGIC
// BYTES (never by client-supplied extension or MIME), size-capped, given
// random names, and written with the runtime's binary `write_bytes`.

import "framework/Database/DB";
import "app/Support/CatalogCache" as CatalogCache;
import "framework/HttpException";
import "framework/Filesystem/Storage";
import "app/Repositories/CatalogRepository";
import "app/Support/Images" as Images;

public class ImageService {
    public let images;

    fn new() {
        self.images = new ImageRepository();
    }

    fn detect_type(self, b) -> string {
        let n = len(b);
        if n >= 8 and b[0] == 137 and b[1] == 80 and b[2] == 78 and b[3] == 71 {
            return "png";
        }
        if n >= 3 and b[0] == 255 and b[1] == 216 and b[2] == 255 {
            return "jpg";
        }
        if n >= 6 and b[0] == 71 and b[1] == 73 and b[2] == 70 {
            return "gif";
        }
        if n >= 12 and b[0] == 82 and b[1] == 73 and b[2] == 70 and b[3] == 70
            and b[8] == 87 and b[9] == 69 and b[10] == 66 and b[11] == 80 {
            return "webp";
        }
        return "";
    }

    // `payload` may be a plain base64 string or a data: URL.
    public fn upload(self, product_id, payload: string, alt_text: string, is_primary: bool) {
        let product = DB.table("products").where("id", "=", product_id).first();
        if product == null {
            throw not_found("Product not found.");
        }
        let b64 = string(payload).trim();
        let comma = b64.index_of(",");
        if b64.starts_with("data:") and comma >= 0 {
            b64 = b64.slice(comma + 1, len(b64));
        }
        if len(b64) > 2800000 {
            throw validation_failed(map("image", "Image exceeds the 2 MiB limit."));
        }
        let bytes = base64_decode(b64);
        if len(bytes) < 8 or len(bytes) > 2097152 {
            throw validation_failed(map("image", "Image exceeds the 2 MiB limit or is empty."));
        }
        let ext = self.detect_type(bytes);
        if ext == "" {
            throw validation_failed(map("image", "Only PNG, JPEG, GIF and WEBP images are allowed."));
        }

        let rel = "products/" + string(product_id) + "/"
            + hex_encode(random_bytes(8).unwrap()) + "." + ext;
        let disk = Storage.disk("public");
        // put() creates parent dirs; write_bytes then replaces the empty
        // placeholder with the exact binary payload.
        disk.put(rel, "");
        let written = write_bytes(disk.path(rel), bytes);
        if written.is_err() {
            throw bad_request("Could not store the uploaded image.");
        }
        if not disk.exists(rel) {
            throw bad_request("Uploaded image verification failed.");
        }
        CatalogCache.bump_catalog_version();

        return DB.transaction(fn() {
            let id = self.images.create(map(
                "product_id", product_id,
                "path", rel,
                "alt_text", alt_text,
                "sort_order", self.images.next_sort(product_id),
                "is_primary", 0
            ));
            if is_primary {
                // Reuse the cover logic so the image also moves to the
                // FRONT of the gallery — the storefront picks the card
                // photo by the lowest sort_order, not by is_primary.
                self.set_primary(id);
            }
            return DB.table("product_images").where("id", "=", id).first();
        });
    }

    // Move an image one position up (-1) or down (+1) in the gallery.
    public fn move(self, image_id, direction: int) -> bool {
        let row = self.images.find(image_id);
        if row == null {
            throw not_found("Image not found.");
        }
        let siblings = self.images.for_product(row["product_id"]);
        let index = 0;
        let i = 0;
        while i < siblings.len() {
            if int(siblings[i]["id"]) == int(image_id) {
                index = i;
            }
            i += 1;
        }
        let target = index + direction;
        if target < 0 or target >= siblings.len() {
            return false;
        }
        let other = siblings[target];
        // Swap the two sort orders.
        DB.table("product_images").where("id", "=", image_id)
            .update(map("sort_order", int(other["sort_order"])));
        DB.table("product_images").where("id", "=", other["id"])
            .update(map("sort_order", int(row["sort_order"])));
        // The storefront chooses the lowest sort_order; keep its chosen
        // image and the admin cover badge in sync after every reorder.
        let reordered = self.images.for_product(row["product_id"]);
        if reordered.len() > 0 {
            self.set_primary(reordered[0]["id"]);
        } else {
            CatalogCache.bump_catalog_version();
        }
        return true;
    }

    public fn gallery(self, product_id) {
        let rows = self.images.for_product(product_id);
        let out = [];
        let i = 0;
        while i < rows.len() {
            let row = rows[i];
            out.push(map(
                "id", row["id"],
                "url", Images.public_image_url(row["path"]),
                "alt_text", row["alt_text"],
                "sort_order", row["sort_order"],
                "is_primary", row["is_primary"] == 1 or row["is_primary"] == true
            ));
            i += 1;
        }
        return out;
    }

    // Mark one image as the product's primary (cover) shot. The other
    // images stay in the gallery but lose the flag.
    //
    // IMPORTANT: the storefront picks the product-card photo by the
    // LOWEST sort_order (attach_images), not by is_primary — so the
    // cover image is also moved to the front of the gallery.
    public fn set_primary(self, image_id) -> bool {
        let row = self.images.find(image_id);
        if row == null {
            throw not_found("Image not found.");
        }
        self.images.clear_primary(row["product_id"]);
        let ok = DB.table("product_images")
            .where("id", "=", image_id)
            .update(map("is_primary", 1, "sort_order", 0)) > 0;
        // Keep the remaining gallery images in a stable order behind it.
        let others = DB.table("product_images")
            .where("product_id", "=", row["product_id"])
            .where("id", "!=", image_id)
            .orderBy("sort_order", "ASC")
            .get();
        let i = 0;
        while i < others.len() {
            DB.table("product_images")
                .where("id", "=", others[i]["id"])
                .update(map("sort_order", i + 1));
            i += 1;
        }
        CatalogCache.bump_catalog_version();
        return ok;
    }

    // Update the alt text of an existing image.
    public fn update_alt(self, image_id, alt_text: string) -> bool {
        let row = self.images.find(image_id);
        if row == null {
            throw not_found("Image not found.");
        }
        let ok = DB.table("product_images")
            .where("id", "=", image_id)
            .update(map("alt_text", alt_text)) > 0;
        CatalogCache.bump_catalog_version();
        return ok;
    }

    public fn delete(self, image_id) -> bool {
        let row = self.images.find(image_id);
        if row == null {
            throw not_found("Image not found.");
        }
        let product_id = row["product_id"];
        let was_primary = row["is_primary"] == 1 or row["is_primary"] == true;
        Storage.disk("public").delete(row["path"]);
        let removed = self.images.delete(image_id);
        if removed and was_primary {
            // Never leave the product without a cover when other photos remain.
            let remaining = self.images.for_product(product_id);
            if remaining.len() > 0 {
                self.set_primary(remaining[0]["id"]);
            }
        }
        CatalogCache.bump_catalog_version();
        return removed;
    }
}
