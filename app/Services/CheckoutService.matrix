// app/Services/CheckoutService.matrix
// Phase 7 — checkout quote + atomic order placement.
//
// One transaction covers EVERYTHING: stock deduction, order + immutable
// line snapshots, coupon usage, and cart clearing. A failure at any step
// rolls the whole thing back (no half-orders, no lost stock).

import "framework/Database/DB";
import "framework/HttpException";
import "app/Services/CartService";
import "app/Services/CouponService";
import "app/Services/CampaignService";
import "app/Services/GiftCardService";
import "app/Services/ShippingService";
import "app/Repositories/OrderRepository";
import "app/Repositories/InventoryRepository";
import "app/Repositories/CheckoutRepository";
import "app/Repositories/ProductRepository";
import "app/Support/Money" as Money;
import "app/Support/Fx" as Fx;

public class CheckoutService {
    public let cart;
    public let coupons;
    public let orders;
    public let inventory;
    public let addresses;
    public let products;
    public let gift_cards;
    public let campaigns;
    public let shipping;

    fn new() {
        self.cart = new CartService();
        self.coupons = new CouponService();
        self.orders = new OrderRepository();
        self.inventory = new InventoryRepository();
        self.addresses = new AddressRepository();
        self.products = new ProductRepository();
        self.gift_cards = new GiftCardService();
        self.campaigns = new CampaignService();
        self.shipping = new ShippingService();
    }

    fn setting(self, key: string, fallback: int) -> int {
        let row = DB.table("settings").where("setting_key", "=", key).first();
        if row == null {
            return fallback;
        }
        return int(row["value"]);
    }

    // Delivery fee: the customer's zone rate when their address matches a
    // configured shipping zone, otherwise the flat settings fee (the Phase 7
    // behaviour, unchanged — the fee logic itself lives in ShippingService).
    fn shipping_quote(self, method: string, after_discount: int, address = null) {
        return self.shipping.quote(address, method, after_discount);
    }

    fn format_amount(self, minor: int, currency: string, fx) -> string {
        let cur = string(currency).trim().upper();
        if cur == "" { cur = "BDT"; }
        if fx != null and fx.has("base") and cur != string(fx["base"]).trim().upper() {
            let converted = Fx.convert(minor, string(fx["base"]), cur, fx["rates"]);
            return Fx.format(converted, cur, fx["rates"]);
        }
        return Money.format(minor, cur);
    }

    // options: shipping_method (standard|express), coupon_code,
    //           gift_card_code, address_id, currency, fx
    public fn quote(self, ident, options) {
        let currency = "BDT";
        if options.has("currency") and string(options["currency"]).trim() != "" {
            currency = string(options["currency"]).trim().upper();
        }
        let fx = null;
        if options.has("fx") {
            fx = options["fx"];
        }
        let summary = self.cart.summary(ident, currency, fx);
        let subtotal = int(summary["subtotal_minor"]);
        let volume_discount = int(summary["discount_minor"]);
        let coupon_code = "";
        if options.has("coupon_code") {
            coupon_code = string(options["coupon_code"]).trim().upper();
        }
        let coupon = self.coupons.validate(coupon_code, subtotal);
        let total_discount = volume_discount + int(coupon["discount_minor"]);
        if total_discount > subtotal {
            total_discount = subtotal;
        }
        // A promotional campaign applies after the coupon, before a gift
        // card — so the most valuable incentive is always applied last.
        let campaign = self.campaigns.active();
        let campaign_discount = 0;
        let campaign_id = null;
        let campaign_name = "";
        let campaign_code = "";
        if campaign != null {
            campaign_discount = self.campaigns.discount(subtotal - total_discount);
            if campaign_discount < 0 {
                campaign_discount = 0;
            }
            campaign_id = campaign["id"];
            campaign_name = string(campaign["name"]);
            campaign_code = string(campaign["code"]);
        }
        total_discount = total_discount + campaign_discount;
        if total_discount > subtotal {
            total_discount = subtotal;
        }
        // A gift card covers whatever is still payable after the coupon and
        // the volume discount — never more than the order is worth.
        let gift_card_code = "";
        if options.has("gift_card_code") {
            gift_card_code = string(options["gift_card_code"]).trim();
        }
        let gift_cover = subtotal - total_discount;
        if gift_cover < 0 {
            gift_cover = 0;
        }
        let gift_card_discount = 0;
        if gift_card_code != "" {
            gift_card_discount = self.gift_cards.value(gift_card_code, gift_cover);
        }
        total_discount = total_discount + gift_card_discount;
        let method = "standard";
        if options.has("shipping_method") and string(options["shipping_method"]) != "" {
            method = string(options["shipping_method"]).trim();
        }
        let taxable = subtotal - total_discount;
        let delivery_opts = options;
        if options.has("address_id") and options["address_id"] != null and string(options["address_id"]) != "" and ident["user_id"] != null {
            if self.addresses.belongs_to(options["address_id"], ident["user_id"]) {
                let saved_addr = self.addresses.find(options["address_id"]);
                if saved_addr != null {
                    delivery_opts = {
                        "city": saved_addr["city"],
                        "district": saved_addr["district"],
                        "country": saved_addr["country"]
                    };
                }
            }
        }
        let delivery = self.shipping_quote(method, taxable, delivery_opts);
        let shipping = int(delivery["fee_minor"]);
        let tax_bps = self.setting("store.tax_rate_bps", 0);
        let tax = int(taxable * tax_bps / 10000);
        let total = taxable + tax + shipping;
        let free_threshold = self.setting("shipping.free_threshold_minor", 200000);
        let free_remaining = free_threshold - taxable;
        if free_remaining < 0 {
            free_remaining = 0;
        }
        let coupon_discount_val = int(coupon["discount_minor"]);

        return {
            "items": summary["items"],
            "has_items": summary["has_items"],
            "item_count": summary["count"],
            "has_warnings": summary["has_warnings"],
            "warnings": summary["warnings"],
            "currency": currency,
            "subtotal_minor": subtotal,
            "volume_discount_minor": volume_discount,
            "coupon_discount_minor": coupon_discount_val,
            "campaign_discount_minor": campaign_discount,
            "campaign_id": campaign_id,
            "campaign_name": campaign_name,
            "campaign_code": campaign_code,
            "gift_card_discount_minor": gift_card_discount,
            "gift_card_code": gift_card_code,
            "discount_minor": total_discount,
            "coupon_id": coupon["coupon_id"],
            "coupon_code": coupon["code"],
            "shipping_method": method,
            "is_express": method == "express",
            "is_standard": method != "express",
            "shipping_minor": shipping,
            "is_free_shipping": shipping == 0,
            "free_shipping_threshold_minor": free_threshold,
            "free_shipping_remaining_minor": free_remaining,
            "free_shipping_remaining_display": self.format_amount(free_remaining, currency, fx),
            "has_free_shipping_progress": free_remaining > 0 and method != "express",
            "shipping_zone": delivery["zone_name"],
            "has_shipping_zone": string(delivery["zone_name"]) != "",
            "shipping_days_min": delivery["estimated_days_min"],
            "shipping_days_max": delivery["estimated_days_max"],
            "shipping_source": delivery["source"],
            "tax_minor": tax,
            "total_minor": total,
            "has_volume_discount": volume_discount > 0,
            "has_coupon_discount": coupon_discount_val > 0,
            "has_campaign_discount": campaign_discount > 0,
            "has_gift_card_discount": gift_card_discount > 0,
            "has_any_discount": total_discount > 0,
            "subtotal_display": self.format_amount(subtotal, currency, fx),
            "volume_discount_display": self.format_amount(volume_discount, currency, fx),
            "coupon_discount_display": self.format_amount(coupon_discount_val, currency, fx),
            "campaign_discount_display": self.format_amount(campaign_discount, currency, fx),
            "discount_display": self.format_amount(total_discount, currency, fx),
            "gift_card_display": self.format_amount(gift_card_discount, currency, fx),
            "shipping_display": self.format_amount(shipping, currency, fx),
            "tax_display": self.format_amount(tax, currency, fx),
            "total_display": self.format_amount(total, currency, fx),
            "express_fee_display": self.format_amount(self.setting("shipping.express_minor", 12000), currency, fx),
            "standard_fee_display": self.format_amount(self.setting("shipping.flat_minor", 6000), currency, fx),
            "free_threshold_display": self.format_amount(free_threshold, currency, fx)
        };
    }

    fn resolve_address(self, ident, data) -> string {
        // Saved address (authenticated customers only).
        if data.has("address_id") and data["address_id"] != null and string(data["address_id"]) != "" {
            if ident["user_id"] == null {
                throw validation_failed({"address_id": "Sign in to use a saved address."});
            }
            if not self.addresses.belongs_to(data["address_id"], ident["user_id"]) {
                throw not_found("Address not found.");
            }
            let row = self.addresses.find(data["address_id"]);
            return json_write({
                "full_name": row["full_name"], "phone": row["phone"],
                "line1": row["line1"], "line2": row["line2"],
                "city": row["city"], "district": row["district"],
                "postal_code": row["postal_code"], "country": row["country"]
            });
        }
        // Inline address (guests and customers alike).
        let required = ["full_name", "phone", "line1", "city"];
        let i = 0;
        while i < required.len() {
            if not data.has(required[i]) or string(data[required[i]]).trim() == "" {
                let err = {};
                err[required[i]] = "This address field is required.";
                throw validation_failed(err);
            }
            i += 1;
        }
        let line2 = "";
        if data.has("line2") { line2 = string(data["line2"]); }
        let district = "";
        if data.has("district") { district = string(data["district"]); }
        let postal_code = "";
        if data.has("postal_code") { postal_code = string(data["postal_code"]); }
        let country = "Bangladesh";
        if data.has("country") and string(data["country"]).trim() != "" {
            country = string(data["country"]);
        }
        return json_write({
            "full_name": data["full_name"], "phone": data["phone"],
            "line1": data["line1"], "line2": line2,
            "city": data["city"], "district": district,
            "postal_code": postal_code, "country": country
        });
    }

    // `data`: address fields (or address_id), shipping_method, coupon_code.
    public fn place_order(self, ident, data) {
        return DB.transaction(fn() {
            let quote = self.quote(ident, data);
            if not quote["has_items"] {
                throw validation_failed({"cart": "Your cart is empty."});
            }
            if quote["has_warnings"] {
                throw validation_failed({"cart": "Some items are no longer available."});
            }
            let address_json = self.resolve_address(ident, data);

            // Build immutable line snapshots and deduct stock atomically.
            let items = [];
            let rows = quote["items"];
            let i = 0;
            while i < rows.len() {
                let line = rows[i];
                let pid = line["product_id"];
                let vid = line["variant_id"];
                let product_row = DB.table("products").where("id", "=", pid).first();
                if product_row == null {
                    throw validation_failed({"cart": "A product is no longer available."});
                }
                let qty = int(line["quantity"]);
                if not self.inventory.reserve(pid, null, qty, "sale", "checkout", "pending") {
                    throw validation_failed({"cart": "Not enough stock for " + string(product_row["name"]) + "."});
                }
                let snap_name = string(product_row["name"]);
                let snap_sku = string(product_row["sku"]);
                if vid != null {
                    let vrow = DB.table("product_variants").where("id", "=", vid).first();
                    if vrow != null {
                        snap_name = snap_name + " (" + string(vrow["name"]) + ")";
                        if vrow["sku"] != null and string(vrow["sku"]) != "" {
                            snap_sku = string(vrow["sku"]);
                        }
                    }
                }
                items.push({
                    "product_id": pid,
                    "variant_id": vid,
                    "name_snapshot": snap_name,
                    "sku_snapshot": snap_sku,
                    "unit_price_minor": int(line["unit_price_minor"]),
                    "quantity": qty,
                    "discount_minor": 0,
                    "tax_minor": 0,
                    "line_total_minor": int(line["line_total_minor"])
                });
                i += 1;
            }

            let order_data = {
                "user_id": ident["user_id"],
                "status": "awaiting_payment",
                "coupon_id": quote["coupon_id"],
                "shipping_method": quote["shipping_method"],
                "shipping_minor": quote["shipping_minor"],
                "shipping_address_json": address_json,
                "billing_address_json": address_json,
                "placed_at": string(unix_time()),
                "order_discount_minor": quote["discount_minor"],
                "order_tax_minor": quote["tax_minor"]
            };
            let order = self.orders.create(order_data, items);

            if quote["coupon_id"] != null {
                let coupon_repo = new CouponRepository();
                coupon_repo.record_usage(quote["coupon_id"], order["id"], ident["user_id"], quote["coupon_discount_minor"]);
                coupon_repo.increment_uses(quote["coupon_id"]);
            }

            // One use of the promotional campaign is recorded per order.
            if quote["campaign_id"] != null {
                self.campaigns.consume(quote["campaign_id"]);
            }

            // Gift card redemption happens INSIDE the order transaction: if
            // the balance can no longer cover the quoted discount the whole
            // order is rolled back, so the customer is never charged more
            // than the quote they accepted.
            let gift_code = string(quote["gift_card_code"]).trim();
            if gift_code != "" {
                let applied = self.gift_cards.redeem(gift_code, int(quote["gift_card_discount_minor"]), order["id"]);
                if applied != int(quote["gift_card_discount_minor"]) {
                    throw validation_failed({"gift_card": "The gift card balance changed. Please review your cart and try again."});
                }
            }

            // Empty the cart so a repeated submit cannot double-charge.
            let cart_row = self.cart.cart(ident);
            DB.table("cart_items").where("cart_id", "=", cart_row["id"]).delete();
            return order;
        });
    }
}
