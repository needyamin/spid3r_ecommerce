// database/seeders/DatabaseSeeder.matrix
// Phase 2 — baseline store data. Idempotent: every row is checked before
// insert, so `magic db:seed` is safe to run repeatedly.

import "framework/Database/DB";

fn ensure(table_name: string, column: string, value, data) {
    let hits = DB.table(table_name).where(column, "=", value).count();
    if hits > 0 {
        return false;
    }
    DB.table(table_name).insert(data);
    return true;
}

fn seed_roles() {
    ensure("roles", "slug", "customer", {"name": "Customer", "slug": "customer", "description": "Storefront customer"});
    ensure("roles", "slug", "staff", {"name": "Staff", "slug": "staff", "description": "Operations staff"});
    ensure("roles", "slug", "admin", {"name": "Administrator", "slug": "admin", "description": "Full store access"});
}

fn seed_permissions() {
    ensure("permissions", "slug", "catalog.manage", {"name": "Manage catalog", "slug": "catalog.manage"});
    ensure("permissions", "slug", "orders.manage", {"name": "Manage orders", "slug": "orders.manage"});
    ensure("permissions", "slug", "customers.manage", {"name": "Manage customers", "slug": "customers.manage"});
    ensure("permissions", "slug", "settings.manage", {"name": "Manage settings", "slug": "settings.manage"});
    ensure("permissions", "slug", "reports.view", {"name": "View reports", "slug": "reports.view"});
    ensure("permissions", "slug", "payments.manage", {"name": "Manage payments", "slug": "payments.manage"});
}

fn seed_role_permissions() {
    let admin = DB.table("roles").where("slug", "=", "admin").first();
    if admin == null {
        return false;
    }
    let perms = DB.table("permissions").get();
    let i = 0;
    while i < perms.len() {
        let perm = perms[i];
        let exists = DB.table("role_permissions")
            .where("role_id", "=", admin["id"])
            .where("permission_id", "=", perm["id"])
            .count();
        if exists == 0 {
            DB.table("role_permissions").insert({"role_id": admin["id"], "permission_id": perm["id"]});
        }
        i += 1;
    }
    return true;
}

