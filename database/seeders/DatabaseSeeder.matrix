fn ensure_setting_value(table_name: string, column: string, value, data) {
    let hits = DB.table(table_name).where(column, "=", value).count();
    if hits > 0 {
        return false;
    }
    DB.table(table_name).insert(data);
    return true;
}

// Phase 10 — currency catalog. The base currency (settings store.currency)
// is always 1:1 with itself; alternates are DISPLAY currencies derived
// from rate_to_base_bps (basis points of base currency per major unit).
fn seed_currencies() {
    ensure_setting_value("currencies", "code", "BDT", {
        "code": "BDT", "name": "Bangladeshi Taka", "symbol": "৳",
        "minor_digits": 2, "rate_to_base_bps": 10000,
        "is_active": 1, "is_default": 1
    });
    ensure_setting_value("currencies", "code", "USD", {
        "code": "USD", "name": "US Dollar", "symbol": "$",
        "minor_digits": 2, "rate_to_base_bps": 12100,
        "is_active": 1, "is_default": 0
    });
    ensure_setting_value("currencies", "code", "EUR", {
        "code": "EUR", "name": "Euro", "symbol": "€",
        "minor_digits": 2, "rate_to_base_bps": 13900,
        "is_active": 1, "is_default": 0
    });
}

// Phase 10 — translations. `ensure_translation` is idempotent on the
// (locale, namespace, key) triple.
fn ensure_translation(locale: string, namespace: string, key: string, value: string) {
    let hits = DB.table("translations")
        .where("locale", "=", locale)
        .where("namespace", "=", namespace)
        .where("translation_key", "=", key)
        .count();
    if hits > 0 {
        return false;
    }
    DB.table("translations").insert({
        "locale": locale, "namespace": namespace,
        "translation_key": key, "value": value
    });
    return true;
}

